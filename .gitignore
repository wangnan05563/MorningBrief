# ═══════════════════════════════════════════
# Node.js 依赖与构建产物
# ═══════════════════════════════════════════
node_modules/
dist/
build/
.npm/
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ═══════════════════════════════════════════
# Python 缓存与字节码
# ═══════════════════════════════════════════
__pycache__/
*.py[cod]
*.class
*.so
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ═══════════════════════════════════════════
# 虚拟环境
# ═══════════════════════════════════════════
.venv/
.venv-build/
venv/
env/
ENV/

# ═══════════════════════════════════════════
# 环境变量与密钥（仅保留 .env.example 模板）
# ═══════════════════════════════════════════
.env
.env.local
.env.*.local
*.key
*.pem

# ═══════════════════════════════════════════
# 日志与运行时数据
# ═══════════════════════════════════════════
*.log
logs/
*.pid
*.seed
debug.log

# ═══════════════════════════════════════════
# 数据库临时文件
# ═══════════════════════════════════════════
*.db-shm
*.db-wal
*.db.malformed.bak
*.db
*.sqlite
*.rdb

# ═══════════════════════════════════════════
# IDE 与编辑器
# ═══════════════════════════════════════════
.vscode/
.idea/
*.swp
*.swo
*.swn
*.pydevproject
*.project
.settings/

# ═══════════════════════════════════════════
# 操作系统
# ═══════════════════════════════════════════
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ═══════════════════════════════════════════
# Python 构建产物
# ═══════════════════════════════════════════
*.egg-info/
*.egg
MANIFEST

# ═══════════════════════════════════════════
# PyInstaller / Inno Setup 构建产物
# ═══════════════════════════════════════════
*.spec.bak
installer.iss

# ═══════════════════════════════════════════
# 测试报告与结果
# ═══════════════════════════════════════════
admin-web/playwright-report/
admin-web/test-results/
*.test.log
coverage/
.nyc_output/

# ═══════════════════════════════════════════
# SonarQube 扫描缓存
# ═══════════════════════════════════════════
.scannerwork/
.sonar/
sonar-project.properties.bak

# ═══════════════════════════════════════════
# Serverless Framework (SCF)
# ═══════════════════════════════════════════
scf/__pycache__/
serverless.yml.bak
serverless.config.json

# ═══════════════════════════════════════════
# 备份与临时文件
# ═══════════════════════════════════════════
*.bak
*.tmp
*.temp
backup/
*.backup

# ═══════════════════════════════════════════
# 文档与截图（按需保留）
# ═══════════════════════════════════════════
docs/screenshots/
docs/lighthouse/
docs/test-reports/
docs/snapshots/
docs/*.png
docs/*.jpg
docs/*.jpeg
docs/report.html
docs/report.json
docs/trace.json

# ═══════════════════════════════════════════
# FFmpeg 相关
# ═══════════════════════════════════════════
backend/ffmpeg/

# ═══════════════════════════════════════════
# 特定项目忽略
# ═══════════════════════════════════════════
backend/data/audio_cache/*
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.malformed.bak

# ═══════════════════════════════════════════
# 清理技能自动生成规则（防止调试产物复发）
# ═══════════════════════════════════════════
# Vite 临时配置缓存
admin-web/vite.config.js.timestamp-*.mjs

# 构建输出散落根目录
/build_output.txt
/build_output.log

# 测试产物散落根目录（图片/音频/脚本）
/test_tts.mp3
/clear_test.py
/generated_image.png
/morning_brief_cycling.png

# 异常命名文件（PowerShell 误重定向产物）
/-w

# SonarQube 调试输出（补充 *.log 未覆盖的 .txt 变体）
/sonar-*.log
/sonar-*.txt
/pytest-output.log
