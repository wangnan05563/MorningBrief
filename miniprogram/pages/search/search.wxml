<!-- 搜索页 -->
<view class="page-search">
  <!-- 搜索框 -->
  <view class="search-bar">
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索节目标题"
      placeholder-class="search-ph"
      confirm-type="search"
      bindinput="onInput"
    />
    <image class="search-icon" lazy-load src="/images/icons/search.png" mode="aspectFit" />
  </view>

  <!-- 搜索历史（无关键词时展示） -->
  <block wx:if="{{showHistory && history.length > 0}}">
    <view class="history-section">
      <view class="section-header">
        <text>搜索历史</text>
        <text class="clear-btn" bindtap="onClearHistory">清空</text>
      </view>
      <view class="history-tags">
        <view
          wx:for="{{history}}"
          wx:key="*this"
          class="history-tag"
          data-keyword="{{item}}"
          bindtap="onTapHistory"
        >{{item}}</view>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!loading && keyword && results.length === 0}}">
    <image class="empty-icon-img" lazy-load src="/images/icons/search.png" mode="aspectFit" />
    <text>未找到相关节目</text>
  </view>

  <!-- 搜索结果 -->
  <block wx:else>
    <view class="result-list">
      <view
        class="card result-item"
        wx:for="{{results}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-index="{{index}}"
        bindtap="onTapResult"
      >
        <view class="item-header">
          <text class="item-date">{{item.date}}</text>
        </view>
        <text class="item-title">{{item.title}}</text>
        <view class="item-footer">
          <view class="item-duration">
            <image class="duration-icon" lazy-load src="/images/icons/duration.png" mode="aspectFit" />
            <text>{{fmt.time(item.duration)}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{results.length > 0}}">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:elif="{{!hasMore}}">没有更多了</text>
    </view>
  </block>
</view>

<wxs module="fmt">
  module.exports = {
    time: function(s) {
      s = s || 0;
      var m = Math.floor(s / 60);
      var sec = Math.floor(s % 60);
      return (m < 10 ? '0' + m : m) + ':' + (sec < 10 ? '0' + sec : sec);
    }
  };
</wxs>
