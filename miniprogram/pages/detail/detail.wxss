.page-detail {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 节目信息卡片 */
.episode-card {
  padding: 40rpx 32rpx;
}

.episode-meta {
  display: flex;
  align-items: center;
}

.episode-date {
  font-size: 24rpx;
  color: #A0AEC0;
  margin-right: 16rpx;
}

.episode-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2D3748;
  line-height: 1.4;
  margin: 20rpx 0 16rpx;
}

.episode-duration {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #7ECEC1;
}

.duration-icon {
  margin-right: 8rpx;
}

/* 播放控制卡片 */
.play-card {
  padding: 36rpx 32rpx;
}

.play-row {
  display: flex;
  align-items: center;
}

/* 圆形播放按钮：薄荷青 */
.play-btn {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7ECEC1, #5BA89B);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(126, 206, 193, 0.45);
}

.play-icon {
  color: #FFFFFF;
  font-size: 44rpx;
  line-height: 1;
}

.play-info {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.progress {
  margin: 0;
}

.time-row {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.time {
  font-size: 24rpx;
  color: #A0AEC0;
}

/* 稿件区域 */
.script-card {
  padding: 32rpx;
}

.script-header {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 24rpx;
}

.script-entry {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

/* 蜜桃粉“查看文稿”按钮 */
.script-btn {
  display: inline-block;
  padding: 20rpx 56rpx;
}

.script-body {
  font-size: 28rpx;
  color: #4A5568;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 底部操作 */
.footer-actions {
  display: flex;
  padding: 0 24rpx;
  margin-top: 16rpx;
}

.footer-btn {
  flex: 1;
  margin: 0;
  margin-left: 24rpx;
  line-height: 1.5;
}

.footer-btn:first-child {
  margin-left: 0;
}

/* 重置小程序 button 默认描边，贴合全局按钮风格 */
.footer-btn::after {
  border: none;
}
