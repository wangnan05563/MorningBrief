<!-- 节目详情：信息卡片 + 播放控制 + 稿件懒加载 -->
<view class="page-detail">
  <!-- 任务10：背景虚化层，取自 segments 第一张封面图，淡色滤镜柔化避免抢戏 -->
  <view class="bg-blur-layer" wx:if="{{bgCoverUrl}}">
    <image class="bg-blur-img" src="{{bgCoverUrl}}" mode="aspectFill" />
    <view class="bg-blur-mask"></view>
  </view>

  <!-- 详情加载中 -->
  <view class="loading-mask" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 详情加载失败 -->
  <view class="empty-state" wx:elif="{{error}}">
    <image class="empty-icon-img" src="/images/icons/alert.png" mode="aspectFit" />
    <text>{{error}}</text>
  </view>

  <block wx:else>
    <!-- 节目信息卡片 -->
    <view class="card episode-card">
      <view class="episode-meta">
        <text class="episode-date">{{episode.date}}</text>
        <text class="tag tag-pink" wx:if="{{episode.categories}}">{{episode.categories[0]}}</text>
      </view>
      <view class="episode-title">{{episode.title}}</view>
      <view class="episode-duration">
        <image class="duration-icon" src="/images/icons/duration.png" mode="aspectFit" />
        <text>时长 {{durationLabel}}</text>
      </view>
    </view>

    <!-- 播放控制卡片 -->
    <view class="card play-card">
      <!-- 播放错误提示：音频丢失/不可访问时持久显示，避免 toast 消失后用户不知道原因 -->
      <view class="play-error-tip" wx:if="{{playError}}">
        <image class="error-icon" src="/images/icons/alert.png" mode="aspectFit" />
        <text>{{playError}}</text>
      </view>
      <view class="play-row">
        <!-- 上一首按钮（队列未设置时隐藏） -->
        <view class="nav-btn" wx:if="{{hasPrev}}" bindtap="onPrev">
          <image class="nav-icon" src="/images/icons/skip-back.png" mode="aspectFit" />
        </view>
        <view class="play-btn" bindtap="onTogglePlay">
          <image class="play-icon" src="{{isPlaying ? '/images/icons/pause.png' : '/images/icons/play.png'}}" mode="aspectFit" />
        </view>
        <!-- 下一首按钮 -->
        <view class="nav-btn" wx:if="{{hasNext}}" bindtap="onNext">
          <image class="nav-icon" src="/images/icons/skip-forward.png" mode="aspectFit" />
        </view>
        <view class="play-info">
          <slider
            class="progress"
            min="0"
            max="{{duration || 0}}"
            value="{{currentTime}}"
            activeColor="#7ECEC1"
            backgroundColor="#E6F4F1"
            block-size="22"
            block-color="#7ECEC1"
            bindchange="onSeek"
          />
          <view class="time-row">
            <text class="time">{{currentTimeText}}</text>
            <text class="time">{{durationText}}</text>
          </view>
        </view>
      </view>

      <!-- 操作按钮区：倍速 + 收藏 + 列表 + 睡眠定时器 -->
      <view class="action-row">
        <view class="action-chip" bindtap="onCycleRate">
          <text>{{currentRate}}x</text>
        </view>
        <view class="action-chip {{favorited ? 'active' : ''}}" bindtap="onToggleFavorite">
          <image class="chip-icon" src="{{favorited ? '/images/icons/favorite-filled.png' : '/images/icons/favorite.png'}}" mode="aspectFit" />
          <text class="chip-label">{{favorited ? '已收藏' : '收藏'}}</text>
        </view>
        <view class="action-chip" bindtap="onOpenQueue">
          <text class="chip-icon-text">☰</text>
          <text class="chip-label">列表</text>
        </view>
        <view class="action-chip {{sleepActive ? 'active' : ''}}" bindtap="onSleepTimer">
          <image class="chip-icon" src="{{sleepActive ? '/images/icons/alarm.png' : '/images/icons/moon.png'}}" mode="aspectFit" />
          <text class="chip-label" wx:if="{{sleepActive}}">{{sleepLabel}}</text>
          <text class="chip-label" wx:else>定时</text>
        </view>
      </view>
    </view>

    <!-- 稿件区域：懒加载 -->
    <view class="card script-card">
      <view class="script-header">完整文稿</view>

      <!-- 未加载：展示入口按钮 -->
      <view class="script-entry" wx:if="{{!scriptLoaded}}">
        <view class="btn-secondary script-btn" bindtap="onLoadScript">
          {{scriptLoading ? '加载中...' : '查看完整文稿'}}
        </view>
      </view>

      <!-- 加载完成：优先按段渲染（含封面图），无 segments 时降级为纯文本 -->
      <block wx:elif="{{segments.length > 0}}">
        <view class="seg-block" wx:for="{{segments}}" wx:key="seq">
          <!-- 封面图：原站防盗链/删图时 onCoverError 自然降级隐藏 -->
          <image
            wx:if="{{item.cover_url}}"
            class="seg-cover"
            src="{{item.cover_url}}"
            mode="widthFix"
            lazy-load
            data-seq="{{item.seq}}"
            binderror="onCoverError"
          />
          <view class="seg-title" wx:if="{{item.title}}">{{item.title}}</view>
          <view class="seg-content">{{item.content}}</view>
        </view>
      </block>

      <view class="script-body" wx:else>{{script}}</view>
    </view>

    <!-- 节目来源（版权溯源，仅稿件加载后展示） -->
    <view class="card sources-card" wx:if="{{scriptLoaded && sources.length > 0}}">
      <view class="script-header">节目来源</view>
      <view class="sources-list">
        <view class="source-item" wx:for="{{sources}}" wx:key="seq">
          <text class="source-seq">{{item.seq}}</text>
          <view class="source-info">
            <!-- 标题可点击跳转原站：有 url 时显示链接样式 + 图标提示 -->
            <view
              class="source-title-row"
              wx:if="{{item.url}}"
              bindtap="onTapSource"
              data-url="{{item.url}}"
            >
              <text class="source-title source-link">{{item.title || '查看原文'}}</text>
              <text class="source-link-icon">↗</text>
            </view>
            <text class="source-title" wx:else>{{item.title}}</text>
            <text class="source-meta">{{item.source}} · {{item.category}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 任务8：评论区 -->
    <view class="card comment-card">
      <view class="comment-header">
        <text class="comment-title">听众评论</text>
        <text class="comment-count">{{commentsTotal}} 条</text>
      </view>

      <!-- 评论输入框 -->
      <view class="comment-input-row">
        <textarea
          class="comment-input"
          placeholder="说说你对这期节目的看法..."
          value="{{commentText}}"
          bindinput="onInputComment"
          maxlength="200"
          auto-height
        />
        <view
          class="comment-submit {{postingComment ? 'disabled' : ''}}"
          bindtap="onPostComment"
        >{{postingComment ? '发送中' : '发送'}}</view>
      </view>

      <!-- 评论列表 -->
      <view class="comment-list" wx:if="{{comments.length > 0}}">
        <view class="comment-item" wx:for="{{comments}}" wx:key="id">
          <!-- 头像 -->
          <image
            class="comment-avatar"
            src="{{item.user_avatar || '/images/icons/favorite.png'}}"
            mode="aspectFill"
            data-url="{{item.user_avatar}}"
            bindtap="onPreviewAvatar"
          />
          <!-- 中间：名称 + 日期（不再被头像挤压） -->
          <view class="comment-meta-col">
            <text class="comment-user">{{item.user_name || '匿名听众'}}</text>
            <text class="comment-date" wx:if="{{item.created_at}}">{{item.created_at}}</text>
          </view>
          <!-- 右侧：评论内容 + 点赞 -->
          <view class="comment-body">
            <text class="comment-content">{{item.content}}</text>
            <view class="comment-like" data-id="{{item.id}}" data-index="{{index}}" bindtap="onLikeComment">
              <image
                class="like-icon"
                src="{{item.liked ? '/images/icons/favorite-filled.png' : '/images/icons/favorite.png'}}"
                mode="aspectFit"
              />
              <text class="like-count {{item.liked ? 'liked' : ''}}">{{item.like_count || 0}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 空评论 -->
      <view class="comment-empty" wx:elif="{{!commentLoading}}">
        <text>还没有评论，快来抢沙发吧～</text>
      </view>
      <view class="comment-loading" wx:if="{{commentLoading}}">
        <text>评论加载中...</text>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="footer-actions">
      <button class="btn-primary footer-btn" open-type="share">分享节目</button>
      <view class="btn-secondary footer-btn" bindtap="onBackHome">返回首页</view>
    </view>
  </block>
</view>
