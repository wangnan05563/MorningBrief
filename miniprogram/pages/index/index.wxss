/* 首页样式：马卡龙配色，大圆角，柔和阴影 */

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* === 顶部工具栏：搜索 + 频道胶囊 + 睡眠定时器 === */
.top-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #F0F4F2;
  position: sticky;
  top: 0;
  z-index: 10;
}

/* === 任务3：续播卡片 === */
.continue-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF1F5 0%, #F0F9F6 100%);
  border: 2rpx solid #FFD3E0;
  margin: 24rpx;
  padding: 24rpx 28rpx;
}

.continue-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #5BA89B;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.continue-icon {
  width: 32rpx;
  height: 32rpx;
}

.continue-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.continue-label {
  font-size: 22rpx;
  color: #FF6B8A;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.continue-title {
  font-size: 30rpx;
  color: #2D3748;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.continue-meta {
  font-size: 22rpx;
  color: #A0AEC0;
  margin-top: 4rpx;
}

.continue-arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: 12rpx;
}

/* === 任务3：节目列表行 === */
.episode-row-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 16rpx 24rpx;
}

.row-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFE4ED 0%, #E0F4F1 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  padding: 8rpx;
}

.row-cover-channel {
  font-size: 22rpx;
  color: #5BA89B;
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
}

.row-cover-date {
  font-size: 20rpx;
  color: #A0AEC0;
  margin-top: 6rpx;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin-right: 16rpx;
}

.row-title {
  font-size: 28rpx;
  color: #2D3748;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 10rpx;
}

.row-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-stat {
  display: flex;
  align-items: center;
}

.row-stat-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
  opacity: 0.6;
}

.row-stat text {
  font-size: 22rpx;
  color: #A0AEC0;
}

.row-play {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #5BA89B;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.row-play:active {
  background: #4A8A7E;
  transform: scale(0.95);
}

.row-play-icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: 4rpx;
  filter: brightness(0) invert(1);
}

/* === 任务5：带封面背景的播放卡片 === */
.player-card.with-cover {
  background-blend-mode: lighten;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  min-height: 540rpx;
  position: relative;
}

.player-card.with-cover::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  pointer-events: none;
}

.player-card.with-cover > view {
  position: relative;
  z-index: 1;
}

/* === 任务4：文稿区 === */
.script-card {
  margin-top: 8rpx;
}

.script-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 20rpx;
}

.script-action {
  font-size: 24rpx;
  color: #5BA89B;
  font-weight: 400;
}

.script-content {
  display: block;
  font-size: 28rpx;
  color: #4A5568;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.script-segment {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #F9FDFB;
  border-radius: 16rpx;
  border-left: 6rpx solid #7ECEC1;
}

.seg-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 12rpx;
}

/* 分段封面图：圆角不抢戏 */
.seg-cover {
  width: 100%;
  height: 240rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: #F0F4F2;
}

.seg-content {
  display: block;
  font-size: 26rpx;
  color: #4A5568;
  line-height: 1.7;
}

.top-action {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F0F4F2;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.top-action:active {
  background: #E6F4F1;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}

.channel-bar {
  flex: 1;
  white-space: nowrap;
  margin: 0 16rpx;
  height: 64rpx;
}

.channel-pill {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #A0AEC0;
  background: #F0F4F2;
  transition: all 0.2s ease;
  line-height: 40rpx;
}

.channel-pill.active {
  background: linear-gradient(135deg, #7ECEC1, #5BA89B);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(126, 206, 193, 0.3);
}

/* === 睡眠定时器状态条 === */
.sleep-status {
  text-align: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #FFF0F4, #E8F5F2);
  color: #FF6B8A;
  font-size: 24rpx;
}

/* === 问候语卡片：薄荷青到蜜桃粉极浅渐变 === */
.greeting-card {
  margin: 24rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #E8F5F2 0%, #FFF0F4 100%);
  box-shadow: 0 4rpx 16rpx rgba(126, 206, 193, 0.12);
}

.greeting-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #5BA89B;
  margin-bottom: 12rpx;
}

.greeting-subtitle {
  display: block;
  font-size: 26rpx;
  color: #A0AEC0;
}

/* === 节目信息卡片 === */
.episode-card {
  display: flex;
  flex-direction: column;
}

.episode-meta {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.episode-date {
  font-size: 26rpx;
  color: #7ECEC1;
  font-weight: 500;
  margin-right: 16rpx;
}

.episode-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2D3748;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.episode-duration {
  font-size: 24rpx;
  color: #A0AEC0;
}

/* === 播放控制卡片 === */
.player-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 播放错误提示条：蜜桃粉淡背景 + 警示色文字，与 detail 页风格一致 */
.play-error-tip {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: #FFF0F4;
  font-size: 24rpx;
  color: #FF6B8A;
  line-height: 1.5;
}

.play-error-tip .error-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

/* 大圆形播放按钮：120rpx，薄荷青渐变 + 柔和阴影 */
.play-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7ECEC1, #5BA89B);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(126, 206, 193, 0.4);
  margin-bottom: 40rpx;
  transition: transform 0.15s ease;
}

.play-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* 播放/暂停图标：白色实心，居中对齐（image 标签自动居中无需左偏移） */
.play-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 进度条 */
.progress-slider {
  width: 100%;
  margin: 0 0 16rpx 0;
}

/* 时间显示 */
.time-display {
  width: 100%;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #A0AEC0;
}

/* === 查看文稿按钮区 === */
.action-area {
  padding: 0 24rpx;
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 操作芯片：图标 + 文字横向排列，激活态使用品牌色背景 */
.action-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  background: #F0F4F2;
  color: #5BA89B;
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.action-chip.active {
  background: linear-gradient(135deg, #FFD3E0, #FF9AA2);
  color: #FFFFFF;
}

.chip-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 文字图标：当无 PNG 图标时用 Unicode 字符替代，与 .chip-icon 同尺寸 */
.chip-icon-text {
  font-size: 32rpx;
  line-height: 1;
  color: inherit;
}

.action-area .btn-secondary {
  width: 100%;
}
