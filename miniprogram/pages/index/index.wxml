<!-- 首页：今日要闻播放页 -->
<view class="container">
  <!-- 顶部工具栏：搜索 + 频道切换 + 睡眠定时器 -->
  <view class="top-bar" wx:if="{{!loading}}">
    <view class="top-action" bindtap="onSearch">
      <image class="action-icon" src="/images/icons/search.png" mode="aspectFit" />
    </view>
    <scroll-view scroll-x class="channel-bar" wx:if="{{channels.length > 0}}">
      <view
        wx:for="{{channels}}"
        wx:key="id"
        class="channel-pill {{currentChannelId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSwitchChannel"
      >{{item.name}}</view>
    </scroll-view>
    <view class="top-action" bindtap="onSleepTimer">
      <image class="action-icon" src="{{sleepActive ? '/images/icons/alarm.png' : '/images/icons/moon.png'}}" mode="aspectFit" />
    </view>
  </view>

  <!-- 睡眠定时器状态条 -->
  <view class="sleep-status" wx:if="{{sleepActive}}">
    <text>{{sleepLabel}}</text>
  </view>

  <!-- 加载中状态 -->
  <view class="loading-mask" wx:if="{{loading}}">
    <text>正在加载今日要闻...</text>
  </view>

  <!-- === 今日节目列表（统一布局，点击跳转 detail 页） === -->
  <block wx:elif="{{!loading}}">
    <view class="greeting-card" wx:if="{{todayList.length > 0}}">
      <text class="greeting-title">今日共 {{todayList.length}} 个频道已更新</text>
      <text class="greeting-subtitle">{{todayDateText}} · 挑选你感兴趣的频道收听</text>
    </view>

    <!-- 继续播放：展示上次播放过的频道与进度（任务3续播） -->
    <view class="card continue-card" wx:if="{{lastPlayedEpisode}}" bindtap="onTapContinue">
      <view class="continue-icon-wrap">
        <image class="continue-icon" src="{{(isPlaying && currentEpisodeId === lastPlayedEpisode.id) ? '/images/icons/pause.png' : '/images/icons/play-mini.png'}}" mode="aspectFit" />
      </view>
      <view class="continue-info">
        <text class="continue-label">继续播放</text>
        <text class="continue-title">{{lastPlayedEpisode.title || '上次的节目'}}</text>
        <text class="continue-meta" wx:if="{{lastPlayedEpisode.channel_name}}">{{lastPlayedEpisode.channel_name}} · 已播 {{fmt.time(lastPlayedEpisode.currentTime)}}</text>
        <text class="continue-meta" wx:else>已播 {{fmt.time(lastPlayedEpisode.currentTime)}}</text>
      </view>
      <image class="continue-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" />
    </view>

    <!-- 节目列表：每频道一行 + 播放量/时长小图标 -->
    <view
      class="card episode-row-card"
      wx:for="{{todayList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapEpisode"
    >
      <view class="row-cover">
        <text class="row-cover-channel">{{item.channel_name || '节目'}}</text>
        <text class="row-cover-date">{{item.date_label || ''}}</text>
      </view>
      <view class="row-main">
        <text class="row-title">{{item.title || (item.date_label + ' · ' + (item.channel_name || '节目'))}}</text>
        <view class="row-stats">
          <view class="row-stat">
            <image class="row-stat-icon" src="/images/icons/play-mini.png" mode="aspectFit" />
            <text>{{item.play_count || 0}} 播放</text>
          </view>
          <view class="row-stat">
            <image class="row-stat-icon" src="/images/icons/duration.png" mode="aspectFit" />
            <text>{{item.duration_label || '00:00'}}</text>
          </view>
        </view>
      </view>
      <view class="row-play" data-id="{{item.id}}" catchtap="onPlayEpisode">
        <image class="row-play-icon" src="{{(isPlaying && currentEpisodeId === item.id) ? '/images/icons/pause.png' : '/images/icons/play.png'}}" mode="aspectFit" />
      </view>
    </view>

    <empty-state
      wx:if="{{todayList.length === 0}}"
      icon="/images/icons/headphones.png"
      icon-type="image"
      title="{{error || '今日节目暂未上线'}}"
      description="节目通常每天上午更新，下拉刷新试试或稍后再来看看～"
    ></empty-state>
  </block>
</view>

<!-- WXS：时间格式化工具（mm:ss），供模板调用 -->
<wxs module="fmt">
  module.exports = {
    time: function(s) {
      s = s || 0;
      var m = Math.floor(s / 60);
      var sec = Math.floor(s % 60);
      return (m < 10 ? '0' + m : m) + ':' + (sec < 10 ? '0' + sec : sec);
    }
  };
</wxs>

<!-- 任务9：全局浮动播放按钮，当有正在播放的节目时显示 -->
<floating-player />
