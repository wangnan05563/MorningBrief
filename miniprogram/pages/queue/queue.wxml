<!-- 播放队列 -->
<view class="page-queue">
  <!-- 顶部操作 -->
  <view class="queue-header" wx:if="{{queue.length > 0}}">
    <text class="queue-count">共 {{queue.length}} 首</text>
    <text class="clear-btn" bindtap="onClear">清空</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{queue.length === 0}}">
    <text class="empty-icon">🎵</text>
    <text>播放队列为空</text>
    <text class="empty-desc">在历史列表中点击节目即可加入队列</text>
  </view>

  <!-- 队列列表 -->
  <block wx:else>
    <view class="queue-list">
      <view
        class="card queue-item {{index === currentIndex ? 'current' : ''}}"
        wx:for="{{queue}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="onTapItem"
      >
        <view class="item-index">
          <text wx:if="{{index === currentIndex}}" class="playing-icon">▶</text>
          <text wx:else>{{index + 1}}</text>
        </view>
        <view class="item-info">
          <text class="item-title">{{item.title}}</text>
          <text class="item-date">{{item.date}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
