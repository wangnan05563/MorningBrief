/* 历史列表样式：与今日页完全一致（行式卡片 + 顶部工具栏 + 续播卡 + 工具栏） */

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* === 顶部工具栏：搜索 + 频道胶囊（与今日页同款） === */
.top-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #F0F4F2;
  position: sticky;
  top: 0;
  z-index: 10;
}

.top-action {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F0F4F2;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.top-action:active {
  background: #E6F4F1;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}

.channel-bar {
  flex: 1;
  white-space: nowrap;
  margin: 0 16rpx;
  height: 64rpx;
}

.channel-pill {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #A0AEC0;
  background: #F0F4F2;
  transition: all 0.2s ease;
  line-height: 40rpx;
}

.channel-pill.active {
  background: linear-gradient(135deg, #7ECEC1, #5BA89B);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(126, 206, 193, 0.3);
}

/* === 节目行卡片：与今日页完全一致 === */
.history-list {
  /* 仅作容器，无 padding 让 .episode-row-card 自带 margin */
}

.episode-row-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 16rpx 24rpx;
}

.row-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFE4ED 0%, #E0F4F1 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  padding: 8rpx;
}

.row-cover-channel {
  font-size: 22rpx;
  color: #5BA89B;
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
}

.row-cover-date {
  font-size: 20rpx;
  color: #A0AEC0;
  margin-top: 6rpx;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin-right: 16rpx;
}

.row-title {
  font-size: 28rpx;
  color: #2D3748;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 10rpx;
}

.row-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-stat {
  display: flex;
  align-items: center;
}

.row-stat-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
  opacity: 0.6;
}

.row-stat text {
  font-size: 22rpx;
  color: #A0AEC0;
}

.row-play {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #5BA89B;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.row-play:active {
  background: #4A8A7E;
  transform: scale(0.95);
}

.row-play-icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: 4rpx;
  filter: brightness(0) invert(1);
}

/* === 空状态：与今日页同款 === */
.empty-icon-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

/* === 底部加载更多提示 === */
.load-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: #A0AEC0;
}

/* === 任务6+7：继续播放 + 工具栏（与今日页 continue-card 同风格） === */
.history-action-bar {
  padding: 16rpx 24rpx 0;
}

.continue-card-mini {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 220, 230, 0.5), rgba(180, 220, 230, 0.5));
  box-shadow: 0 4rpx 16rpx rgba(126, 206, 193, 0.1);
  transition: transform 0.15s ease;
}

.continue-card-mini:active {
  transform: scale(0.98);
}

.continue-card-mini .continue-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7ECEC1, #5BA89B);
  padding: 12rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.continue-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.continue-label {
  font-size: 22rpx;
  color: #5BA89B;
  font-weight: 500;
}

.continue-title {
  font-size: 28rpx;
  color: #2D3748;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.continue-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

/* 工具栏：排序 + 列表按钮 */
.history-tools {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.tool-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #5BA89B;
  font-size: 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(126, 206, 193, 0.08);
  transition: all 0.2s ease;
}

.tool-chip:active {
  background: #E6F4F1;
  transform: scale(0.96);
}

.tool-icon {
  width: 28rpx;
  height: 28rpx;
}

.tool-icon-text {
  font-size: 28rpx;
  line-height: 1;
  color: inherit;
}
