<!-- 收藏列表页：与历史页风格一致，长按取消收藏 -->
<view class="container">
  <!-- 加载中 -->
  <view class="loading-mask" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{list.length === 0}}"
    icon="♡"
    title="还没有收藏的节目"
  ></empty-state>

  <!-- 收藏列表 -->
  <block wx:else>
    <view class="fav-list">
      <view
        class="card fav-item {{item._unavailable ? 'item-unavailable' : ''}}"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-title="{{item.title}}"
        bindtap="onTapItem"
        bindlongpress="onLongPressItem"
      >
        <!-- 顶部：收藏时间 + 分类标签（薄荷青/蜜桃粉交替） -->
        <view class="item-header">
          <text class="item-date">收藏于 {{fmt.date(item.favorited_at)}}</text>
          <text
            wx:if="{{item.categories && item.categories.length}}"
            class="tag {{index % 2 === 0 ? 'tag-mint' : 'tag-pink'}}"
          >{{item.categories[0]}}</text>
        </view>

        <!-- 标题 -->
        <text class="item-title">{{item.title}}</text>

        <!-- 底部：时长 + 播放图标 -->
        <view class="item-footer">
          <text class="item-duration">⏱ {{fmt.time(item.duration)}}</text>
          <view class="play-icon-small">
            <text class="icon-text">▶</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部提示：长按取消收藏 -->
    <view class="list-tip">
      <text>长按节目可取消收藏</text>
    </view>
  </block>
</view>

<!-- WXS：时间格式化（避免在 JS 中维护额外字段） -->
<wxs module="fmt">
  module.exports = {
    // 秒 → "mm:ss"，与 history 页保持一致
    time: function(s) {
      s = s || 0;
      var m = Math.floor(s / 60);
      var sec = Math.floor(s % 60);
      return (m < 10 ? '0' + m : m) + ':' + (sec < 10 ? '0' + sec : sec);
    },
    // ISO 时间 → "YYYY-MM-DD"，仅保留日期部分便于排版
    date: function(iso) {
      if (!iso) return '';
      return iso.length >= 10 ? iso.substring(0, 10) : iso;
    }
  };
</wxs>
