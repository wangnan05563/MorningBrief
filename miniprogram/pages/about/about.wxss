.page-about {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 应用信息头部：与 profile 页 user-card 保持一致的渐变风格 */
.about-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx 60rpx;
  background: linear-gradient(135deg, #7ECEC1 0%, #FFD3E0 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.app-logo {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.app-version {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.app-desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 功能介绍 */
.feature-card {
  padding: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 24rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F0F4F2;
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 40rpx;
  background: #F0F9F7;
  border-radius: 16rpx;
  margin-right: 24rpx;
}

.feature-info {
  flex: 1;
}

.feature-title {
  font-size: 30rpx;
  color: #2D3748;
}

.feature-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #A0AEC0;
}

/* 开发者与联系方式 */
.info-card {
  padding: 0 32rpx;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F0F4F2;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #A0AEC0;
  width: 160rpx;
}

.info-value {
  flex: 1;
  font-size: 30rpx;
  color: #2D3748;
}

.info-action {
  font-size: 26rpx;
  color: #5BA89B;
  padding: 8rpx 20rpx;
  background: #E6F4F1;
  border-radius: 20rpx;
}

.about-footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #A0AEC0;
}
