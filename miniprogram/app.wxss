/**
 * 全局样式：马卡龙配色 + 圆润字体
 *
 * 配色：薄荷青主色 + 蜜桃粉辅助 + 暖灰中性
 * 圆角：全局 16px 大圆角，卡片 24px
 */

/* === 主题色变量（WXSS 不支持变量，用 class 复用） === */
page {
  background-color: #F9FDFB;
  color: #4A5568;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* === 通用卡片 ===
   改用 92% 白色 + 毛玻璃，让 detail 页的马卡龙渐变背景能透出
   96% 透明度在浅色背景下几乎等同纯白，但玻璃感更强 */
.card {
  background: rgba(255, 255, 255, 0.78);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
  backdrop-filter: saturate(180%) blur(24rpx);
  -webkit-backdrop-filter: saturate(180%) blur(24rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  box-shadow:
    0 4rpx 24rpx rgba(126, 206, 193, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

/* === 苹果毛玻璃按钮 ===
   - 半透明色块（透明度 0.75~0.85）作为基底，让背后内容能透出
   - backdrop-filter saturate(180%) blur(20rpx) 增强色彩饱和度同时模糊背景
   - 1px 内高光边框（白色 50% 透明）模拟玻璃边缘反光
   - 双向阴影：外柔光 + 内顶高光，符合 iOS 14+ 按钮质感
   - rpx 单位保持跨设备尺寸一致；border 用 2rpx 兼顾 iOS 1px 渲染 */

.btn-primary {
  background: linear-gradient(135deg, rgba(126, 206, 193, 0.78), rgba(91, 168, 155, 0.78));
  color: #FFFFFF;
  border-radius: 40rpx;
  padding: 20rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  text-align: center;
  backdrop-filter: saturate(180%) blur(20rpx);
  -webkit-backdrop-filter: saturate(180%) blur(20rpx);
  box-shadow:
    0 8rpx 24rpx rgba(91, 168, 155, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
  /* 不支持 backdrop-filter 时降级为不透明色块，保证可读性 */
  overflow: hidden;
  position: relative;
}

.btn-secondary {
  background: rgba(255, 211, 224, 0.65);
  color: #FF6B8A;
  border-radius: 40rpx;
  padding: 20rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  text-align: center;
  backdrop-filter: saturate(180%) blur(20rpx);
  -webkit-backdrop-filter: saturate(180%) blur(20rpx);
  box-shadow:
    0 8rpx 24rpx rgba(255, 107, 138, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
  overflow: hidden;
  position: relative;
}

/* 顶层高光：横向渐变从顶部透出，增强玻璃折射感
   用 ::before 伪元素不影响内容布局 */
.btn-primary::before,
.btn-secondary::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0));
  pointer-events: none;
  border-radius: 40rpx 40rpx 0 0;
}

/* 按钮内容层 z-index 高于 ::before 高光，避免文字被覆盖 */
.btn-primary > .btn-content,
.btn-secondary > .btn-content {
  position: relative;
  z-index: 1;
}

/* === 按钮内图标：开源 Tabler Icons (MIT)，禁止 AI 预制图标 ===
   主按钮图标统一为白色（通过 filter 强制反色），次按钮保留原色。
   尺寸 40rpx（约 20px），与文字垂直居中对齐，间距 12rpx */
.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  vertical-align: middle;
  flex-shrink: 0;
}

/* 主按钮内图标强制变白：解决薄荷绿按钮上看不见同色图标的撞色问题
   （SVG 描边色与按钮底色重叠时，filter 提亮对比度） */
.btn-primary .btn-icon {
  filter: brightness(0) invert(1);
}

/* 按钮内 image + text 水平排列容器，覆盖 button 默认 inline-block 居中问题 */
.btn-content {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* === 标签 === */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-mint { background: #B5EAD7; color: #5BA89B; }
.tag-pink { background: #FFD3E0; color: #FF6B8A; }
.tag-gray { background: #F0F4F2; color: #A0AEC0; }

/* === 文字辅助类 === */
.text-primary { color: #5BA89B; }
.text-secondary { color: #A0AEC0; }
.text-danger { color: #FF6B8A; }
.text-large { font-size: 36rpx; font-weight: 600; }
.text-small { font-size: 24rpx; }

/* === 加载状态 === */
.loading-mask {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
  color: #A0AEC0;
}

/* === 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #A0AEC0;
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* PNG 图标版空状态：与 emoji 视觉重量匹配 */
.empty-state .empty-icon-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

/* === 通用图标尺寸：覆盖列表项时长图标等场景 === */
.duration-icon {
  width: 24rpx;
  height: 24rpx;
}
