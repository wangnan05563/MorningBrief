diff --git a/backend/app/core/_t01661_probe.py b/backend/app/core/_t01661_probe.py
new file mode 100644
--- /dev/null
+++ b/backend/app/core/_t01661_probe.py
@@ -0,0 +1,58 @@
+"""T01661 临时分段计时探针（禁止合入 main，测完随副本销毁）。
+
+口径：
+- begin() 在请求入口建上下文；mark(name) 记录时间点；flush(endpoint) 打印相邻标记差值。
+- conn_pragma_* 来自 database._set_sqlite_pragma 的全局累加，按请求做差 → 归因
+  「本请求新建了几条连接、PRAGMA 花了多久」。
+- sink_ms 是**上一次** logger.info 调用自身耗时（本次无法自测，滞后一条，够定位量级）。
+"""
+import time
+from contextvars import ContextVar
+
+from loguru import logger
+
+_t0: ContextVar[float | None] = ContextVar("p_t0", default=None)
+_marks: ContextVar[list | None] = ContextVar("p_marks", default=None)
+_snap: ContextVar[tuple | None] = ContextVar("p_snap", default=None)
+
+CONN = {"n": 0, "ms": 0.0}
+_last_sink_ms = 0.0
+
+
+def begin() -> None:
+    _t0.set(time.perf_counter())
+    _marks.set([])
+    _snap.set((CONN["n"], CONN["ms"]))
+
+
+def mark(name: str) -> None:
+    m = _marks.get()
+    if m is None:
+        return
+    m.append((name, time.perf_counter()))
+
+
+def conn_event(ms: float) -> None:
+    CONN["n"] += 1
+    CONN["ms"] += ms
+
+
+def flush(endpoint: str) -> None:
+    global _last_sink_ms
+    t0, marks, snap = _t0.get(), _marks.get(), _snap.get()
+    if t0 is None or marks is None or snap is None:
+        return
+    parts, prev = [], t0
+    for name, ts in marks:
+        parts.append(f"{name}={(ts - prev) * 1000:.1f}ms")
+        prev = ts
+    total = (time.perf_counter() - t0) * 1000
+    d_n, d_ms = CONN["n"] - snap[0], CONN["ms"] - snap[1]
+    line = (
+        f"[T01661PROBE] endpoint={endpoint} total={total:.1f}ms "
+        + " ".join(parts)
+        + f" conn_new={d_n} conn_pragma={d_ms:.1f}ms sink_prev={_last_sink_ms:.2f}ms"
+    )
+    s = time.perf_counter()
+    logger.info(line)
+    _last_sink_ms = (time.perf_counter() - s) * 1000
