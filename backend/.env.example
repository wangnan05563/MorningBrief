# ============================================
# MorningBrief 环境变量模板（V1.2：SQLite + TTLCache + SCF + COS）
# 复制为 .env 后填入实际值，.env 不入库
# ============================================

# ---- 应用配置 ----
APP_ENV=development                         # development | production（单机 exe 部署用 development 启用 docs/CORS）
APP_DEBUG=false
APP_HOST=0.0.0.0                            # 真机测试需监听 0.0.0.0 让局域网可访问
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
# 音频/封面静态资源对外 URL
# 留空 → 启动时自动检测本机局域网 IP（开发环境零配置真机调试，切换 WiFi 不会失效）
# 显式配置 → 优先使用配置值（生产环境必须设为公网域名，如 https://cdn.example.com）
AUDIO_BASE_URL=
# 项目仓库地址（用于检查更新），留空时不检查更新
REPO_URL=

# ---- SQLite 数据库（V1.2 替代 MySQL，嵌入式无需外部容器） ----
# 开发态相对路径 ./data/news.db；打包后由 app/paths.py 解析为 exe 同级 ./data/news.db
SQLITE_DB_PATH=./data/news.db
SQLITE_JOURNAL_MODE=WAL                     # WAL 模式：读不阻塞写
SQLITE_BUSY_TIMEOUT_MS=5000                 # 写冲突时自动等待 5 秒
SQLITE_SYNCHRONOUS=NORMAL                   # NORMAL：性能与持久性平衡（WAL 下安全）

# ---- 缓存（V1.2 替代 Redis，进程内 TTLCache 无需外部配置） ----
CACHE_DEFAULT_TTL_SEC=300                   # 默认 TTL 5 分钟
CACHE_MAXSIZE=10000                         # 单桶最大条目数

# ---- JWT ----
JWT_SECRET=<请替换为 32+ 位随机字符串>        # openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7                            # C 端 token 有效期
JWT_ADMIN_EXPIRE_HOURS=2                     # B 端 token 有效期
# V1.2：C 端黑名单通过 COS 对象共享（SCF 读取），B 端黑名单写本地 SQLite
JWT_BLACKLIST_COS_PREFIX=jwt_blacklist/
JWT_BLACKLIST_CACHE_TTL_SEC=300              # B 端本地内存缓存 TTL

# ---- 微信小程序 ----
WX_APPID=<你的小程序 appid>
WX_SECRET=<你的小程序 secret>
# 微信公众平台 API 基础地址（仅在微信变更域名时才需修改）
WX_API_BASE=https://api.weixin.qq.com

# ---- 通义千问 LLM API ----
LLM_API_KEY=<你的通义千问 API key>
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max
LLM_TIMEOUT_SEC=30
LLM_RETRY_ATTEMPTS=3

# ---- 阿里云 TTS API ----
ALIYUN_TTS_API_KEY=<你的阿里云 TTS API key>
ALIYUN_TTS_APPKEY=<你的 NLS 项目 AppKey>     # NLS 项目详情页的 AppKey
ALIYUN_TTS_VOICE=xiaoyun                    # 默认音色（小芸）
ALIYUN_TTS_SAMPLE_RATE=44100
ALIYUN_TTS_FORMAT=mp3
ALIYUN_TTS_TIMEOUT_SEC=60
ALIYUN_TTS_VOLUME=50                        # 音量 [0, 100]，默认 50
ALIYUN_TTS_SPEECH_RATE=0                    # 语速 [-500, 500]，默认 0
ALIYUN_TTS_PITCH_RATE=0                     # 基频 [-500, 500]，默认 0
# 阿里云 NLS 网关地址（仅在阿里云变更域名/区域时才需修改）
ALIYUN_TTS_ENDPOINT=https://nls-gateway.cn-shanghai.aliyuncs.com/rest/v1/tts/async
TTS_RETRY_ATTEMPTS=3

# ---- TTS Provider 选择（前端 AI 配置页可热切换） ----
# aliyun：阿里云 NLS（需 API Key + AppKey）
# edge：微软 Edge-TTS（完全免费，无需 API Key，推荐开发/小规模生产）
# tencent：腾讯云 TTS（需 SecretId/SecretKey，可复用 COS 凭证）
TTS_PROVIDER=aliyun

# ---- Edge-TTS（微软免费方案） ----
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural         # 晓晓（标准女声）；zh-CN-YunyangNeural 为新闻男声标杆
EDGE_TTS_RATE=                              # 语速调节，如 +10% / -10%（可为空）
EDGE_TTS_VOLUME=                            # 音量调节，如 +20% / -10%（可为空）
EDGE_TTS_PITCH=                             # 基频调节，如 +5Hz / -3Hz（可为空）

# ---- 腾讯云 TTS（凭证可复用 COS_SECRET_ID/SECRET_KEY，留空则回退到 COS） ----
TENCENT_TTS_SECRET_ID=                      # 留空则回退到 COS_SECRET_ID
TENCENT_TTS_SECRET_KEY=                     # 留空则回退到 COS_SECRET_KEY
TENCENT_TTS_REGION=ap-guangzhou
TENCENT_TTS_VOICE_TYPE=101011               # 智燕（新闻女声，精品音色）
TENCENT_TTS_VOLUME=0                        # 音量 [-10, 10]，0 为默认
TENCENT_TTS_SPEED=0                         # 语速 [-2, 6]，0 为默认
# 腾讯云 TTS 服务 endpoint（云 API 3.0 入口，仅在腾讯云变更域名时才需修改）
TENCENT_TTS_ENDPOINT=https://tts.tencentcloudapi.com/

# ---- 腾讯云 COS（对象存储 + C 端 API 共享层） ----
COS_SECRET_ID=<你的腾讯云 secret id>
COS_SECRET_KEY=<你的腾讯云 secret key>
COS_REGION=ap-guangzhou
COS_BUCKET=<你的 bucket 名>
COS_CDN_DOMAIN=https://cdn.example.com      # CDN 加速域名（可为空）

# ---- 云函数 SCF（V1.2 新增：C 端 5 个接口承载层） ----
SCF_REGION=ap-guangzhou
SCF_NAMESPACE=default
SCF_RUNTIME=Python3.9
SCF_MEMORY_MB=512
SCF_TIMEOUT_SEC=30

# ---- 告警通知 ----
ALERT_SMS_ACCESS_KEY=<阿里云短信 access key>  # 可选
ALERT_SMS_SECRET_KEY=<阿里云短信 secret key>  # 可选
ALERT_SMS_SIGN_NAME=MorningBrief系统
ALERT_SMS_TEMPLATE_CODE=<短信模板 code>
ALERT_SMS_PHONE=<运营手机号>

# 钉钉群机器人（审核通知 + 告警，前端通知管理页可热配置覆盖此值）
ALERT_DINGTALK_WEBHOOK=
ALERT_DINGTALK_SECRET=                         # 加签密钥（以 SEC 开头），可选

# 企业微信群机器人（审核通知 + 告警，前端通知管理页可热配置覆盖此值）
ALERT_WECOM_WEBHOOK=

# 邮件 SMTP（运维告警存档用，前端通知管理页可热配置覆盖此值）
# 端口 465 走 SSL 直连，587/25 走 STARTTLS
ALERT_EMAIL_SMTP_HOST=                         # SMTP 服务器，如 smtp.qq.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_USER=                         # 发件人邮箱账号
ALERT_EMAIL_SMTP_PASSWORD=                     # SMTP 授权码（非邮箱登录密码）
ALERT_EMAIL_TO=                                # 收件人邮箱（多个用逗号分隔）

# ---- 工作流调度 ----
WORKFLOW_CRON_HOUR=5                         # APScheduler 触发小时（05:00）
WORKFLOW_BACKUP_CHECK_HOUR=6                 # 备播检查小时（06:30）
WORKFLOW_BACKUP_CHECK_MINUTE=30
WORKFLOW_LOCK_TTL_SEC=1800                   # 工作流互斥锁 TTL

# ---- 爬虫配置 ----
CRAWLER_DEDUP_TTL_DAYS=3                     # SQLite crawler_dedup 表保留天数
CRAWLER_QPS_DEFAULT=1
CRAWLER_USER_AGENT=MorningBriefBot/1.0
CRAWLER_MAX_ARTICLE_AGE_DAYS=14              # 文章最大年龄（天），超过视为历史存量过滤

# ---- 日志 ----
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR
LOG_DIR=./logs                               # V1.2：改为 exe 同级相对路径

# ---- FFmpeg 依赖（音频拼接必需，缺失时自动下载安装） ----
# BtbN/FFmpeg-Builds 共享构建下载源（gpl-shared，含 ffmpeg.exe/ffprobe.exe + DLL）
# 大陆访问 GitHub 较慢时可切换镜像源
FFMPEG_DOWNLOAD_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl-shared.zip
FFMPEG_DOWNLOAD_TIMEOUT_SEC=300              # 下载超时（秒），GitHub release 经 CDN 分发，需容错大文件场景
FFMPEG_CHECK_TIMEOUT_SEC=10                  # subprocess 检测超时（秒），未安装时 Windows 报错很快

# ---- 数据库维护模块（V1.2 新增） ----
DB_ADMIN_CONFIRM_TOKEN=<请替换为随机字符串>   # 危险操作确认令牌（空值时拒绝执行危险操作）
DB_ADMIN_MAX_PAGE_SIZE=1000                   # 单次查询/批量删除行数上限
DB_ADMIN_MAX_IMPORT_ROWS=5000                 # 单次导入行数上限
DB_ADMIN_AUDIT_LOG_LIMIT=500                  # 审计日志查询上限

# ---- 系统清理模块（V1.2 新增） ----
MAINTENANCE_BLACKLIST_RETAIN_DAYS=7           # 旧 JWT 黑名单保留天数
MAINTENANCE_DEDUP_RETAIN_DAYS=7               # 旧爬虫去重记录保留天数
MAINTENANCE_AI_USAGE_RETAIN_DAYS=90           # 旧 AI 用量日志保留天数
MAINTENANCE_PLAYLOG_RETAIN_DAYS=90            # 旧播放日志保留天数
MAINTENANCE_LARGE_LOG_MB=10                   # 大日志文件阈值（MB）

# ---- 音频后处理（V1.3 新增：码率统一） ----
# 全链路统一码率：TTS 后处理（normalize_loudness / trim_silence）+ 拼接（concat/mix_bgm）
# 语音内容 64kbps 已足够，128kbps 对纯人声浪费带宽与存储
# 取值示例：64k（默认，推荐）/ 96k / 128k（高音质）
AUDIO_BITRATE=64k

