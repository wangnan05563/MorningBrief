{
  "_comment": "Template metadata for create-bat skill. All placeholders map to config.json fields.",
  "templates": {
    "entry.bat": {
      "file": "templates/entry.bat.tmpl",
      "encoding": "pure_ascii",
      "line_endings": "CRLF",
      "bom": false,
      "placeholders": {
        "%chcp_line%": "encoding.bat_chcp -> chcp XXX >nul",
        "%entry_title%": "project.name + entries[].bat_file",
        "%entry_description%": "entries[].description or type label",
        "%ps1_entry_name%": "entries[].ps1_file",
        "%error_check_block%": "entries[].exit_code_propagation -> %ERRORLEVEL% check",
        "%success_title%": "project.name + success label",
        "%success_details%": "output path info",
        "%post_action_block%": "entries[].post_action -> pause >nul / exit /b"
      }
    },
    "build-entry.bat": {
      "file": "templates/build-entry.bat.tmpl",
      "encoding": "pure_ascii",
      "line_endings": "CRLF",
      "bom": false,
      "placeholders": {
        "%chcp_line%": "encoding.bat_chcp",
        "%entry_title%": "project.name + build label",
        "%build_steps_list%": "entries[].steps[].name joined",
        "%output_path%": "build.dist_dir",
        "%deps_check_block%": "toolchain.detected_tools -> version check",
        "%deps_install_block%": "toolchain.install_commands",
        "%build_command%": "entries[].steps[].command",
        "%post_action_block%": "entries[].post_action"
      }
    },
    "main.ps1": {
      "file": "templates/main.ps1.tmpl",
      "encoding": "UTF8_BOM",
      "line_endings": "CRLF",
      "bom": true,
      "placeholders": {
        "": "project.name",
        "": "entries[].bat_file",
        "": "entries[].type",
        "": "entries[].type-specific params",
        "": "project.root relative to scripts/",
        "": "toolchain.detected_tools -> version checks",
        "": "entries[].steps pipeline",
        "": "entries[].steps[].skip_flag flags",
        "": "build_pipeline.steps or entries[].steps",
        "": "build_pipeline.artifacts validation"
      }
    }
  },
  "config_field_groups": {
    "project": ["name", "version", "version_source", "version_file_path", "description", "root"],
    "encoding": ["bat_encoding", "ps1_encoding", "force_crlf", "chcp_codepage"],
    "entries": "array of {name, type, bat_file, ps1_file, window_style, post_action, steps[]}",
    "toolchain": ["install_commands", "fallback_chain", "detected_tools[]", "auto_install"],
    "deploy": ["mode", "installer.{enabled, type, iss_file, output_dir, architecture, languages}"],
    "diagnoses": "array of {name, pattern, category, fix, steps, severity}",
    "build_pipeline": "object with steps[] and artifacts[]",
    "global_params": "map of param_name -> {old_value, new_value, exclude_patterns, scan_dirs, exclude_dirs}",
    "port_conflict": ["kill_same_project", "kill_other_project", "default_strategy", "fallback_port", "port_release_wait_seconds"]
  }
}