{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Create-Bat Project Configuration",
  "description": "驱动 create-bat 技能生成/诊断 Windows 批处理脚本的通用配置文件。所有可变参数集中管理，无硬编码。",
  "type": "object",
  "required": [
    "project"
  ],
  "properties": {
    "project": {
      "description": "项目基本信息",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "项目名称，用于生成文件名和提示文本"
        },
        "version": {
          "type": "string",
          "description": "版本号，如 1.0.0。可为空则自动探测"
        },
        "version_source": {
          "type": "string",
          "enum": [
            "none",
            "package_json",
            "pyproject_toml",
            "setup_py",
            "custom_file"
          ],
          "description": "版本号来源"
        },
        "version_file_path": {
          "type": "string",
          "description": "当 version_source=custom_file 时的版本号文件路径"
        },
        "description": {
          "type": "string",
          "description": "项目描述，用于 echo 提示"
        },
        "root": {
          "type": "string",
          "description": "项目根目录相对路径（默认 scripts 所在父目录）"
        }
      }
    },
    "encoding": {
      "description": "编码策略配置",
      "type": "object",
      "properties": {
        "bat_encoding": {
          "type": "string",
          "enum": [
            "GBK",
            "UTF-8"
          ],
          "default": "GBK",
          "description": ".bat 文件编码。GBK=最兼容中文 Windows（推荐）"
        },
        "ps1_encoding": {
          "type": "string",
          "enum": [
            "UTF-8_BOM",
            "UTF-8_NO_BOM",
            "GBK"
          ],
          "default": "UTF-8_BOM",
          "description": ".ps1 文件编码。UTF-8_BOM=兼容 PS 5.1+7（推荐）"
        },
        "force_crlf": {
          "type": "boolean",
          "default": true,
          "description": "是否强制 CRLF 行尾"
        },
        "chcp_codepage": {
          "type": "integer",
          "default": 936,
          "description": "控制台输出代码页"
        }
      }
    },
    "entries": {
      "description": "脚本入口列表",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "start",
              "stop",
              "build",
              "deploy",
              "diagnose",
              "custom"
            ]
          },
          "bat_file": {
            "type": "string"
          },
          "ps1_file": {
            "type": "string"
          },
          "window_style": {
            "type": "string",
            "enum": [
              "Normal",
              "Hidden",
              "Maximized",
              "Minimized"
            ],
            "default": "Normal"
          },
          "log_redirect": {
            "type": "boolean",
            "default": false
          },
          "log_file": {
            "type": "string"
          },
          "post_action": {
            "type": "string",
            "enum": [
              "pause",
              "exit",
              "none"
            ],
            "default": "pause"
          },
          "call_required": {
            "type": "boolean",
            "default": true
          },
          "exit_code_propagation": {
            "type": "boolean",
            "default": true,
            "description": "是否传播子命令退出码（每个子步骤检查 $LASTEXITCODE 并 throw）"
          },
          "import_meta_compat": {
            "type": "boolean",
            "default": false,
            "description": "是否添加 import.meta.url 兼容性回退"
          },
          "pre_build_cleanup": {
            "type": "boolean",
            "default": false
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "command": {
                  "type": "string"
                },
                "fallback": {
                  "type": "string"
                },
                "timeout_seconds": {
                  "type": "integer"
                },
                "skip_if": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "toolchain": {
      "description": "工具链配置",
      "type": "object",
      "properties": {
        "install_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "package": {
                "type": "string"
              },
              "constraint": {
                "type": "string"
              }
            }
          }
        },
        "fallback_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detected_tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "min_version": {
                "type": "string"
              },
              "path_pattern": {
                "type": "string"
              }
            }
          }
        },
        "auto_install": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "winget",
                "download",
                "skip"
              ],
              "default": "winget"
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "winget_id": {
                    "type": "string"
                  },
                  "download_url": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "deploy": {
      "description": "部署模式配置",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "dev",
            "production",
            "service",
            "silent"
          ],
          "default": "dev"
        },
        "installer": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "type": {
              "type": "string",
              "enum": [
                "inno_setup",
                "nsis",
                "none"
              ],
              "default": "inno_setup"
            },
            "iss_file": {
              "type": "string"
            },
            "output_dir": {
              "type": "string"
            },
            "architecture": {
              "type": "string",
              "enum": [
                "x64",
                "x64compatible",
                "x64os",
                "arm64"
              ],
              "default": "x64compatible"
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "messages_file": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "diagnoses": {
      "description": "错误诊断规则配置",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pattern",
          "fix"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "encoding",
              "dependency",
              "window_visibility",
              "syntax",
              "runtime",
              "build_control_flow",
              "exit_code_propagation",
              "bundle_format",
              "installer_failure",
              "network_timeout"
            ]
          },
          "fix": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "error",
              "fatal"
            ],
            "default": "error"
          }
        }
      }
    },
    "build_pipeline": {
      "description": "构建流水线配置（多步骤构建场景）",
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "cjs",
                  "esm",
                  "auto"
                ],
                "default": "auto"
              },
              "output": {
                "type": "string"
              },
              "skip_flag": {
                "type": "string"
              },
              "depends_on": {
                "type": "string"
              },
              "on_fail": {
                "type": "string",
                "enum": [
                  "stop",
                  "warn",
                  "skip"
                ],
                "default": "stop"
              },
              "import_meta_compat": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "destination": {
                "type": "string"
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            }
          }
        }
      }
    }
  }
}
