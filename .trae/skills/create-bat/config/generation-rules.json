{
  "_comment": "Generation rules for create-bat skill. Drives the 7-step generation flow.",
  "generation_steps": [
    {
      "step": 1,
      "name": "需求分析",
      "actions": ["询问脚本用途", "确认调用链", "检查中文需求", "确认工具链", "确认依赖冲突", "确认配置文件"],
      "outputs": ["用户需求摘要"]
    },
    {
      "step": 2,
      "name": "生成 config.json",
      "actions": ["使用占位符生成配置", "引用 template-meta.json 了解字段"],
      "outputs": ["config.json"],
      "schema_ref": "config/schema.json"
    },
    {
      "step": 3,
      "name": "生成 .bat 入口",
      "actions": ["读取 template-meta.json 中 entry.bat 占位符", "填充纯 ASCII 内容", "确保 CRLF 行尾"],
      "outputs": ["scripts/*.bat"],
      "encoding_rule": "pure_ascii_no_bom_crlf",
      "template_ref": "templates/entry.bat.tmpl or templates/build-entry.bat.tmpl"
    },
    {
      "step": 4,
      "name": "生成 .ps1 主逻辑",
      "actions": ["读取 template-meta.json 中 main.ps1 占位符", "从 config.json 读取参数", "确保 UTF-8 BOM + CRLF"],
      "outputs": ["scripts/*.ps1"],
      "encoding_rule": "UTF8_BOM_crlf",
      "template_ref": "templates/main.ps1.tmpl"
    },
    {
      "step": 5,
      "name": "生成验证脚本",
      "actions": ["生成 verify.ps1", "运行编码/行尾/BOM/非ASCII验证"],
      "outputs": ["scripts/verify.ps1"],
      "validation": ["非ASCII=0 for .bat", "BOM存在 for .ps1", "无孤立LF", "PS Parser语法检查"]
    },
    {
      "step": 6,
      "name": "生成 installer.iss（可选）",
      "actions": ["仅在 deploy.installer.enabled=true 时生成"],
      "outputs": ["installer.iss"]
    },
    {
      "step": 7,
      "name": "最终验证",
      "actions": ["运行 verify.ps1", "PS Parser 校验", "提示用户测试"],
      "checks": ["编码验证", "语法校验", "冒烟测试"]
    }
  ],
  "encoding_rules": {
    "bat": { "encoding": "pure_ascii", "bom": false, "line_endings": "CRLF", "non_ascii_limit": 0 },
    "ps1": { "encoding": "UTF8", "bom": true, "line_endings": "CRLF" }
  },
  "bat_placeholders_must_be_ascii": true,
  "chinese_output_in_ps1_only": true
}