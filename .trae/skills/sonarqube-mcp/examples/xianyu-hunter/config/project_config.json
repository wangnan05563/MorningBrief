{
  "_meta": {
    "purpose": "Xianyu Hunter 项目配置示例（FastAPI 后端 + React 前端）",
    "version": "2.0.0"
  },
  "project": {
    "key": "xianyu_hunter",
    "name": "Xianyu Hunter",
    "base_path": "../..",
    "description": "闲鱼猎人：FastAPI 后端 + React 前端"
  },
  "modules": {
    "backend": {
      "path": "src",
      "languages": ["python"],
      "frameworks": ["fastapi"],
      "layers": {
        "api": "api",
        "core": "core",
        "models": "models",
        "services": "services",
        "utils": "utils",
        "web": "web",
        "config": "config"
      },
      "exclude": ["web/static", "web/templates", "__pycache__", "node_modules", ".git", "dist", "build", "tests"]
    },
    "frontend": {
      "path": "frontend/src",
      "languages": ["typescript", "javascript"],
      "frameworks": ["react"],
      "layers": {
        "components": "components",
        "pages": "pages",
        "hooks": "hooks",
        "utils": "utils",
        "services": "services",
        "types": "types",
        "store": "store"
      },
      "exclude": ["node_modules", "dist", "build", "__tests__"]
    }
  },
  "verify": {
    "test_command": "pytest tests/ ; cd frontend && npm test -- --watchAll=false"
  },
  "report": {
    "output_dir": "docs/04-系统维护/sonar-reports/"
  },
  "framework_extensions": {
    "fastapi_decorators": [
      "@app.get", "@app.post", "@app.put", "@app.delete", "@app.patch",
      "@router.get", "@router.post", "@router.put", "@router.delete", "@router.patch",
      "@app.websocket", "@app.on_event", "@app.middleware"
    ],
    "react_patterns": ["useEffect", "useState", "useCallback", "useMemo", "React.memo"]
  },
  "_usage_notes": [
    "1. 复制此文件到 ../../config/project_config.json",
    "2. 修改 project.key 为你的项目名",
    "3. 根据需要调整 modules.backend.path 和 modules.frontend.path",
    "4. 设置环境变量 SONAR_TOKEN",
    "5. 运行 .\\scripts\\verify-connection.ps1 验证"
  ]
}
