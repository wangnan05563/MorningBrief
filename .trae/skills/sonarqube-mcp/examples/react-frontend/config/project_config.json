{
  "_meta": {
    "purpose": "纯 React 前端项目示例",
    "version": "2.0.0",
    "suitable_for": "React + TypeScript 单页应用或前端项目"
  },
  "project": {
    "key": "my_react_frontend",
    "name": "My React Frontend",
    "base_path": "../..",
    "description": "React + TypeScript 前端项目"
  },
  "modules": {
    "frontend": {
      "path": "src",
      "languages": ["typescript", "javascript"],
      "frameworks": ["react"],
      "layers": {
        "components": "components",
        "pages": "pages",
        "hooks": "hooks",
        "utils": "utils",
        "services": "services",
        "types": "types",
        "store": "store"
      },
      "exclude": ["node_modules", "dist", "build", "__tests__"]
    }
  },
  "verify": {
    "test_command": "npm test -- --watchAll=false"
  },
  "report": {
    "output_dir": "docs/sonar-reports/"
  },
  "framework_extensions": {
    "react_patterns": [
      "useState", "useEffect", "useCallback", "useMemo",
      "useRef", "useContext", "useReducer", "React.memo"
    ]
  },
  "hard_constraints": {
    "_note": "此示例启用通用 core 规则 + 浏览器相关 XSS 防护",
    "enabled_business_rules": []
  },
  "_usage_notes": [
    "1. 复制此文件到 ../../config/project_config.json",
    "2. 修改 project.key 为你的项目名",
    "3. 根据需要调整 modules.frontend.path 和 layers",
    "4. 设置环境变量 SONAR_TOKEN 和 SONARQUBE_URL",
    "5. framework_patterns.json 会自动识别 React 误报（S6488/S6486/S6759）"
  ]
}
