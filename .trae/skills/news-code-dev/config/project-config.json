{
    "project": {
        "name": "MorningBrief",
        "description": "AI 驱动的播客新闻分发平台",
        "version": "1.0.0"
    },
    "paths": {
        "backend_root": "backend/app",
        "frontend_root": "admin-web/src",
        "miniprogram_root": "miniprogram",
        "tests_root": "backend/tests",
        "deploy_dir": ".",
        "docker_compose": "docker-compose.yml"
    },
    "backend": {
        "python_version": "3.12",
        "framework": "FastAPI",
        "orm": "SQLAlchemy 2.0 async",
        "database": "SQLite (aiosqlite, WAL mode + busy_timeout)",
        "cache": "TTLCache (进程内缓存, V1.2 替代 Redis)",
        "scheduler": "APScheduler (AsyncIOScheduler)",
        "http_client": "httpx.AsyncClient",
        "packaging": "PyInstaller 6.x (standalone exe)",
        "test_framework": "pytest + aiosqlite",
        "linter": "py_compile / ruff"
    },
    "frontend": {
        "framework": "Vue 3 + <script setup>",
        "ui_library": "Element Plus",
        "build_tool": "Vite",
        "state_management": "Pinia",
        "api_client": "axios",
        "miniprogram": "原生微信小程序"
    },
    "ai_services": {
        "llm": "通义千问 (DashScope)",
        "tts": "阿里云 NLS",
        "storage": "腾讯云 COS"
    },
    "deployment": {
        "mode": "单机 exe (PyInstaller 6.x) / 开发模式 (venv → 系统 Python)",
        "database": "SQLite (WAL mode + busy_timeout, data/news.db)",
        "cache": "TTLCache (进程内, 无 Redis 依赖)",
        "static_files": "FastAPI StaticFiles 挂载 admin-web/dist",
        "reverse_proxy": "无 (开发模式直连 8000 端口)"
    },
    "hardConstraints": {
        "jwt_secret_env": "JWT_SECRET",
        "auth_whitelist": [
            "/api/v1/health",
            "/api/v1/auth/wechat-login",
            "/docs",
            "/redoc",
            "/openapi.json"
        ],
        "internal_routes_require_verify_localhost": true,
        "forbidden_patterns": [
            "datetime.utcnow()",
            "datetime.now()",
            "print(",
            "any",
            "bare_except_pass",
            "duration.*超出.*范围.*raise",
            "length.*exceed.*raise",
            "model.*预设.*官网不符",
            "batch_delete_no_transaction",
            "static_route_after_dynamic_route",
            "loguru_%s_placeholder",
            "shared_build_dll_only_exe",
            "start_process_no_double_quote"
        ],
        "required_patterns": [
            "utcnow_naive()",
            "asyncio.to_thread()",
            "logger.exception()",
            "MIN_DURATION_SEC",
            "MAX_DURATION_SEC",
            "MODEL_PRICING.*模型名同步",
            "batch_delete_with_commit()",
            "selection_change_tracking",
            "loguru_{}_placeholder",
            "shared_build_extract_all_dlls",
            "build_process_kill_before_remove"
        ],
        "enum_value_required": true,
        "redis_lua_atomic": true,
        "pydantic_v2_methods": true,
        "sqlalchemy_2_0_style": true,
        "model_name_official_source": true,
        "pricing_table_sync": true
    }
}