<!-- 节目信息卡片：日期+分类 / 标题 / 时长，可选操作按钮 -->
<view class="episode-card">
  <view class="episode-meta">
    <text class="episode-date">{{episode.date}}</text>
    <text class="tag tag-mint" wx:if="{{episode.categories}}">{{episode.categories[0]}}</text>
  </view>
  <view class="episode-title">{{episode.title}}</view>
  <view class="episode-duration">
    <image class="duration-icon" lazy-load src="/images/icons/duration.png" mode="aspectFit" />
    <text>时长 {{fmt.time(episode.duration)}}</text>
  </view>

  <!-- 操作按钮区：仅 showActions=true 时显示，列表场景用
       T00384：去掉中文文案，图标即按钮；aria-label 保留无障碍语义 -->
  <view class="episode-actions" wx:if="{{showActions}}">
    <view class="icon-btn action-btn action-play" catchtap="onPlay" aria-label="播放">
      <image class="icon-btn-img" lazy-load src="/images/icons/play-mini.png" mode="aspectFit" />
    </view>
    <view class="icon-btn action-btn action-detail" catchtap="onViewDetail" aria-label="查看详情">
      <image class="icon-btn-img" lazy-load src="/images/icons/info.png" mode="aspectFit" />
    </view>
  </view>
</view>

<!-- WXS：时长格式化 mm:ss，与各页面原 fmt.time 逻辑一致 -->
<wxs module="fmt">
  module.exports = {
    time: function(s) {
      s = s || 0;
      var m = Math.floor(s / 60);
      var sec = Math.floor(s % 60);
      return (m < 10 ? '0' + m : m) + ':' + (sec < 10 ? '0' + sec : sec);
    }
  };
</wxs>
