/*
 * 节目卡片样式：融合 index/detail 两页样式，以 index 为主
 * 卡片基础样式从 app.wxss .card 迁移，保持组件自包含（不依赖全局样式）
 */
.episode-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(63, 108, 143, 0.08);
  display: flex;
  flex-direction: column;
}

.episode-meta {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

/* 日期用薄荷青，与全局主题色呼应 */
.episode-date {
  font-size: 26rpx;
  color: var(--accent-light);
  font-weight: 500;
  margin-right: 16rpx;
}

/* 分类标签：复用全局 .tag .tag-mint 视觉，组件内重写以避免依赖全局样式 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-mint {
  background: var(--accent-soft-strong);
  color: var(--accent);
}

.episode-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.episode-duration {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-muted);
}

.duration-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

/* === 操作按钮区（showActions=true 时显示） ===
   T00384：图标即按钮，去掉中文文案；触控区沿用全局 .icon-btn 规范（≥88rpx） */
.episode-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 图标按钮基础样式：本地复刻 app.wxss 的 .icon-btn / .icon-btn-img
   （组件样式默认 isolated 吃不到全局类，本组件约定自包含不依赖全局样式；
   CSS 自定义属性可跨样式隔离继承，令牌仍可直接引用） */
.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  transition: all 0.15s ease;
}

.action-btn:active {
  background: var(--bg-subtle);
}

.icon-btn-img {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

/* 播放按钮：品牌色实底 + 白色图标（play-mini.png 已烘焙为白） */
.action-play {
  background: var(--accent);
  border-color: var(--accent);
}

/* 详情按钮：浅底 + 描边，图标保持商务蓝 */
.action-detail {
  background: var(--accent-soft);
  border-color: var(--accent-soft-strong);
}
