/**
 * 全局样式：商务浅白主题（Business Light）
 *
 * 配色（设计令牌集中在下方 page 规则，业务样式一律引用 var(--token)，禁止裸色值）：
 * - 背景：白 / 浅灰（--bg-page #F7F8FA、--bg-card #FFFFFF、--bg-subtle #F2F4F7）
 * - 文字：深灰近黑（--text-primary #1F2733、--text-secondary #58636F、--text-muted #98A2AE）
 * - 点缀：低饱和商务蓝（--accent #3F6C8F），替代原薄荷青 + 蜜桃粉的双彩色方案
 * - 语义色：低饱和砖红 / 墨绿 / 赭黄（仅用于错误、成功、警示，不做装饰）
 *
 * 形态：小圆角（卡片 16rpx、按钮 12-16rpx），去掉马卡龙渐变与毛玻璃，走简约专业路线。
 *
 * 兼容性说明：CSS 自定义属性（var()）在 WXSS 中自基础库 2.x 起支持，
 * 本项目 project.config.json 锁定 libVersion 3.3.4，可放心使用。
 */

/* === 设计令牌（Design Tokens） ===
   所有页面样式通过 var() 引用，统一色板只在改这一处 */
page {
  /* 背景 */
  --bg-page: #f7f8fa;
  --bg-card: #ffffff;
  --bg-subtle: #f2f4f7;

  /* 描边 */
  --border: #e5e8ec;
  --border-strong: #d6dbe1;

  /* 文字 */
  --text-primary: #1f2733;
  --text-secondary: #58636f;
  --text-muted: #98a2ae;
  --text-inverse: #ffffff; /* 深色底（--accent / --danger）上的反白文字 */

  /* 点缀色：低饱和商务蓝 */
  --accent: #3f6c8f;
  --accent-light: #6c93af;
  --accent-dark: #2f5674;
  --accent-soft: #edf3f7;
  --accent-soft-strong: #dfeaf2;

  /* 语义色（低饱和，仅用于状态表达） */
  --danger: #b0554a;
  --danger-soft: #f7eeec;
  --success: #4b7f63;
  --success-soft: #edf4f0;
  --warning: #9c7a3c;
  --warning-soft: #f7f2e6;

  /* 圆角与阴影 */
  --radius-card: 16rpx;
  --radius-btn: 16rpx;
  --radius-pill: 999rpx;
  --shadow-card: 0 2rpx 12rpx rgba(31, 39, 51, 0.05);
  --shadow-raised: 0 4rpx 16rpx rgba(31, 39, 51, 0.08);

  background-color: var(--bg-page);
  color: var(--text-secondary);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* === 通用卡片 ===
   浅白主题改为实色白底 + 1rpx 浅描边 + 极轻阴影：去毛玻璃，边界更清晰、更"专业" */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 32rpx;
  margin: 24rpx;
  border: 2rpx solid var(--border);
  box-shadow: var(--shadow-card);
}

/* === 主按钮 ===
   深色实底（商务蓝）+ 白字，圆角收敛为 16rpx，去掉渐变与高光伪元素 */
.btn-primary {
  background: var(--accent);
  color: #ffffff;
  border-radius: var(--radius-btn);
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  /* T00753 全局统一：按钮无边框（扁平化） */
  text-align: center;
  overflow: hidden;
  position: relative;
}

.btn-primary:active {
  background: var(--accent-dark);
}

/* 次按钮：浅底 + 商务蓝文字 + 浅描边（替代原粉色底方案） */
.btn-secondary {
  background: var(--accent-soft);
  color: var(--accent);
  border-radius: var(--radius-btn);
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  /* T00753 全局统一：按钮无边框，层级靠浅底 */
  text-align: center;
  overflow: hidden;
  position: relative;
}

.btn-secondary:active {
  background: var(--bg-subtle);
}

/* 按钮内容层：图标 + 文字水平居中 */
.btn-primary > .btn-content,
.btn-secondary > .btn-content {
  position: relative;
  z-index: 1;
}

/* === 按钮内图标：开源 Tabler Icons (MIT)，禁止 AI 预制图标 ===
   图标-only 按钮（.btn-icon-only）不设右边距，尺寸放大到 44rpx 提升点击与视觉比重 */
.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  vertical-align: middle;
  flex-shrink: 0;
}

/* 图标-only 按钮：去掉文字后图标居中放大 */
.btn-icon-only .btn-icon {
  margin-right: 0;
  width: 44rpx;
  height: 44rpx;
}

/* 主按钮内图标强制变白：解决深底上看不见深色描边图标的问题 */
.btn-primary .btn-icon {
  filter: brightness(0) invert(1);
}

/* 按钮内 image + text 水平排列容器，覆盖 button 默认 inline-block 居中问题 */
.btn-content {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* === 标准化图标按钮（ICON-BUTTON 规范） ===
   所有「图标即按钮」的场景统一引用本组类，保证跨页面尺寸与点击区一致：
   - 触控区 ≥ 88rpx（微信建议最小 40px ≈ 80rpx，留余量）
   - 图标 44rpx，扁平风格统一前景色 --text-secondary / 激活态 --accent（T00753 去描边）
   - 无中文文案，语义靠图标 + aria-label 承载 */
.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  border-radius: var(--radius-btn);
  /* T00753 全局统一：图标按钮扁平化——无描边，靠底色/激活色区分 */
  background: transparent;
  border: none;
  color: var(--text-secondary);
  transition: background-color 0.15s ease;
}

.icon-btn:active {
  background: var(--bg-subtle);
}

.icon-btn.active {
  background: var(--accent-soft);
}

.icon-btn-img {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

/* 图标本身已是 --accent 商务蓝（PNG 烘焙色），激活态只换底/描边，不叠 filter，
   避免二次上色把 PNG 拖成脏色 */

/* === 标签 === */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-mint { background: var(--accent-soft); color: var(--accent); }
.tag-pink { background: var(--danger-soft); color: var(--danger); }
.tag-gray { background: var(--bg-subtle); color: var(--text-muted); }

/* === 文字辅助类 === */
.text-primary { color: var(--accent); }
.text-secondary { color: var(--text-muted); }
.text-danger { color: var(--danger); }
.text-large { font-size: 36rpx; font-weight: 600; }
.text-small { font-size: 24rpx; }

/* === 加载状态 === */
.loading-mask {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
  color: var(--text-muted);
}

/* === 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: var(--text-muted);
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* PNG 图标版空状态：与 emoji 视觉重量匹配 */
.empty-state .empty-icon-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

/* === 通用图标尺寸：覆盖列表项时长图标等场景 === */
.duration-icon {
  width: 24rpx;
  height: 24rpx;
}

/* === T00599：加载态分级提示（慢加载 / 超时重试），骨架页共用 ===
   与骨架屏配合使用：loadingSlow → 文字提示；loadingTimedOut → 保留骨架 + 重试按钮 */
.load-hint {
  margin: 16rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
}

.load-retry-wrap {
  display: flex;
  justify-content: center;
  margin: 16rpx 0 24rpx;
}

.load-retry-btn {
  min-height: 64rpx;
  line-height: 64rpx !important;
  padding: 0 40rpx !important;
  margin: 0 !important;
  border-radius: var(--radius-btn) !important;
  background: var(--accent-soft) !important;
  color: var(--accent) !important;
  /* T00753 全局统一：按钮无边框 */
  font-size: 26rpx !important;
}

.load-retry-btn::after {
  border: none !important;
}
