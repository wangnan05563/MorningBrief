/* 我的下载页样式（复用全局浅色主题：主色 var(--accent)，辅粉 var(--accent)） */
.download-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx;
}

/* 顶部统计条 */
.stat-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(63, 108, 143, 0.08);
}
.stat-info {
  display: flex;
  flex-direction: column;
}
.stat-count {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.stat-size {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}
/* T00384：清空/删除改为图标按钮，触控区 88rpx */
.stat-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-btn);
  background: var(--danger-soft);
}
/* J60：三枚删除按钮此前同形同色，「清空 30 章」与「删 1 章」视觉权重一致。
   现在按影响面分级：全部清空（红底 + 文字）> 清空本课程（灰底 + 文字）> 单章删除（仅图标）。 */
.stat-clear--all {
  width: auto;
  padding: 0 20rpx;
  gap: 8rpx;
}
.clear-text {
  font-size: 22rpx;
  color: var(--danger, #b0554a);
}
.clear-text--group {
  color: var(--text-muted);
}

/* 分组 */
.dl-group {
  margin-bottom: 24rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(63, 108, 143, 0.06);
}
.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
}
.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.group-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  width: auto;
  padding: 0 16rpx;
  gap: 6rpx;
  border-radius: var(--radius-btn);
  background: var(--bg-subtle);
}
.dl-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
}
.dl-item:last-child {
  border-bottom: none;
}
.dl-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.dl-title {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.4;
}
.dl-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}
.dl-del {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-left: 16rpx;
  border-radius: var(--radius-btn);
  background: transparent;
}
/* 图标按钮内的图标尺寸（本页统一 40rpx） */
.dl-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}
.empty-icon-img {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.6;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.6;
}
