<!-- 我的下载：离线缓存管理（FR-MC-09） -->
<view class="download-page">

  <!-- 顶部统计条 -->
  <view class="stat-bar" wx:if="{{totalCount > 0}}">
    <view class="stat-info">
      <text class="stat-count">共 {{totalCount}} 章</text>
      <text class="stat-size">占用 {{totalSizeLabel}}</text>
    </view>
    <!-- T00384：清空/删除全部改为图标按钮 -->
    <view class="stat-clear" bindtap="onClearAll" aria-label="清空全部下载">
      <image class="dl-icon" lazy-load src="/images/icons/trash.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 分组列表 -->
  <block wx:if="{{totalCount > 0}}">
    <view class="dl-group" wx:for="{{groups}}" wx:key="channelId" wx:for-item="group">
      <view class="group-head">
        <text class="group-name">{{group.channelName}}</text>
        <view class="group-clear" catchtap="onClearChannel" data-channel-id="{{group.channelId}}" aria-label="清空该频道下载">
          <image class="dl-icon" lazy-load src="/images/icons/trash.png" mode="aspectFit" />
        </view>
      </view>
      <view
        class="dl-item"
        wx:for="{{group.items}}"
        wx:key="episodeId"
        wx:for-item="item"
        bindtap="onTapItem"
        data-id="{{item.episodeId}}"
        data-channel-id="{{item.channelId}}"
      >
        <view class="dl-main">
          <text class="dl-title">{{item.titleText}}</text>
          <text class="dl-sub">{{item.subText}}</text>
        </view>
        <view class="dl-del" catchtap="onDeleteItem" data-id="{{item.episodeId}}" aria-label="删除该下载">
          <image class="dl-icon" lazy-load src="/images/icons/x.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </block>

  <!-- 空态 -->
  <view class="empty-state" wx:else>
    <image class="empty-icon-img" src="/images/icons/headphones.png" mode="aspectFit" />
    <text class="empty-title">还没有离线下载</text>
    <text class="empty-desc">在课程页点击「下载整门课程」或单章「下载」，\n即可离线收听～</text>
  </view>

</view>

<!-- 全局浮动播放器：离开 tab 后仍可看到并控制后台播放（B4） -->
<floating-player />
