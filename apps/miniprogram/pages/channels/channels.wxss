/* pages/channels/channels.wxss */

/* T00730：频道卡头像（icon_url 上传/AI 生成）；无图标回退频道首字圆形占位
   （骨架屏 .sk-avatar 88rpx 圆形早已预留头像位，此处补齐真实卡片） */
.channel-item {
  display: flex;
  align-items: center;
}
.channel-info {
  flex: 1;
  min-width: 0;
}
.channel-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: var(--accent-soft, #eef3f7);
}
.channel-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--accent, #3f6c8f);
}

/* 频道类型标签（课程/有声书）：复用全局绿色系（FR-MC-02） */
.channel-type-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--text-inverse);
  background: var(--accent);
  vertical-align: middle;
}

/* 频道列表骨架屏（A8）：加载中占位，避免弱网白屏，与首页/course 风格一致 */
.skeleton-wrap {
  padding: 24rpx;
}
.skeleton-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.sk-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--border);
  flex-shrink: 0;
}
.sk-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}
.sk-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: var(--border);
}
.sk-line.short {
  width: 50%;
}
.sk-btn {
  width: 96rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: var(--border);
  flex-shrink: 0;
}

/* 骨架屏 shimmer 动画（与首页/course 一致；channels 页局部补全） */
.shimmer {
  background: linear-gradient(90deg, var(--border) 25%, var(--bg-card) 37%, var(--border) 63%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease infinite;
}
@keyframes sk-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* T02513 / J48：顶部职责说明条（与 preferred-settings 页同款，两页互为对照）。
   这里不用全局 .card 而用 accent-soft，是为了让「说明」和「可点的频道卡」在视觉上分层。 */
.tip-bar {
  margin: 24rpx;
  padding: 20rpx 28rpx;
  background: var(--accent-soft, #eef3f7);
  border-radius: 16rpx;
}
.tip-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--accent, #3f6c8f);
}
.tip-link {
  margin-top: 12rpx;
}
.tip-link text {
  font-size: 26rpx;
  color: var(--accent, #3f6c8f);
  text-decoration: underline;
}
