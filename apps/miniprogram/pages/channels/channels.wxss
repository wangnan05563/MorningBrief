/* pages/channels/channels.wxss */

/* 频道类型标签（课程/有声书）：复用全局绿色系（FR-MC-02） */
.channel-type-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: var(--text-inverse);
  background: var(--accent);
  vertical-align: middle;
}

/* 频道列表骨架屏（A8）：加载中占位，避免弱网白屏，与首页/course 风格一致 */
.skeleton-wrap {
  padding: 24rpx;
}
.skeleton-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.sk-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--border);
  flex-shrink: 0;
}
.sk-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}
.sk-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: var(--border);
}
.sk-line.short {
  width: 50%;
}
.sk-btn {
  width: 96rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: var(--border);
  flex-shrink: 0;
}

/* 骨架屏 shimmer 动画（与首页/course 一致；channels 页局部补全） */
.shimmer {
  background: linear-gradient(90deg, var(--border) 25%, var(--bg-card) 37%, var(--border) 63%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease infinite;
}
@keyframes sk-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}
