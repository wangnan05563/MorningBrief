<!-- 频道管理页 -->
<view class="page-channels">
  <!-- 加载中骨架屏（A8）：频道卡占位，避免弱网白屏 -->
  <view class="skeleton-wrap" wx:if="{{loading}}">
    <view class="skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="sk-avatar shimmer"></view>
      <view class="sk-lines">
        <view class="sk-line shimmer"></view>
        <view class="sk-line short shimmer"></view>
      </view>
      <view class="sk-btn shimmer"></view>
    </view>
    <!-- T00599：分级加载提示——慢加载文案 / 超时重试入口（骨架保持） -->
    <view class="load-hint" wx:if="{{loadingSlow}}">网络较慢，正在加载…</view>
    <view class="load-retry-wrap" wx:if="{{loadingTimedOut}}">
      <button class="load-retry-btn" bindtap="onRetryLoad" hover-class="none">重试</button>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{channels.length === 0}}">
    <image class="empty-icon-img" src="/images/icons/radio.png" mode="aspectFit" />
    <text>暂无可用频道</text>
  </view>

  <!-- 频道列表 -->
  <block wx:else>
    <view class="channel-list">
      <view
        class="card channel-item"
        wx:for="{{channels}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-index="{{index}}"
      >
        <!-- 频道信息：点击切换到该频道 -->
        <view class="channel-info" data-id="{{item.id}}" bindtap="onTapChannel">
          <view class="channel-name">
            {{item.name}}
            <text wx:if="{{item.type_label && item.type_label !== '资讯'}}" class="channel-type-tag">{{item.type_label}}</text>
          </view>
          <view class="channel-desc">{{item.description || '精彩内容，等你来听'}}</view>
        </view>

        <!-- 订阅按钮：点击订阅/取消订阅，不触发卡片跳转 -->
        <view
          class="subscribe-btn {{item.is_subscribed ? 'subscribed' : ''}}"
          data-id="{{item.id}}"
          data-index="{{index}}"
          catchtap="onToggleSubscribe"
        >
          <text>{{item.is_subscribed ? '已订阅' : '订阅'}}</text>
        </view>
      </view>
    </view>
  </block>
</view>

<!-- 全局浮动播放器：离开 tab 后仍可看到并控制后台播放（B4） -->
<floating-player />
