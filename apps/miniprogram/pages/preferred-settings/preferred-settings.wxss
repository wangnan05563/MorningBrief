/**
 * 偏爱频道设置页样式
 * 复用全局 .card 卡片基础样式，仅扩展多选交互相关元素：
 * - tip-bar：顶部说明条
 * - channel-item：点击切换选中态，选中时整体高亮
 * - check-box / check-icon：右上角勾选标记
 * - bottom-bar：固定底部操作栏（全选/保存）
 */
.page-preferred-settings {
  padding-bottom: 140rpx; /* 给底部操作栏留位，避免最后一项被遮 */
}

.tip-bar {
  margin: 24rpx;
  padding: 20rpx 28rpx;
  background: var(--accent-soft);
  border-radius: 16rpx;
}
.tip-text {
  /* T02513 / J48：text 默认 inline，说明写成两句时必须逐块换行才读得清 */
  display: block;
  font-size: 26rpx;
  color: var(--accent);
}
/* T02513 / J48：反向入口（去频道页管订阅），与 channels 页样式同款 */
.tip-link {
  margin-top: 12rpx;
}
.tip-link text {
  font-size: 26rpx;
  color: var(--accent);
  text-decoration: underline;
}

.channel-list {
  margin-top: 8rpx;
}

/* 单个频道卡片：复用全局 .card，此处仅扩展选中态 */
.channel-item {
  display: flex;
  align-items: center;
  transition: background 0.2s, border-color 0.2s;
  /* T00753：仅占位（选中态无边框），保留透明占位避免布局跳动 */
  border: 2rpx solid transparent;
}
.channel-item.selected {
  background: var(--accent-soft);
  border-color: var(--accent-light);
}

.channel-info {
  flex: 1;
  min-width: 0; /* 让 text 省略号生效 */
}
.channel-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}
.channel-desc {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 勾选标记：未选时是浅灰描边圆，选中时填充薄荷青 */
.check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
  flex-shrink: 0;
  margin-left: 24rpx;
}
.check-box.checked {
  background: var(--accent);
  border-color: var(--accent);
}
.check-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 底部操作栏：固定在屏幕底部，与 floating-player 错开 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  box-shadow: 0 -4rpx 16rpx rgba(63, 108, 143, 0.12);
  z-index: 100;
}

/* T00384：全选/暂不设置改为图标按钮，触控区 88rpx */
.select-all-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-btn);
  background: var(--accent-soft);
  /* T00753 全局统一：按钮无边框 */
}

.select-all-btn:active {
  background: var(--accent-soft);
}

.bar-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 保存按钮：图标 + 已选数量角标（数量是状态而非按钮文案） */
.save-btn {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  min-height: 88rpx;
  padding: 0;
  background: var(--accent);
  color: var(--text-inverse);
  border-radius: var(--radius-btn);
}

.save-btn-icon {
  width: 44rpx;
  height: 44rpx;
}

.save-count {
  position: absolute;
  top: 8rpx;
  right: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  color: var(--accent);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
}
.save-btn.disabled {
  background: var(--border);
  color: var(--text-muted);
}
