<!-- 偏爱频道设置页：多选频道用于"我的偏爱"tab 筛选 -->
<view class="page-preferred-settings">
  <!-- T02513 / J48 + J66：与 channels 页的说明条互为对照（两页布局几乎一致，用户分不清自己在改哪个开关）。
       J66 补的是「改完会看到什么」：偏爱不是排序，而是首页/历史频道栏里的一个筛选入口；
       两处勾选各自独立存储、不会互相同步，也必须写明。 -->
  <view class="tip-bar">
    <text class="tip-text">勾选你喜爱的频道后，首页与历史的频道栏末尾会出现「我的偏爱」，选中它只展示这些频道的节目。</text>
    <text class="tip-text">本页勾选与频道页的「订阅」互不同步：这里管筛选，那里管新节目推送提醒。</text>
    <view class="tip-link" bindtap="onGoChannels" hover-class="none">
      <text>去管理频道订阅 →</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-mask" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- J106：失败态独立成支并自带重试 -->
  <load-error
    wx:elif="{{loadError}}"
    message="{{loadError}}"
    bind:retry="onRetryLoad"
  ></load-error>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{channels.length === 0}}">
    <text>暂无可用频道</text>
  </view>

  <!-- 频道多选列表 -->
  <block wx:else>
    <view class="channel-list">
      <view
        class="card channel-item {{item.selected ? 'selected' : ''}}"
        wx:for="{{channels}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="onToggleChannel"
      >
        <view class="channel-info">
          <view class="channel-name">{{item.name}}</view>
          <view class="channel-desc">{{item.description || '精彩内容，等你来听'}}</view>
        </view>
        <!-- 勾选标记：T00384 统一改用 Tabler 图标，不再用 ✓ 字符 -->
        <view class="check-box {{item.selected ? 'checked' : ''}}">
          <image wx:if="{{item.selected}}" class="check-icon" lazy-load src="/images/icons/btn-check.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <!-- 底部操作栏：J64 ——「保存」与「暂不设置」是相反动作，必须带文字，不能只靠图标区分；
         全选/全不选同理，文案与 data.allSelected 单一判定源保持一致，数量仍作状态角标保留 -->
    <view class="bottom-bar">
      <!-- 首次引导模式显示"暂不设置"，普通入口显示全选/全不选 -->
      <view
        class="select-all-btn"
        wx:if="{{!isOnboarding}}"
        bindtap="onSelectAll"
        aria-label="{{allSelected ? '全不选' : '全选'}}"
      >
        <image class="bar-icon" lazy-load src="{{allSelected ? '/images/icons/x.png' : '/images/icons/checks.png'}}" mode="aspectFit" />
        <text class="bar-label">{{allSelected ? '全不选' : '全选'}}</text>
      </view>
      <view class="select-all-btn" wx:else bindtap="onSkip" aria-label="暂不设置">
        <image class="bar-icon" lazy-load src="/images/icons/x.png" mode="aspectFit" />
        <text class="bar-label">暂不设置</text>
      </view>
      <view
        class="save-btn {{selectedCount > 0 ? '' : 'disabled'}}"
        bindtap="onSave"
        aria-label="保存偏爱频道"
      >
        <image class="save-btn-icon" lazy-load src="/images/icons/btn-check.png" mode="aspectFit" />
        <text class="save-btn-label">{{selectedCount > 0 ? '保存（' + selectedCount + '）' : '保存'}}</text>
      </view>
    </view>
  </block>
</view>
