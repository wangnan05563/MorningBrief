<!-- 偏爱频道设置页：多选频道用于"我的偏爱"tab 筛选 -->
<view class="page-preferred-settings">
  <!-- 顶部说明 -->
  <!-- T02513 / J48：与 channels 页的说明条互为对照（两页布局几乎一致，用户分不清自己在改哪个开关）。
       这里补的是反向那半句：本页只管「我的偏爱」筛选，推送提醒住在频道页的订阅开关。 -->
  <view class="tip-bar">
    <text class="tip-text">勾选你喜爱的频道，"我的偏爱"将只展示这些频道的节目</text>
    <text class="tip-text">这里不影响新节目推送提醒，那是频道页的「订阅」开关</text>
    <view class="tip-link" bindtap="onGoChannels" hover-class="none">
      <text>去管理频道订阅 →</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-mask" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{channels.length === 0}}">
    <text>暂无可用频道</text>
  </view>

  <!-- 频道多选列表 -->
  <block wx:else>
    <view class="channel-list">
      <view
        class="card channel-item {{item.selected ? 'selected' : ''}}"
        wx:for="{{channels}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="onToggleChannel"
      >
        <view class="channel-info">
          <view class="channel-name">{{item.name}}</view>
          <view class="channel-desc">{{item.description || '精彩内容，等你来听'}}</view>
        </view>
        <!-- 勾选标记：T00384 统一改用 Tabler 图标，不再用 ✓ 字符 -->
        <view class="check-box {{item.selected ? 'checked' : ''}}">
          <image wx:if="{{item.selected}}" class="check-icon" lazy-load src="/images/icons/btn-check.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <!-- 底部操作栏：T00384 图标即按钮，去掉中文文案
         全选/全不选用 checks/x 图标区分，选中数量以角标保留 -->
    <view class="bottom-bar">
      <!-- 首次引导模式显示"暂不设置"，普通入口显示全选/全不选 -->
      <view
        class="select-all-btn"
        wx:if="{{!isOnboarding}}"
        bindtap="onSelectAll"
        aria-label="{{channels.length > 0 && channels[0].selected ? '全不选' : '全选'}}"
      >
        <image class="bar-icon" lazy-load src="{{channels.length > 0 && channels[0].selected ? '/images/icons/x.png' : '/images/icons/checks.png'}}" mode="aspectFit" />
      </view>
      <view class="select-all-btn" wx:else bindtap="onSkip" aria-label="暂不设置">
        <image class="bar-icon" lazy-load src="/images/icons/x.png" mode="aspectFit" />
      </view>
      <view
        class="save-btn {{selectedCount > 0 ? '' : 'disabled'}}"
        bindtap="onSave"
        aria-label="保存偏爱频道"
      >
        <image class="save-btn-icon" lazy-load src="/images/icons/btn-check.png" mode="aspectFit" />
        <text class="save-count" wx:if="{{selectedCount > 0}}">{{selectedCount}}</text>
      </view>
    </view>
  </block>
</view>
