.page-detail {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 节目信息卡片 */
.episode-card {
  padding: 40rpx 32rpx;
}

/* === FR-MC-11 合规提示条（与课程页对齐） ===
   不遮挡核心播放操作（位于信息卡与播放卡之间），且无关闭按钮不可误关 */
.disclaimer {
  display: flex;
  align-items: flex-start;
  margin: 0 24rpx 8rpx;
  padding: 16rpx 20rpx;
  background: #FFF7E6;
  border: 1rpx solid #FFE0A3;
  border-radius: 16rpx;
}

.disclaimer.strong {
  background: #FFEBEE;
  border-color: #FFB4A2;
}

.disclaimer-icon {
  font-size: 28rpx;
  color: #F0A020;
  margin-right: 12rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.disclaimer.strong .disclaimer-icon {
  color: #E57373;
}

.disclaimer-text {
  flex: 1;
  font-size: 24rpx;
  color: #8A6D3B;
  line-height: 1.5;
}

.disclaimer.strong .disclaimer-text {
  color: #C0392B;
}

.episode-meta {
  display: flex;
  align-items: center;
}

.episode-date {
  font-size: 24rpx;
  color: #A0AEC0;
  margin-right: 16rpx;
}

.episode-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2D3748;
  line-height: 1.4;
  margin: 20rpx 0 16rpx;
}

.episode-duration {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #7ECEC1;
}

.duration-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

/* 播放控制卡片 */
.play-card {
  padding: 36rpx 32rpx;
}

/* 播放错误提示条：蜜桃粉淡背景 + 警示色文字，柔和不刺眼 */
.play-error-tip {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: #FFF0F4;
  font-size: 24rpx;
  color: #FF6B8A;
  line-height: 1.5;
}

.error-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.play-row {
  display: flex;
  align-items: center;
}

/* 圆形播放按钮：薄荷青 */
.play-btn {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7ECEC1, #5BA89B);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(126, 206, 193, 0.45);
}

.play-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 上一首/下一首导航按钮 */
.nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0F4F2;
  flex-shrink: 0;
}

.nav-btn:active {
  background: #E6F4F1;
}

.nav-icon {
  width: 36rpx;
  height: 36rpx;
}

.play-info {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.progress {
  margin: 0;
}

.time-row {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.time {
  font-size: 24rpx;
  color: #A0AEC0;
}

/* 稿件区域 */
.script-card {
  padding: 32rpx;
}

/* === 稿件图片轮播（页面顶部卡片，自适应屏宽） === */
/* 复用全局 .card 的 24rpx 外边距 + 玻璃白底，与下方卡片对齐；
   padding:0 + overflow:hidden 让 swiper 满铺且裁切圆角 */
.carousel-card {
  position: relative;
  padding: 0;
  overflow: hidden;
}
.carousel-swiper {
  width: 100%;
  height: 360rpx;
}
.carousel-item {
  width: 100%;
  height: 360rpx;
}
.carousel-img {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #EDF2F7;
}
/* 单图加载失败占位：居中图标 + 文案，保持轮播区域高度不塌陷 */
.carousel-fallback {
  width: 100%;
  height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #EDF2F7;
}
.fallback-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 12rpx;
  opacity: 0.5;
}
.fallback-text {
  font-size: 24rpx;
  color: #A0AEC0;
}
/* 轮播计数器：右下角半透明胶囊 */
.carousel-counter {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 999rpx;
  line-height: 1.4;
}

.script-header {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 24rpx;
}

/* 稿件自动加载中的占位提示 */
.script-loading {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #A0AEC0;
}

/* 正文未展开时的入口按钮（点击后再渲染正文） */
.script-entry {
  display: flex;
  justify-content: flex-start;
  padding: 20rpx 0;
}

/* 蜜桃粉“查看文稿”按钮（复用全局 .btn-secondary 配色） */
.script-btn {
  display: inline-block;
  padding: 20rpx 56rpx;
}

.script-body {
  font-size: 28rpx;
  color: #4A5568;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 稿件分段块：每段独立卡片感，段间留白 */
.seg-block {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EDF2F7;
}
.seg-block:last-child {
  border-bottom: none;
}

/* 段封面图：宽度自适应，圆角与卡片风格一致 */
.seg-cover {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background: #F7FAFC;
}

/* 段标题：与开场白/正文段统一字号，强调时使用 */
.seg-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

/* 段正文：保留换行，行高宽松便于阅读 */
.seg-content {
  font-size: 28rpx;
  color: #4A5568;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

/* === 节目来源：标题可点击跳转原站 === */
/* 整体行布局：序号 + 标题同行，垂直对齐顶部（让多行标题与序号顶端对齐） */
.source-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F4F2;
}

.source-item:last-child {
  border-bottom: none;
}

/* 序号：固定宽度，右对齐，浅灰色，与标题行顶端对齐 */
.source-seq {
  flex-shrink: 0;
  width: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #A0AEC0;
  text-align: right;
  line-height: 1.5;
  padding-top: 2rpx;
}

/* 标题 + meta 容器：占满剩余宽度 */
.source-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.source-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  line-height: 1.5;
}

.source-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2D3748;
  line-height: 1.5;
  word-break: break-word;
}

.source-meta {
  font-size: 22rpx;
  color: #A0AEC0;
  margin-top: 4rpx;
}

/* 可点击的标题：薄荷青主色 + 下划线，明确视觉反馈 */
.source-link {
  color: #5BA89B;
  text-decoration: underline;
  flex: 1;
}

.source-link:active {
  opacity: 0.6;
}

/* 外链图标：小号淡色，与标题同行 */
.source-link-icon {
  font-size: 24rpx;
  color: #A0AEC0;
  flex-shrink: 0;
  line-height: 1;
}

/* 底部操作 */
.footer-actions {
  display: flex;
  padding: 0 24rpx;
  margin-top: 16rpx;
}

.footer-btn {
  flex: 1;
  margin: 0;
  margin-left: 24rpx;
  line-height: 1.5;
}

.footer-btn:first-child {
  margin-left: 0;
}

/* 重置小程序 button 默认描边，贴合全局按钮风格 */
.footer-btn::after {
  border: none;
}

/* === 操作按钮区：倍速 + 收藏 + 睡眠定时器 === */
.action-row {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
  gap: 16rpx;
}

/* 操作芯片：毛玻璃风格底色，激活态使用品牌粉渐变
   半透明 + backdrop-filter 让卡片背景透出，呼应全局按钮风格
   关键修复（v2）：统一字号 24rpx、padding 10/10、icon 26rpx、gap 6rpx，
   让 4 个等宽 chip 在最窄机型也能放下"已收藏"和"1时半"这类 3 字文案。
   激活态不再缩字号/缩图标，避免视觉塌陷，仅靠背景色和文字色区分状态。 */
.action-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: 1;
  min-height: 72rpx;
  height: auto;
  padding: 10rpx 10rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.55);
  color: #5BA89B;
  font-size: 24rpx;
  white-space: nowrap;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  backdrop-filter: saturate(180%) blur(16rpx);
  -webkit-backdrop-filter: saturate(180%) blur(16rpx);
  box-shadow:
    0 4rpx 12rpx rgba(126, 206, 193, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  transition: all 0.2s ease;
  overflow: hidden;
}

.action-chip.active {
  background: linear-gradient(135deg, rgba(255, 211, 224, 0.85), rgba(255, 154, 162, 0.85));
  color: #FFFFFF;
  border-color: rgba(255, 255, 255, 0.5);
  box-shadow:
    0 4rpx 12rpx rgba(255, 107, 138, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
}

/* 激活态不再缩字号/缩图标，与未激活态保持视觉一致，
   避免"已收藏"和"定时"在切换瞬间出现塌陷感。 */
.chip-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

/* 文字图标：当无 PNG 图标时用 Unicode 字符替代，与 .chip-icon 同尺寸 */
.chip-icon-text {
  font-size: 26rpx;
  line-height: 1;
  color: inherit;
  flex-shrink: 0;
}

.chip-label {
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
  line-height: 1.3;
}

/* === 任务10：背景虚化层 === */
/* 固定定位 + 高斯模糊，淡色滤镜柔化避免抢戏 */
.bg-blur-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.bg-blur-img {
  width: 100%;
  height: 100%;
  filter: blur(48rpx) saturate(1.2);
  opacity: 0.5;
  transform: scale(1.2);
}

/* 半透明白色蒙版，进一步降低对比度提升正文可读性
   默认使用马卡龙渐变（无封面图时）：薄荷→蜜桃→暖杏，让毛玻璃按钮有内容可透
   有封面图时 .bg-blur-img 通过滤镜模糊后由 mask 进一步柔化 */
.bg-blur-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    135deg,
    rgba(181, 234, 215, 0.45) 0%,
    rgba(255, 211, 224, 0.45) 45%,
    rgba(255, 218, 185, 0.4) 100%
  );
}

/* 兜底层：纯色 fallback，避免 mask 渐变在某些设备上渲染异常 */
.bg-blur-layer::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F9FDFB;
  z-index: -1;
}

/* 内容层在背景之上：所有直接子元素都提升 z-index
 * 注意 wxml 中 <block> 不渲染为 DOM，其内的 .card 仍是 .page-detail 的直接子元素 */
.page-detail > .card,
.page-detail > .loading-mask,
.page-detail > .empty-state {
  position: relative;
  z-index: 1;
}

/* === 任务8：评论区 === */
.comment-card {
  padding: 32rpx;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.comment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3748;
}

.comment-count {
  font-size: 24rpx;
  color: #A0AEC0;
}

/* 评论输入框 + 发送按钮 */
.comment-input-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #F7FAFC;
  border-radius: 16rpx;
}

.comment-input {
  flex: 1;
  min-height: 60rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #2D3748;
  background: #FFFFFF;
  border-radius: 12rpx;
}

.comment-submit {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #7ECEC1, #5BA89B);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
}

.comment-submit.disabled {
  opacity: 0.5;
}

.comment-submit:active {
  opacity: 0.85;
}

/* 评论列表 */
.comment-list {
  margin-top: 8rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EDF2F7;
}

.comment-item:last-child {
  border-bottom: none;
}

/* 头像：左列固定大小 */
.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F0F4F2;
  flex-shrink: 0;
}

/* 中间：名称 + 日期，width 自适应不被挤压 */
.comment-meta-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
  max-width: 220rpx;
  overflow: hidden;
}

.comment-user {
  font-size: 24rpx;
  color: #5BA89B;
  font-weight: 500;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.comment-date {
  font-size: 20rpx;
  color: #A0AEC0;
  white-space: nowrap;
  margin-top: 4rpx;
}

/* 右侧：评论内容 + 点赞 */
.comment-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.comment-content {
  font-size: 28rpx;
  color: #2D3748;
  line-height: 1.6;
  word-break: break-word;
}

.comment-like {
  align-self: flex-end;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: #FFF0F4;
}

.comment-like:active {
  opacity: 0.7;
}

.like-icon {
  width: 28rpx;
  height: 28rpx;
}

.like-count {
  font-size: 24rpx;
  color: #A0AEC0;
}

.like-count.liked {
  color: #FF6B8A;
  font-weight: 500;
}

.comment-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #A0AEC0;
}

.comment-loading {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #A0AEC0;
}

/* === 播放队列弹窗（页内弹出） === */
.queue-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 9998;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  transition: background 0.25s ease;
}

.queue-modal-mask.visible {
  background: rgba(0, 0, 0, 0.45);
  pointer-events: auto;
}

.queue-modal-container {
  width: 86%;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.18);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: scale(0.85) translateY(40rpx);
  opacity: 0;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.queue-modal-mask.visible .queue-modal-container {
  transform: scale(1) translateY(0);
  opacity: 1;
}

/* 弹窗头部 */
.queue-modal-header {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #F0F4F2;
  flex-shrink: 0;
}

.queue-modal-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
}

.queue-modal-count {
  font-size: 24rpx;
  color: #A0AEC0;
  margin-right: 20rpx;
}

.queue-modal-close.clear-btn {
  font-size: 26rpx;
  color: #FF6B8A;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #FFF0F4;
}

.queue-modal-close.clear-btn:active {
  opacity: 0.7;
}

/* 空状态 */
.queue-modal-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.queue-modal-empty .empty-icon-img {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.4;
}

.queue-modal-empty text {
  font-size: 28rpx;
  color: #CBD5E0;
}

/* 队列列表 */
.queue-modal-list {
  flex: 1;
  max-height: 60vh;
  padding: 0 24rpx;
  overflow-y: auto;
}

.queue-modal-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  transition: background 0.15s ease;
}

.queue-modal-item.current {
  background: linear-gradient(135deg, #F0F4F2, #FFF5F7);
}

.queue-modal-item:active {
  opacity: 0.7;
}

.qm-item-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F0F4F2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.qm-playing-icon {
  width: 24rpx;
  height: 24rpx;
}

.qm-item-index text {
  font-size: 24rpx;
  color: #A0AEC0;
  font-weight: 500;
}

.qm-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.qm-item-title {
  font-size: 28rpx;
  color: #2D3748;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qm-item-date {
  font-size: 22rpx;
  color: #CBD5E0;
}

/* 防止点击弹窗内部时冒泡到遮罩层关闭 */
