.page-detail {
  min-height: 100vh;
  padding-bottom: 60rpx;
  /* ===== T00724 网易云风格深色舞台：重定义变量即整页翻转（所有组件走 var） ===== */
  --text-primary: #f3f4f6;
  --text-secondary: #d1d5db;
  --text-muted: #9ca3af;
  --text-inverse: #0f172a;
  --bg-subtle: rgba(255, 255, 255, 0.08);
  --bg-card: rgba(30, 41, 59, 0.78);
  --bg-page: transparent;
  --border: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(255, 255, 255, 0.16);
  --accent: #8fb8dd;
  --accent-light: #b9d4ea;
  --accent-soft: rgba(143, 184, 221, 0.16);
  --warning-soft: rgba(245, 158, 11, 0.14);
  --danger-soft: rgba(239, 68, 68, 0.14);
  --shadow-card: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
  --shadow-raised: 0 12rpx 32rpx rgba(0, 0, 0, 0.45);
  background: linear-gradient(180deg, #0f172a 0%, #1e293b 45%, #0f172a 100%);
}
/* 卡片深色表面（app.wxss 的 .card 用固定白底，需页内覆盖） */
.page-detail .card {
  background: rgba(30, 41, 59, 0.78);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}
/* 深色舞台下遮罩加深，弱化虚化图抢戏 */
.page-detail .bg-blur-mask {
  background: rgba(15, 23, 42, 0.7);
}
/* T00725 高亮在深底上的适配 */
.page-detail .seg-block.seg-active {
  background-color: rgba(143, 184, 221, 0.16);
  box-shadow: inset 6rpx 0 0 0 #8fb8dd;
}
.page-detail .seg-hover {
  background-color: rgba(143, 184, 221, 0.1);
}

/* ===== T00724 模块一：放大式播放框（封面轮播 = 视觉中心的圆角卡片） ===== */
.page-detail .carousel-card {
  position: relative;
  margin: 24rpx 32rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.5);
}
.page-detail .carousel-swiper {
  height: 520rpx;
}

/* ===== T00724 模块二：顶部流光动画（播放框上边缘的柔和光带，左右往复） ===== */
.light-sweep {
  position: absolute;
  top: 0;
  left: -40%;
  width: 40%;
  height: 8rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(143, 184, 221, 0.35) 35%,
    rgba(255, 255, 255, 0.85) 50%,
    rgba(143, 184, 221, 0.35) 65%,
    rgba(255, 255, 255, 0) 100%
  );
  filter: blur(2rpx);
  animation: light-sweep 3.2s ease-in-out infinite;
  pointer-events: none;
  z-index: 3;
}
@keyframes light-sweep {
  0% { left: -40%; opacity: 0; }
  15% { opacity: 1; }
  85% { opacity: 1; }
  100% { left: 100%; opacity: 0; }
}

/* ===== T00724 模块三：歌词同步——当前行发光，其余行半透明 ===== */
.page-detail .seg-block {
  opacity: 0.5;
  transition: opacity 0.3s ease, background-color 0.3s ease;
}
.page-detail .seg-block.seg-active {
  opacity: 1;
}
.page-detail .seg-block.seg-active .seg-title {
  color: #ffffff;
  text-shadow: 0 0 16rpx rgba(143, 184, 221, 0.75);
}
.page-detail .seg-block.seg-active .seg-content {
  color: #f3f4f6;
  text-shadow: 0 0 12rpx rgba(143, 184, 221, 0.45);
}

/* 节目信息卡片 */
.episode-card {
  padding: 40rpx 32rpx;
}

/* === FR-MC-11 合规提示条（与课程页对齐） ===
   不遮挡核心播放操作（位于信息卡与播放卡之间），且无关闭按钮不可误关 */
.disclaimer {
  display: flex;
  align-items: flex-start;
  margin: 0 24rpx 8rpx;
  padding: 16rpx 20rpx;
  background: var(--warning-soft);
  border: 1rpx solid var(--warning-soft);
  border-radius: 16rpx;
}

.disclaimer.strong {
  background: var(--danger-soft);
  border-color: var(--danger);
}

.disclaimer-icon {
  font-size: 28rpx;
  color: var(--warning);
  margin-right: 12rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.disclaimer.strong .disclaimer-icon {
  color: var(--danger);
}

.disclaimer-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--warning);
  line-height: 1.5;
}

.disclaimer.strong .disclaimer-text {
  color: var(--danger);
}

.episode-meta {
  display: flex;
  align-items: center;
}

.episode-date {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-right: 16rpx;
}

.episode-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  margin: 20rpx 0 16rpx;
}

.episode-duration {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--accent-light);
}

.duration-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

/* 播放控制卡片 */
.play-card {
  padding: 36rpx 32rpx;
}

/* 播放错误提示条：蜜桃粉淡背景 + 警示色文字，柔和不刺眼 */
.play-error-tip {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: var(--accent-soft);
  font-size: 24rpx;
  color: var(--accent);
  line-height: 1.5;
}

.error-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.play-row {
  display: flex;
  align-items: center;
}

/* 圆形播放按钮：薄荷青 */
.play-btn {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(63, 108, 143, 0.45);
}

.play-icon {
  width: 44rpx;
  height: 44rpx;
}

/* T00722：播放进度环——conic-gradient 随播放进度由空心渐实（角度在 wxml 内联计算） */
.progress-ring {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-hole {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 上一首/下一首导航按钮 */
.nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-subtle);
  flex-shrink: 0;
}

.nav-btn:active {
  background: var(--accent-soft);
}

.nav-icon {
  width: 36rpx;
  height: 36rpx;
}

.play-info {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.progress {
  margin: 0;
}

.time-row {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.time {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 稿件区域 */
.script-card {
  padding: 32rpx;
}

/* === 稿件图片轮播（页面顶部卡片，自适应屏宽） === */
/* 复用全局 .card 的 24rpx 外边距 + 玻璃白底，与下方卡片对齐；
   padding:0 + overflow:hidden 让 swiper 满铺且裁切圆角 */
.carousel-card {
  position: relative;
  padding: 0;
  overflow: hidden;
}
.carousel-swiper {
  width: 100%;
  height: 360rpx;
}
.carousel-item {
  width: 100%;
  height: 360rpx;
}
.carousel-img {
  width: 100%;
  height: 360rpx;
  display: block;
  background: var(--bg-subtle);
}
/* 单图加载失败占位：居中图标 + 文案，保持轮播区域高度不塌陷 */
.carousel-fallback {
  width: 100%;
  height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-subtle);
}
.fallback-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 12rpx;
  opacity: 0.5;
}
.fallback-text {
  font-size: 24rpx;
  color: var(--text-muted);
}
/* 轮播计数器：右下角半透明胶囊 */
.carousel-counter {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: var(--text-inverse);
  background: rgba(0, 0, 0, 0.45);
  border-radius: 999rpx;
  line-height: 1.4;
}

.script-header {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* 稿件自动加载中的占位提示 */
.script-loading {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 正文未展开时的入口按钮（点击后再渲染正文） */
.script-entry {
  display: flex;
  justify-content: flex-start;
  padding: 20rpx 0;
}

/* "查看完整文稿"入口：T00384 改为图标按钮（方形触控区 88rpx） */
.script-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
}

.script-body {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 稿件分段块：每段独立卡片感，段间留白 */
.seg-block {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--bg-subtle);
  /* T00725：点击定位/播放联动的高亮过渡 */
  transition: background-color 0.3s ease;
}
/* 当前播放段落高亮：左侧强调条 + 浅色底 */
.seg-block.seg-active {
  background-color: rgba(63, 108, 143, 0.08);
  box-shadow: inset 6rpx 0 0 0 var(--primary-color, #3f6c8f);
  border-radius: 8rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
}
.seg-hover {
  background-color: rgba(63, 108, 143, 0.05);
}
.seg-block:last-child {
  border-bottom: none;
}

/* 段封面图：宽度自适应，圆角与卡片风格一致 */
.seg-cover {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background: var(--bg-subtle);
}

/* 段标题：与开场白/正文段统一字号，强调时使用 */
.seg-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  line-height: 1.5;
}

/* 段正文：保留换行，行高宽松便于阅读 */
.seg-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

/* === 节目来源：标题可点击跳转原站 === */
/* 整体行布局：序号 + 标题同行，垂直对齐顶部（让多行标题与序号顶端对齐） */
.source-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg-subtle);
}

.source-item:last-child {
  border-bottom: none;
}

/* 序号：固定宽度，右对齐，浅灰色，与标题行顶端对齐 */
.source-seq {
  flex-shrink: 0;
  width: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-muted);
  text-align: right;
  line-height: 1.5;
  padding-top: 2rpx;
}

/* 标题 + meta 容器：占满剩余宽度 */
.source-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.source-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  line-height: 1.5;
}

.source-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  word-break: break-word;
}

.source-meta {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

/* 可点击的标题：薄荷青主色 + 下划线，明确视觉反馈 */
.source-link {
  color: var(--accent);
  text-decoration: underline;
  flex: 1;
}

.source-link:active {
  opacity: 0.6;
}

/* 外链图标：小号淡色，与标题同行 */
.source-link-icon {
  font-size: 24rpx;
  color: var(--text-muted);
  flex-shrink: 0;
  line-height: 1;
}

/* 底部操作 */
.footer-actions {
  display: flex;
  padding: 0 24rpx;
  margin-top: 16rpx;
}

/* T00384：图标即按钮，触控区抬到 100rpx，图标居中放大 */
.footer-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  margin-left: 24rpx;
  min-height: 100rpx;
  line-height: 1;
  padding: 0;
}

.footer-btn:first-child {
  margin-left: 0;
}

/* 重置小程序 button 默认描边，贴合全局按钮风格 */
.footer-btn::after {
  border: none;
}

/* === 操作按钮区：倍速 + 收藏 + 列表 + 睡眠定时器 ===
   T00384（商务浅白）：
   - 去掉毛玻璃（backdrop-filter）与半透明白，改实色白底 + 浅描边
   - 图标即按钮：触控区抬到 88rpx（微信建议最小值），图标放大到 36rpx
   - 4 个 chip 等宽，仅保留「倍速值」「睡眠倒计时」两处动态状态文字 */
.action-row {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
  gap: 16rpx;
}

.action-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: 1;
  min-height: 88rpx;
  padding: 12rpx 10rpx;
  border-radius: var(--radius-btn);
  background: var(--bg-card);
  color: var(--accent);
  font-size: 24rpx;
  white-space: nowrap;
  border: 2rpx solid var(--border);
  box-shadow: var(--shadow-card);
  transition: all 0.2s ease;
  overflow: hidden;
}

.action-chip:active {
  background: var(--bg-subtle);
}

.action-chip.active {
  background: var(--accent);
  color: var(--text-inverse);
  border-color: var(--accent);
  box-shadow: var(--shadow-raised);
}

.chip-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

/* 激活态图标（T00579）：
   `.action-chip.active` 背景是 var(--accent)（#3F6C8F 商务蓝），而 images/icons/ 下的彩色图标
   非透明像素恰好也是同一抹蓝 → 「蓝图标放蓝底」导致已收藏 / 睡眠激活时图标无法辨识。
   修复：激活态改用 **白色变体**（favorite-filled-white.png / alarm-white.png，非透明像素染成
   var(--text-inverse) 的 #FFFFFF，alpha 抗锯齿边缘原样保留），未激活态仍用彩色图标（白底上对比充足）。
   注意：新增激活态图标时必须提供 -white 变体，不要依赖「图标配色碰巧可用」。 */

/* 倍速数值：非文案，保留数字展示（如 1.0x / 1.5x） */
.chip-rate {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  color: inherit;
}

/* 睡眠定时器剩余时长：动态状态而非按钮文案，保留极小号角标 */
.chip-status {
  font-size: 20rpx;
  line-height: 1;
  color: inherit;
  white-space: nowrap;
  flex-shrink: 0;
}

/* T00387：下载中状态 —— 虚线描边弱化态，与"未下载/已下载"实底区分，百分比即进度 */
.action-chip.downloading {
  background: var(--bg-card);
  border-color: var(--accent-light);
  border-style: dashed;
  color: var(--accent);
}

/* === 任务10：背景虚化层 === */
/* 固定定位 + 高斯模糊，淡色滤镜柔化避免抢戏 */
.bg-blur-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.bg-blur-img {
  width: 100%;
  height: 100%;
  filter: blur(48rpx) saturate(1.2);
  opacity: 0.5;
  transform: scale(1.2);
}

/* 半透明白色蒙版，进一步降低对比度提升正文可读性
   默认使用马卡龙渐变（无封面图时）：薄荷→蜜桃→暖杏，让毛玻璃按钮有内容可透
   有封面图时 .bg-blur-img 通过滤镜模糊后由 mask 进一步柔化 */
.bg-blur-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* 商务浅白主题：装饰性背景改为极轻的中性色，仅为封面模糊图提供低对比度垫底 */
  background: linear-gradient(
    180deg,
    rgba(247, 248, 250, 0.86) 0%,
    rgba(247, 248, 250, 0.96) 60%,
    var(--bg-page) 100%
  );
}

/* 兜底层：纯色 fallback，避免 mask 渐变在某些设备上渲染异常 */
.bg-blur-layer::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-page);
  z-index: -1;
}

/* 内容层在背景之上：所有直接子元素都提升 z-index
 * 注意 wxml 中 <block> 不渲染为 DOM，其内的 .card 仍是 .page-detail 的直接子元素 */
.page-detail > .card,
.page-detail > .loading-mask,
.page-detail > .empty-state {
  position: relative;
  z-index: 1;
}

/* === 任务8：评论区 === */
.comment-card {
  padding: 32rpx;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.comment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.comment-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 评论输入框 + 发送按钮 */
.comment-input-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: var(--bg-subtle);
  border-radius: 16rpx;
}

.comment-input {
  flex: 1;
  min-height: 60rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-primary);
  background: var(--bg-card);
  border-radius: 12rpx;
}

.comment-submit {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  border-radius: var(--radius-btn);
  background: var(--accent);
  color: var(--text-inverse);
}

.comment-submit-icon {
  width: 40rpx;
  height: 40rpx;
}

.comment-submit.disabled {
  opacity: 0.5;
}

.comment-submit:active {
  opacity: 0.85;
}

/* 评论列表 */
.comment-list {
  margin-top: 8rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--bg-subtle);
}

.comment-item:last-child {
  border-bottom: none;
}

/* 头像：左列固定大小 */
.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--bg-subtle);
  flex-shrink: 0;
}

/* 中间：名称 + 日期，width 自适应不被挤压 */
.comment-meta-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
  max-width: 220rpx;
  overflow: hidden;
}

.comment-user {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 500;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.comment-date {
  font-size: 20rpx;
  color: var(--text-muted);
  white-space: nowrap;
  margin-top: 4rpx;
}

/* 右侧：评论内容 + 点赞 */
.comment-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.comment-content {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  word-break: break-word;
}

.comment-like {
  align-self: flex-end;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: var(--accent-soft);
}

.comment-like:active {
  opacity: 0.7;
}

.like-icon {
  width: 28rpx;
  height: 28rpx;
}

.like-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

.like-count.liked {
  color: var(--accent);
  font-weight: 500;
}

.comment-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

.comment-loading {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* === 播放队列弹窗（页内弹出） === */
.queue-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 9998;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  transition: background 0.25s ease;
}

.queue-modal-mask.visible {
  background: rgba(0, 0, 0, 0.45);
  pointer-events: auto;
}

.queue-modal-container {
  width: 86%;
  max-height: 70vh;
  background: var(--bg-card);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.18);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: scale(0.85) translateY(40rpx);
  opacity: 0;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.queue-modal-mask.visible .queue-modal-container {
  transform: scale(1) translateY(0);
  opacity: 1;
}

/* 弹窗头部 */
.queue-modal-header {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--bg-subtle);
  flex-shrink: 0;
}

.queue-modal-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.queue-modal-count {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-right: 20rpx;
}

.queue-modal-close.clear-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  border-radius: var(--radius-btn);
  background: var(--danger-soft);
}

.clear-btn-icon {
  width: 40rpx;
  height: 40rpx;
}

.queue-modal-close.clear-btn:active {
  opacity: 0.7;
}

/* 空状态 */
.queue-modal-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.queue-modal-empty .empty-icon-img {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.4;
}

.queue-modal-empty text {
  font-size: 28rpx;
  color: var(--border-strong);
}

/* 队列列表 */
.queue-modal-list {
  flex: 1;
  max-height: 60vh;
  padding: 0 24rpx;
  overflow-y: auto;
}

.queue-modal-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: var(--bg-card);
  transition: background 0.15s ease;
}

.queue-modal-item.current {
  background: var(--bg-subtle);
}

.queue-modal-item:active {
  opacity: 0.7;
}

.qm-item-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.qm-playing-icon {
  width: 24rpx;
  height: 24rpx;
}

.qm-item-index text {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 500;
}

.qm-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.qm-item-title {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qm-item-date {
  font-size: 22rpx;
  color: var(--border-strong);
}

/* 防止点击弹窗内部时冒泡到遮罩层关闭 */
