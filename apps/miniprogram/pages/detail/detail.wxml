<!-- 节目详情：信息卡片 + 播放控制 + 稿件懒加载 -->
<view class="page-detail">
  <!-- 任务10：背景虚化层，取自 segments 第一张封面图，淡色滤镜柔化避免抢戏 -->
  <view class="bg-blur-layer">
  <image class="bg-blur-img" lazy-load src="{{bgCoverUrl}}" mode="aspectFill" wx:if="{{bgCoverUrl}}" />
  <view class="bg-blur-mask"></view>
</view>

  <!-- 详情加载中 -->
  <view class="loading-mask" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 详情加载失败 -->
  <view class="empty-state" wx:elif="{{error}}">
    <image class="empty-icon-img" lazy-load src="/images/icons/alert.png" mode="aspectFit" />
    <text>{{error}}</text>
  </view>

  <block wx:else>
    <!-- 顶部稿件图片轮播：进页自动从文稿解析，按出现顺序；自动播放 + 手动切换 + 加载失败占位 -->
    <!-- T00753：分享/首页移至页面右上角，简化图标水平并列（无边框） -->
    <view class="page-top-actions">
      <button
        class="top-action"
        open-type="share"
        hover-class="none"
        aria-label="分享节目"
      >
        <image class="top-action-icon" src="/images/icons/btn-share-mint.png" mode="aspectFit" />
      </button>
      <view class="top-action" bindtap="onBackHome" aria-label="返回首页">
        <image class="top-action-icon" src="/images/icons/btn-home-mint.png" mode="aspectFit" />
      </view>
    </view>

    <view class="card carousel-card" wx:if="{{carouselImages.length > 0}}">
      <!-- T00724：顶部流光动画——柔和光带沿播放框上边缘往复扫过 -->
      <view class="light-sweep" aria-hidden="true"></view>
      <swiper
        class="carousel-swiper"
        style="height:{{carouselHeight}}rpx"
        indicator-dots="{{carouselImages.length > 1}}"
        indicator-color="rgba(255,255,255,0.5)"
        indicator-active-color="#3F6C8F"
        autoplay="{{true}}"
        interval="{{carouselInterval}}"
        duration="{{carouselDuration}}"
        circular="{{true}}"
        bindchange="onCarouselChange"
      >
        <swiper-item
          class="carousel-item"
          wx:for="{{carouselImages}}"
          wx:key="url"
        >
          <image
            wx:if="{{!item.failed}}"
            class="carousel-img"
            style="height:{{carouselHeight}}rpx"
            src="{{item.url}}"
            mode="aspectFit"
            lazy-load
            data-index="{{index}}"
            bindload="onCarouselImageLoad"
            binderror="onCarouselImageError"
            bindtap="onPreviewCarouselImage"
          />
          <view wx:else class="carousel-fallback" style="height:{{carouselHeight}}rpx">
            <image class="fallback-icon" src="/images/icons/alert.png" mode="aspectFit" />
            <text class="fallback-text">图片加载失败</text>
          </view>
        </swiper-item>
      </swiper>
      <view class="carousel-counter" wx:if="{{carouselImages.length > 1}}">{{carouselIndex + 1}}/{{carouselImages.length}}</view>
    </view>

    <!-- 节目信息卡片 -->
    <view class="card episode-card">
      <view class="episode-meta">
        <text class="episode-date">{{episode.date}}</text>
        <text class="tag tag-pink" wx:if="{{episode.categories}}">{{episode.categories[0]}}</text>
      </view>
      <view class="episode-title">{{episode.title}}</view>
      <view class="episode-duration">
        <image class="duration-icon" lazy-load src="/images/icons/duration.png" mode="aspectFit" />
        <text>时长 {{durationLabel}}</text>
      </view>
    </view>

    <!-- 合规提示（FR-MC-11）：disclaimer_level != none 时展示，不遮挡播放操作且不可误关 -->
    <view class="disclaimer {{disclaimerLevel === 'strong' ? 'strong' : ''}}" wx:if="{{disclaimerText}}">
      <text class="disclaimer-icon">ⓘ</text>
      <text class="disclaimer-text">{{disclaimerText}}</text>
    </view>

    <!-- 播放控制卡片 -->
    <view class="card play-card">
      <!-- 播放错误提示：音频丢失/不可访问时持久显示，避免 toast 消失后用户不知道原因 -->
      <view class="play-error-tip" wx:if="{{playError}}">
        <image class="error-icon" lazy-load src="/images/icons/alert.png" mode="aspectFit" />
        <text>{{playError}}</text>
      </view>
      <view class="play-row">
        <!-- 上一首按钮（队列未设置时隐藏） -->
        <view class="nav-btn" wx:if="{{hasPrev}}" bindtap="onPrev">
          <image class="nav-icon" lazy-load src="/images/icons/skip-back.png" mode="aspectFit" />
        </view>
        <view class="play-btn" bindtap="onTogglePlay">
          <!-- T00722：进度环——边缘随播放进度由空心渐实（conic-gradient，无需 JS 计算） -->
          <view
            class="progress-ring"
            style="background: conic-gradient(#FFFFFF {{duration > 0 ? (currentTime / duration) * 360 : 0}}deg, rgba(255, 255, 255, 0.28) 0deg)"
          >
            <view class="ring-hole">
              <image class="play-icon" lazy-load src="{{isPlaying ? '/images/icons/pause.png' : '/images/icons/play.png'}}" mode="aspectFit" />
            </view>
          </view>
        </view>
        <!-- 下一首按钮 -->
        <view class="nav-btn" wx:if="{{hasNext}}" bindtap="onNext">
          <image class="nav-icon" lazy-load src="/images/icons/skip-forward.png" mode="aspectFit" />
        </view>
        <view class="play-info">
          <slider
            class="progress"
            min="0"
            max="{{duration || 0}}"
            value="{{currentTime}}"
            activeColor="#3F6C8F"
            backgroundColor="#EDF3F7"
            block-size="22"
            block-color="#3F6C8F"
            bindinput="onSeekInput"
            bindchange="onSeek"
          />
          <view class="time-row">
            <text class="time">{{currentTimeText}}</text>
            <text class="time">{{durationText}}</text>
          </view>
        </view>
      </view>

      <!-- 操作按钮区：倍速 + 收藏 + 列表 + 下载 + 睡眠定时器
           T00384：移除中文按钮文案，图标即按钮；仅保留倍速值与睡眠倒计时这类动态状态
           T00387：下载按钮位于列表图标右侧，下载中显示进度/再次点击取消 -->
      <view class="action-row">
        <view class="action-chip" bindtap="onCycleRate" aria-label="切换播放倍速">
          <text class="chip-rate">{{currentRate}}x</text>
        </view>
        <view
          class="action-chip {{favorited ? 'active' : ''}}"
          bindtap="onToggleFavorite"
          aria-label="{{favorited ? '取消收藏' : '收藏'}}"
        >
          <image class="chip-icon" lazy-load src="{{favorited ? '/images/icons/favorite-filled-white.png' : '/images/icons/favorite.png'}}" mode="aspectFit" />
        </view>
        <view class="action-chip" bindtap="onOpenQueue" aria-label="打开播放队列">
          <image class="chip-icon" lazy-load src="/images/icons/list.png" mode="aspectFit" />
        </view>
        <!-- T00753：完整文稿（位于下载之前），与其他按钮同一行；T00753 反馈：点击切换显示/收起 -->
        <view
          class="action-chip {{scriptVisible ? 'active' : ''}}"
          bindtap="onShowScript"
          aria-label="{{scriptVisible ? '收起完整文稿' : '查看完整文稿'}}"
        >
          <image class="chip-icon" lazy-load src="/images/icons/btn-script-mint.png" mode="aspectFit" />
        </view>
        <!-- 下载（T00387）：空闲→download / 已下载→download-done / 下载中→百分比（点按取消） -->
        <view
          class="action-chip {{downloadState === 'downloading' ? 'downloading' : ''}}"
          bindtap="{{downloadState === 'downloading' ? 'onDownloadCancel' : 'onDownloadTap'}}"
          aria-label="{{downloadState === 'downloading' ? '取消下载' : (isDownloaded ? '已下载，点击导出' : '下载到本地')}}"
        >
          <image
            wx:if="{{downloadState !== 'downloading'}}"
            class="chip-icon"
            lazy-load
            src="{{isDownloaded ? '/images/icons/download-done.png' : '/images/icons/download.png'}}"
            mode="aspectFit"
          />
          <text class="chip-status" wx:else>{{downloadState === 'saving' ? '···' : downloadProgress + '%'}}</text>
        </view>
        <view
          class="action-chip {{sleepActive ? 'active' : ''}}"
          bindtap="onSleepTimer"
          aria-label="睡眠定时器"
        >
          <image class="chip-icon" lazy-load src="{{sleepActive ? '/images/icons/alarm-white.png' : '/images/icons/moon.png'}}" mode="aspectFit" />
          <text class="chip-status" wx:if="{{sleepActive}}">{{sleepLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 稿件区域：T00753 反馈——默认整栏隐藏，点操作行「完整文稿」按钮才显示（再点收起）
         进页仍自动拉取稿件（仅喂顶部轮播），正文在显示时按需填充 -->
    <view class="card script-card" wx:if="{{scriptVisible}}">
      <view class="script-header">完整文稿</view>

      <!-- 稿件加载中（进页自动拉取或用户点击展开时） -->
      <view class="script-loading" wx:if="{{scriptLoading}}">
        <text>文稿加载中...</text>
      </view>

      <!-- 正文已展开：优先按段渲染（含封面图），无 segments 时降级为纯文本 -->
      <block wx:elif="{{scriptLoaded}}">
        <block wx:if="{{segments.length > 0}}">
          <!-- T00725：点击段落定位播放进度并高亮；播放中自动高亮当前段（不滚动，避免打扰阅读） -->
          <view
            class="seg-block {{currentSegmentIndex === index ? 'seg-active' : ''}}"
            id="seg-{{index}}"
            data-index="{{index}}"
            hover-class="seg-hover"
            bindtap="onSegmentTap"
            wx:for="{{segments}}"
            wx:key="seq"
          >
            <!-- 封面图：原站防盗链/删图时 onCoverError 自然降级隐藏 -->
            <image
              wx:if="{{item.cover_url}}"
              class="seg-cover"
              src="{{item.cover_url}}"
              mode="widthFix"
              lazy-load
              data-seq="{{item.seq}}"
              binderror="onCoverError"
            />
            <view class="seg-title" wx:if="{{item.title}}">{{item.title}}</view>
            <view class="seg-content">{{item.content}}</view>
          </view>
        </block>
        <view class="script-body" wx:else>{{script}}</view>
      </block>

    </view>

    <!-- 节目来源（版权溯源，仅稿件加载后展示） -->
    <view class="card sources-card" wx:if="{{scriptVisible && scriptLoaded && sources.length > 0}}">
      <view class="script-header">节目来源</view>
      <view class="sources-list">
        <view class="source-item" wx:for="{{sources}}" wx:key="seq">
          <text class="source-seq">{{item.seq}}</text>
          <view class="source-info">
            <!-- 标题可点击复制链接：有 url 时显示链接样式 + 外链图标提示 -->
            <view
              class="source-title-row"
              wx:if="{{item.url}}"
              bindtap="onTapSource"
              data-url="{{item.url}}"
            >
              <text class="source-title source-link">{{item.title || '查看原文'}}</text>
              <text class="source-link-icon">↗</text>
            </view>
            <text class="source-title" wx:else>{{item.title}}</text>
            <text class="source-meta">{{item.source}} · {{item.category}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 任务8：评论区 -->
    <view class="card comment-card">
      <view class="comment-header">
        <text class="comment-title">听众评论</text>
        <text class="comment-count">{{commentsTotal}} 条</text>
      </view>

      <!-- 评论输入框 -->
      <view class="comment-input-row">
        <textarea
          class="comment-input"
          placeholder="说说你对这期节目的看法..."
          value="{{commentText}}"
          bindinput="onInputComment"
          maxlength="200"
          auto-height
        />
        <!-- T00384：发送按钮改为图标即按钮，去掉"发送/发送中"文案 -->
        <view
          class="comment-submit {{postingComment ? 'disabled' : ''}}"
          bindtap="onPostComment"
          aria-label="{{postingComment ? '发送中' : '发送评论'}}"
        >
        </view>
      </view>

      <!-- 评论列表 -->
      <view class="comment-list" wx:if="{{comments.length > 0}}">
        <view class="comment-item" wx:for="{{comments}}" wx:key="id">
          <!-- 头像 -->
          <image
            class="comment-avatar"
            lazy-load
            src="{{item.user_avatar || '/images/icons/avatar-default.jpg'}}"
            mode="aspectFill"
            data-url="{{item.user_avatar}}"
            bindtap="onPreviewAvatar"
          />
          <!-- 中间：名称 + 日期（不再被头像挤压） -->
          <view class="comment-meta-col">
            <text class="comment-user">{{item.user_name || '匿名听众'}}</text>
            <text class="comment-date" wx:if="{{item.created_at}}">{{item.created_at}}</text>
          </view>
          <!-- 右侧：评论内容 + 点赞 -->
          <view class="comment-body">
            <text class="comment-content">{{item.content}}</text>
            <view class="comment-like" data-id="{{item.id}}" data-index="{{index}}" bindtap="onLikeComment">
              <image
                class="like-icon"
                lazy-load
                src="{{item.liked ? '/images/icons/favorite-filled.png' : '/images/icons/favorite.png'}}"
                mode="aspectFit"
              />
              <text class="like-count {{item.liked ? 'liked' : ''}}">{{item.like_count || 0}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 空评论 -->
      <view class="comment-empty" wx:elif="{{!commentLoading}}">
        <text>还没有评论，快来抢沙发吧～</text>
      </view>
      <view class="comment-loading" wx:if="{{commentLoading}}">
        <text>评论加载中...</text>
      </view>
    </view>

<!-- 播放队列弹窗 -->
<view class="queue-modal-mask {{showQueueModal ? 'visible' : ''}}" bindtap="onCloseQueueModal" catchtouchmove="preventTouchMove">
  <view class="queue-modal-container" catchtap="stopPropagation">
    <!-- 弹窗头部 -->
    <view class="queue-modal-header">
      <text class="queue-modal-title">播放队列</text>
      <text class="queue-modal-count">{{queue.length}} 首</text>
      <view class="queue-modal-close clear-btn" bindtap="onClearQueue" wx:if="{{queue.length > 0}}" aria-label="清空播放队列">
        <image class="clear-btn-icon" lazy-load src="/images/icons/trash.png" mode="aspectFit" />
      </view>
    </view>

    <!-- 空状态 -->
    <view class="queue-modal-empty" wx:if="{{queue.length === 0}}">
      <image class="empty-icon-img" lazy-load src="/images/icons/music.png" mode="aspectFit" />
      <text>队列为空</text>
    </view>

    <!-- 队列列表 -->
    <scroll-view scroll-y class="queue-modal-list" wx:else>
      <view
        class="queue-modal-item {{index === currentIndex ? 'current' : ''}}"
        wx:for="{{queue}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="onQueueItemClick"
      >
        <view class="qm-item-index">
          <image wx:if="{{index === currentIndex}}" class="qm-playing-icon" lazy-load src="/images/icons/play-mini-accent.png" mode="aspectFit" />
          <text wx:else>{{index + 1}}</text>
        </view>
        <view class="qm-item-info">
          <text class="qm-item-title">{{item.title}}</text>
          <text class="qm-item-date">{{item.date}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

    <!-- T00753：分享/首页已上移至页面右上角 -->
  </block>
</view>

<!-- T00618：隐私授权弹窗（复制来源链接属剪贴板隐私接口，授权须经官方按钮） -->
<privacy-modal />
