.page-profile {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 未登录态 */
.login-wrap {
  padding-top: 80rpx;
}

.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.login-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.login-tip {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-bottom: 48rpx;
}

/* T00384：图标即按钮，方形触控区 */
.login-btn {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
}

/* 用户信息卡片：T00430 头像区背景图（AI 生成商务蓝声波主题）
   var(--accent) 实底作为图片加载前/失败时的兜底色 */
.user-card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 80rpx;
  background: var(--accent);
  border-radius: 0 0 48rpx 48rpx;
}

/* 背景图层：铺满头部，aspectFill 裁切适配 */
.user-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 底部压暗层：功能性 scrim，保证昵称白字落在声波亮条上仍可读 */
.user-card-scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 45%;
  background: linear-gradient(to top, rgba(31, 48, 64, 0.55), rgba(31, 48, 64, 0));
}

.avatar {
  position: relative;
  z-index: 1;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid var(--bg-card);
  background: var(--bg-card);
}

.nickname {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-inverse);
  text-shadow: 0 1rpx 6rpx rgba(31, 48, 64, 0.45);
}

/* 收听统计 */
.stat-card {
  display: flex;
  align-items: center;
  padding: 40rpx 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent);
}

.stat-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--accent-soft);
}

/* 设置列表 */
.list-card {
  padding: 0 32rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 2rpx solid var(--bg-subtle);
}

.list-item:last-child {
  border-bottom: none;
}

.list-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.logout-text {
  color: var(--accent);
}

.list-extra {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 列表项右箭头：PNG 图标，弱化色 */
.list-arrow {
  width: 32rpx;
  height: 32rpx;
}

/* "完善资料"提示：资料缺失时显示在昵称下方，引导用户主动设置头像昵称 */
.edit-profile-tip {
  margin-top: 16rpx;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.85);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(63, 108, 143, 0.2);
  transition: all 0.2s ease;
}

.edit-profile-tip:active {
  background: rgba(255, 255, 255, 1);
  transform: scale(0.96);
}

/* "随时编辑资料" 入口：与列表风格一致 */
.edit-anytime {
  padding: 0 32rpx;
}

.edit-anytime-row {
  padding: 32rpx 0;
}

/* 完善资料弹窗：遮罩 + 居中卡片 */
.edit-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(31, 39, 51, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.edit-modal {
  width: 600rpx;
  background: var(--bg-card);
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}

.edit-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 32rpx;
}

/* 头像选择按钮：覆盖 button 默认样式 */
.edit-avatar-btn {
  width: 200rpx;
  height: 200rpx;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50% !important;
  background: transparent !important;
  border: none !important;
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: visible;
}

.edit-avatar-btn::after {
  border: none !important;
}

.edit-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--bg-subtle);
  border: 4rpx solid var(--accent-light);
}

.edit-avatar-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--accent);
  text-align: center;
}

/* 昵称输入行 */
.edit-nickname-row {
  width: 100%;
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-subtle);
  border-radius: 16rpx;
}

.edit-nickname-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  margin-right: 16rpx;
}

.edit-nickname-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  background: transparent;
}

/* 操作按钮组 */
.edit-actions {
  width: 100%;
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

/* T00384：图标即按钮，两个等宽方形触控区 */
.edit-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0;
  border-radius: 16rpx;
  transition: all 0.15s ease;
}

.edit-btn:active {
  transform: scale(0.97);
}

.edit-btn-cancel {
  background: var(--bg-subtle);
  /* T00753 全局统一：按钮无边框 */
}

.edit-btn-confirm {
  background: var(--accent);
  box-shadow: 0 4rpx 12rpx rgba(63, 108, 143, 0.3);
}

/* 两个按钮内的图标 PNG 已按底色烘焙好颜色：
   btn-x-mint.png = 商务蓝（浅底），btn-check.png = 白色（深底），无需再叠 filter */
.edit-btn .btn-icon {
  margin-right: 0;
  width: 44rpx;
  height: 44rpx;
}

/* 我的课程（FR-MC-05）：已订阅课程/有声读物 + 本地学习进度 */
.course-card {
  padding: 32rpx;
}

.course-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.course-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--bg-subtle);
}

.course-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.course-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--bg-subtle);
  flex-shrink: 0;
}

.course-info {
  flex: 1;
  margin-left: 24rpx;
  margin-right: 16rpx;
  min-width: 0;
}

.course-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-progress {
  display: flex;
  align-items: center;
}

.course-progress-bar {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--accent-soft);
  overflow: hidden;
}

.course-progress-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.course-progress-text {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

.course-empty {
  padding: 40rpx 32rpx;
}

.course-empty-text {
  font-size: 26rpx;
  color: var(--text-muted);
  text-align: center;
}

/* === T00593：相册自选头像入口 ===
   为什么用次要按钮而非主按钮：主入口是微信官方推荐的 chooseAvatar（上方圆形头像），
   这里是「被隐私声明拦截」时的降级出路，视觉层级必须低于主入口，不能引导所有用户走它 */
.avatar-album-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-top: -8rpx;
  margin-bottom: 16rpx;
}

.avatar-album-btn {
  min-height: 64rpx;
  line-height: 64rpx !important;
  padding: 0 32rpx !important;
  margin: 0 !important;
  border-radius: var(--radius-btn) !important;
  background: var(--bg-subtle) !important;
  color: var(--accent) !important;
  /* T00753 全局统一：按钮无边框 */
  font-size: 26rpx !important;
}

.avatar-album-btn::after {
  border: none !important;
}

.avatar-album-btn-hover {
  background: var(--border) !important;
}

.avatar-album-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.4;
}

/* ===== T00726 网易云风格：双层 Tab + 悬浮统计 ===== */

/* 统计行：悬浮于背景图之上、昵称下方，小字横排 */
.stats-row {
  /* T00726 修正：背景图为绝对定位，静态流内容会被其覆盖——
     统计行必须自带层叠上下文才能显示（同 avatar/nickname 的 z-index:1） */
  position: relative;
  z-index: 1;
  /* T00726 反馈3：grid 四等列 + 列间隔，宽度自适应且各列严格等宽不叠加 */
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  column-gap: 12rpx;
  margin: 20rpx -32rpx 0;
  padding: 12rpx 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
  /* 轻微压暗底衬：保证白字落在声波亮条上仍可读 */
  background: rgba(31, 48, 64, 0.3);
}
.stats-cell {
  min-width: 0;
  text-align: center;
  white-space: nowrap;
}
.stats-num {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}
.stats-label {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 19rpx;
  white-space: nowrap;
}

/* 双层 Tab 容器 */
.tab-layer {
  margin: 16rpx 0;
}
.tab-bar {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(31, 45, 61, 0.06);
}
.tab-bar-sub {
  margin-top: 10rpx;
  border-radius: 12rpx;
  padding: 4rpx;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  color: #7a8494;
  font-size: 24rpx;
  border-radius: 12rpx;
}
.tab-icon {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 4rpx;
}
.tab-icon-sm {
  width: 28rpx;
  height: 28rpx;
  margin-bottom: 2rpx;
}
.tab-item.tab-active {
  background: rgba(63, 108, 143, 0.1);
  color: #3f6c8f;
  font-weight: 600;
}
.tab-item.tab-sub-active {
  background: rgba(63, 108, 143, 0.06);
  color: #3f6c8f;
}

/* 功能入口网格：图标+文字成对 */
.entry-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0;
}
.entry-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}
.entry-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
}
.entry-text {
  color: #3d4653;
  font-size: 24rpx;
}

/* ===== T00726 反馈：第二层 Tab 内嵌内容 ===== */
.second-panel {
  margin-top: 16rpx;
  padding: 8rpx 0;
}
.second-loading,
.second-empty {
  padding: 32rpx 24rpx;
  color: #909399;
  font-size: 24rpx;
  text-align: center;
}
.second-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--bg-subtle);
}
.second-item:last-of-type {
  border-bottom: none;
}
.second-item-main {
  flex: 1;
  min-width: 0;
}
.second-item-title {
  color: #3d4653;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.second-item-meta {
  margin-top: 4rpx;
  color: #909399;
  font-size: 20rpx;
}
.second-more {
  padding: 16rpx 24rpx;
  color: #3f6c8f;
  font-size: 24rpx;
  text-align: center;
}
.second-entry-card {
  margin-top: 16rpx;
  padding: 32rpx 24rpx;
  color: #3f6c8f;
  font-size: 26rpx;
  text-align: center;
}
