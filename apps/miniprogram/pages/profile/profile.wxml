<!-- 个人中心：用户信息 + 收听统计 + 功能入口 -->
<view class="page-profile">
  <!-- 未登录 -->
  <view class="login-wrap" wx:if="{{!userInfo}}">
    <view class="card login-card">
      <image class="login-icon" src="/images/icons/headphones.png" mode="aspectFit" />
      <view class="login-tip">登录后查看你的收听记录</view>
      <view class="btn-primary btn-icon-only login-btn" bindtap="onLogin" aria-label="点击登录">
        <image class="btn-icon" src="/images/icons/btn-login.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 已登录 -->
  <block wx:if="{{userInfo}}">
    <!-- 用户信息卡片：T00430 头像区背景图（AI 生成，商务蓝声波主题） -->
    <view class="user-card">
      <image
        class="user-card-bg"
        src="/images/profile-header-bg.jpg"
        mode="aspectFill"
        aria-hidden="true"
      />
      <view class="user-card-scrim" aria-hidden="true"></view>
      <image
        class="avatar"
        src="{{userInfo.avatar_url || userInfo.avatar || userInfo.avatarUrl || '/images/icons/avatar-default.jpg'}}"
        mode="aspectFill"
      />
      <view class="nickname">{{userInfo.nickname || userInfo.nickName || '听友'}}</view>
      <!-- T00726：统计信息悬浮于背景图之上、用户名下方（小字横排） -->
      <view class="stats-row">
        <view class="stats-cell">
          <view class="stats-num">{{durationLabel}}</view>
          <view class="stats-label">收听分钟</view>
        </view>
        <view class="stats-cell">
          <view class="stats-num">{{totalListenCount}}</view>
          <view class="stats-label">收听期数</view>
        </view>
        <view class="stats-cell">
          <view class="stats-num">{{completedCount}}</view>
          <view class="stats-label">完播</view>
        </view>
        <view class="stats-cell">
          <view class="stats-num">{{favoriteCount}}</view>
          <view class="stats-label">收藏</view>
        </view>
      </view>
    </view>

    <!-- T00726：双层 Tab（第一层＝频道类型，过滤"我的课程"；第二层＝功能入口） -->
    <view class="tab-layer">
      <view class="tab-bar">
        <view
          class="tab-item {{firstTab === 'news' ? 'tab-active' : ''}}"
          bindtap="onFirstTab" data-tab="news"
        >
          <image class="tab-icon" src="/images/icons/newspaper.png" mode="aspectFit" />
          <text>资讯</text>
        </view>
        <view
          class="tab-item {{firstTab === 'audiobook' ? 'tab-active' : ''}}"
          bindtap="onFirstTab" data-tab="audiobook"
        >
          <image class="tab-icon" src="/images/icons/headphones.png" mode="aspectFit" />
          <text>听书</text>
        </view>
        <view
          class="tab-item {{firstTab === 'course' ? 'tab-active' : ''}}"
          bindtap="onFirstTab" data-tab="course"
        >
          <image class="tab-icon" src="/images/icons/music.png" mode="aspectFit" />
          <text>课程</text>
        </view>
      </view>
      <view class="tab-bar tab-bar-sub">
        <view
          class="tab-item {{secondTab === 'recent' ? 'tab-sub-active' : ''}}"
          bindtap="onSecondTab" data-tab="recent"
        >
          <image class="tab-icon-sm" src="/images/icons/radio.png" mode="aspectFit" />
          <text>最近</text>
        </view>
        <view
          class="tab-item {{secondTab === 'favorites' ? 'tab-sub-active' : ''}}"
          bindtap="onSecondTab" data-tab="favorites"
        >
          <image class="tab-icon-sm" src="/images/icons/favorite.png" mode="aspectFit" />
          <text>收藏</text>
        </view>
        <view
          class="tab-item {{secondTab === 'channels' ? 'tab-sub-active' : ''}}"
          bindtap="onSecondTab" data-tab="channels"
        >
          <image class="tab-icon-sm" src="/images/icons/list.png" mode="aspectFit" />
          <text>频道</text>
        </view>
        <view
          class="tab-item {{secondTab === 'downloads' ? 'tab-sub-active' : ''}}"
          bindtap="onSecondTab" data-tab="downloads"
        >
          <image class="tab-icon-sm" src="/images/icons/download.png" mode="aspectFit" />
          <text>下载</text>
        </view>
        <view
          class="tab-item {{secondTab === 'preferred' ? 'tab-sub-active' : ''}}"
          bindtap="onSecondTab" data-tab="preferred"
        >
          <image class="tab-icon-sm" src="/images/icons/checks.png" mode="aspectFit" />
          <text>偏爱</text>
        </view>
      </view>

      <!-- T00726 反馈：第二层内容真切换——最近/收藏内嵌列表；频道/下载/偏爱为跳转卡 -->
      <view class="card second-panel">
        <view wx:if="{{secondLoading}}" class="second-loading">加载中...</view>
        <block wx:elif="{{secondList.length > 0}}">
          <view
            class="second-item"
            wx:for="{{secondList}}"
            wx:key="key"
            bindtap="onTapSecondItem"
            data-index="{{index}}"
          >
            <view class="second-item-main">
              <view class="second-item-title">{{item.title}}</view>
              <view class="second-item-meta">{{item.meta}}</view>
            </view>
            <image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" />
          </view>
          <view class="second-more" bindtap="goSecondPage">查看全部 ↗</view>
        </block>
        <view wx:elif="{{secondEmpty}}" class="second-empty">{{secondEmpty}}</view>
        <!-- 频道/下载/偏爱无内嵌列表时展示跳转卡 -->
        <view
          wx:if="{{secondEntry}}"
          class="second-entry-card"
          bindtap="goSecondPage"
        >{{secondEntry.text}}</view>
      </view>
    </view>

    <!-- 我的课程（FR-MC-05）：已订阅的课程/有声读物 + 本地学习进度（T00726：随第一层 Tab 过滤） -->
    <view class="card course-card" wx:if="{{filteredCourses.length > 0}}">
      <view class="course-card-title">我的{{firstTabLabel}}</view>
      <view
        class="course-item"
        wx:for="{{filteredCourses}}"
        wx:key="id"
        bindtap="onTapCourse"
        data-id="{{item.id}}"
      >
        <image class="course-cover" src="{{item.cover_url || '/images/icons/headphones.png'}}" mode="aspectFill" />
        <view class="course-info">
          <view class="course-name">{{item.name}}</view>
          <view class="course-progress">
            <view class="course-progress-bar">
              <view class="course-progress-fill" style="width:{{item.percent}}%"></view>
            </view>
            <text class="course-progress-text">{{item.learned}}/{{item.total}} · {{item.percent}}%</text>
          </view>
        </view>
        <image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" />
      </view>
    </view>
    <view class="card course-empty" wx:elif="{{myCoursesLoaded}}">
      <view class="course-empty-text">{{firstTabEmptyText}}</view>
    </view>

    <!-- 退出登录 -->
    <view class="card list-card">
      <view class="list-item" bindtap="onTapSetting" data-key="logout">
        <text class="list-text logout-text">退出登录</text>
        <image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" />
      </view>
    </view>

    <!-- "随时完善资料"入口（资料已完整时仍可点击更新） -->
    <view class="card edit-anytime" bindtap="onTapEditProfile">
      <view class="list-item edit-anytime-row">
        <text class="list-text">编辑个人资料</text>
        <image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" />
      </view>
    </view>
  </block>

  <!-- T02510 / J19 + J12：合规与自助入口对游客同样开放。
       原实现把这张卡整个放在 `wx:if="{{!userInfo}}"` 的 else 分支里，未登录用户既读不到
       《隐私政策》《用户协议》，也无法反馈/清缓存——而产品首启就要弹隐私授权
       （app.json `__usePrivacyCheck__`），等于「要你同意却看不到条款」。
       退出登录、编辑资料仍留在登录分支内，其余各项与登录态无关，移出分支常驻。
       顺带补一条带文字的「播放队列」入口（J12：原先全站唯一入口是历史页一枚纯图标 chip）。 -->
  <view class="card list-card">
    <view class="list-item" bindtap="onTapSetting" data-key="queue">
      <text class="list-text">播放队列</text>
      <image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" />
    </view>
    <view class="list-item" bindtap="onTapSetting" data-key="feedback">
      <text class="list-text">意见反馈</text>
      <image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" />
    </view>
    <view class="list-item" bindtap="onTapSetting" data-key="settings">
      <text class="list-text">播放设置</text>
      <image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" />
    </view>
    <view class="list-item" bindtap="onTapSetting" data-key="about">
      <text class="list-text">关于我们</text>
      <image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" />
    </view>
    <view class="list-item" bindtap="onTapSetting" data-key="agreement">
      <text class="list-text">用户协议</text>
      <image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" />
    </view>
    <view class="list-item" bindtap="onTapSetting" data-key="privacy">
      <text class="list-text">隐私政策</text>
      <image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 使用微信资料弹窗：用 button chooseAvatar + input nickname 获取微信头像和昵称（微信官方推荐方式） -->
  <view class="edit-modal-mask" wx:if="{{showEditProfile}}" bindtap="onCloseEditProfile">
    <view class="edit-modal" catchtap="stopPropagation">
      <view class="edit-modal-title">使用微信资料</view>

      <!-- 头像选择：button open-type="chooseAvatar"（点击后默认显示微信头像，一键选用） -->
      <button
        class="edit-avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
        hover-class="none"
      >
        <image
          class="edit-avatar"
          src="{{editAvatar || userInfo.avatar || userInfo.avatar_url || '/images/icons/avatar-default.jpg'}}"
          mode="aspectFill"
        />
        <text class="edit-avatar-tip">使用微信头像</text>
      </button>

      <!-- T00593：相册/相机自选头像（自定义上传头像）
           chooseAvatar 属隐私接口，mp 后台未声明「收集你的昵称、头像」时点击会被拦截
           （用户侧表现为点了没反应）——本入口是那条路径的降级出路 -->
      <view class="avatar-album-row">
        <button
          class="avatar-album-btn"
          bindtap="onPickAvatarFromAlbum"
          hover-class="avatar-album-btn-hover"
        >从相册选择</button>
        <text class="avatar-album-hint">微信头像点不动？可从相册选一张</text>
      </view>

      <!-- 昵称输入：input type="nickname"（唤起键盘上方的"使用微信昵称"按钮，一键填入） -->
      <view class="edit-nickname-row">
        <text class="edit-nickname-label">昵称</text>
        <input
          class="edit-nickname-input"
          type="nickname"
          placeholder="点击使用微信昵称"
          value="{{editNickname}}"
          bindinput="onInputNickname"
          bindblur="onBlurNickname"
        />
      </view>

      <!-- 操作按钮：T00384 图标即按钮，去掉"取消/保存"文案 -->
      <view class="edit-actions">
        <view class="edit-btn edit-btn-cancel" bindtap="onCloseEditProfile" aria-label="取消">
          <image class="btn-icon" src="/images/icons/btn-x-mint.png" mode="aspectFit" />
        </view>
        <view class="edit-btn edit-btn-confirm" bindtap="onConfirmEditProfile" aria-label="保存">
          <image class="btn-icon" src="/images/icons/btn-check.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 任务9：全局浮动播放按钮 -->
<floating-player />

<!-- T00609：隐私授权弹窗（官方 agreePrivacyAuthorization 按钮模式，
     chooseAvatar 等按钮类隐私接口的授权必须经此组件完成） -->
<privacy-modal />
