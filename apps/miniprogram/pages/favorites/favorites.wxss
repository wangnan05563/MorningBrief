/* 收藏列表样式：复用历史页的马卡龙配色与卡片风格 */

.container {
  min-height: 100vh;
  padding: 24rpx 0;
}

/* === 列表项卡片 === */
.fav-list {
  padding: 0 24rpx;
}

/* 覆盖 .card 的 margin，列表项间距统一用 margin-bottom */
.fav-item {
  margin: 0 0 24rpx 0;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: var(--bg-card);
  box-shadow: 0 4rpx 16rpx rgba(63, 108, 143, 0.08);
  transition: transform 0.15s ease;
}

.fav-item:active {
  transform: scale(0.98);
}

/* 已下架/详情拉取失败的条目：弱化视觉，提示用户可取消收藏 */
.item-unavailable {
  opacity: 0.55;
}

/* 顶部：收藏时间 + 取消收藏入口 */
.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

/* T02513 / J72：条目级取消收藏按钮。
   高度给到 64rpx（约 32px）+ 左右 20rpx 内边距，比纯文字行更容易点中；
   用 danger-soft 底色而不是纯文字，是为了让它看起来确实是「可点的」而不是又一行说明。 */
.unfav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 20rpx;
  border-radius: 32rpx;
  background: var(--danger-soft);
  flex-shrink: 0;
}
.unfav-btn text {
  font-size: 24rpx;
  color: var(--danger);
}
.unfav-btn-hover {
  opacity: 0.7;
}

/* 收藏时间用薄荷青色，与历史页日期风格一致 */
.item-date {
  font-size: 26rpx;
  color: var(--accent-light);
  font-weight: 500;
  margin-right: 16rpx;
}

/* 标题用暖深灰 */
.item-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 20rpx;
}

/* 底部：时长 + 播放图标 */
.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-duration {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.duration-icon {
  width: 24rpx;
  height: 24rpx;
}

/* 播放图标：圆形薄荷青背景，与历史页一致 */
.play-icon-small {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(63, 108, 143, 0.3);
}

/* 列表项小播放图标：白色三角 */
.icon-text {
  width: 24rpx;
  height: 24rpx;
}

/* === 底部操作提示 === */
.list-tip {
  text-align: center;
  padding: 24rpx 0 48rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}
