<!-- 收藏列表页：与历史页风格一致，长按取消收藏 -->
<view class="container">
  <!-- 加载中 -->
  <view class="loading-mask" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{list.length === 0}}"
    icon="/images/icons/favorite.png"
    icon-type="image"
    title="还没有收藏的节目"
    description="在节目详情页点击收藏即可在此查看"
  ></empty-state>

  <!-- 收藏列表 -->
  <block wx:else>
    <view class="fav-list">
      <view
        class="card fav-item {{!item.available ? 'item-unavailable' : ''}}"
        wx:for="{{list}}"
        wx:key="episode_id"
        data-id="{{item.episode_id}}"
        data-title="{{item.title}}"
        bindtap="onTapItem"
        bindlongpress="onLongPressItem"
      >
        <!-- 顶部：收藏时间 + 取消收藏入口 -->
        <view class="item-header">
          <text class="item-date">收藏于 {{fmt.date(item.favorited_at)}}</text>
          <!-- T02513 / J72：条目级可见入口。原先唯一手势是长按，规则只写在页面底部一行小字里，
               首次进来的用户点条目只会被送进详情页，找不到移除入口。
               用 catchtap 而不是 bindtap：父级 .fav-item 的 bindtap 会跳详情，
               不阻断的话「取消收藏」这一下会同时把用户带离本页。 -->
          <view
            class="unfav-btn"
            data-id="{{item.episode_id}}"
            data-title="{{item.title}}"
            catchtap="onUnfavoriteTap"
            hover-class="unfav-btn-hover"
            aria-label="取消收藏该节目"
          >
            <text>取消收藏</text>
          </view>
        </view>

        <!-- 标题 -->
        <text class="item-title">{{item.title || '节目信息加载失败'}}</text>

        <!-- 底部：时长 + 播放图标 -->
        <view class="item-footer">
          <view class="item-duration">
            <image class="duration-icon" lazy-load src="/images/icons/duration.png" mode="aspectFit" />
            <text>{{fmt.time(item.duration)}}</text>
          </view>
          <view class="play-icon-small">
            <image class="icon-text" lazy-load src="/images/icons/play-mini.png" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>

    <!-- 底部提示：T02513 / J72 起主入口已是条目右上角的按钮，这里只保留长按这条备选手势 -->
    <view class="list-tip">
      <text>点条目右上角「取消收藏」即可移除，也支持长按</text>
    </view>
  </block>
</view>

<!-- WXS：时间格式化（避免在 JS 中维护额外字段） -->
<wxs module="fmt">
  module.exports = {
    // 秒 → "mm:ss"，与 history 页保持一致
    time: function(s) {
      s = s || 0;
      var m = Math.floor(s / 60);
      var sec = Math.floor(s % 60);
      return (m < 10 ? '0' + m : m) + ':' + (sec < 10 ? '0' + sec : sec);
    },
    // ISO 时间 → "YYYY-MM-DD"，仅保留日期部分便于排版
    date: function(iso) {
      if (!iso) return '';
      return iso.length >= 10 ? iso.substring(0, 10) : iso;
    }
  };
</wxs>

<!-- 全局浮动播放器：离开 tab 后仍可看到并控制后台播放（B4） -->
<floating-player />
