/* 外链容器页样式 */
.page-webview {
  width: 100%;
  height: 100vh;
}

web-view {
  width: 100%;
  height: 100vh;
}

/* 加载失败的 fallback 界面：居中卡片风格 */
.webview-fallback {
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fallback-title {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.fallback-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.fallback-url {
  width: 100%;
  padding: 24rpx 32rpx;
  background: var(--bg-subtle);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--accent);
  word-break: break-all;
  margin-bottom: 48rpx;
  user-select: text;
}

.fallback-actions {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: 16rpx;
}

.fallback-actions .btn-primary,
.fallback-actions .btn-secondary {
  width: 100%;
  border: none;
  font-size: 30rpx;
  padding: 24rpx 0;
  border-radius: 48rpx;
}

.fallback-actions .btn-primary {
  background: var(--accent);
  color: var(--text-inverse);
}

.fallback-actions .btn-secondary {
  background: var(--accent-soft);
  color: var(--accent);
}
