<!--
  外链容器页：用 web-view 加载节目来源原文
  业务域名需在微信公众平台后台配置；开发时勾选"不校验业务域名"可临时跳过校验
  加载失败时显示"复制链接"按钮作为 fallback，让用户在浏览器中打开
-->
<view class="page-webview">
  <!-- error 为 true 时不渲染 web-view，避免微信在加载前原生拦截显示"无法打开该页面" -->
  <web-view wx:if="{{url && !error}}" src="{{url}}" binderror="onError" bindload="onWebviewLoad" />
  <view class="webview-fallback" wx:if="{{error}}">
    <text class="fallback-title">无法在小程序内打开此链接</text>
    <text class="fallback-desc">链接可能未加入业务域名白名单，请复制到浏览器打开</text>
    <view class="fallback-url">{{url}}</view>
    <view class="fallback-actions">
      <!-- T00384：图标即按钮，去掉"复制链接/返回"文案 -->
      <button class="btn-primary btn-icon-only" bindtap="onCopy" hover-class="none" aria-label="复制链接">
        <image class="btn-icon" src="/images/icons/btn-copy.png" mode="aspectFit" />
      </button>
      <button class="btn-secondary btn-icon-only" bindtap="onBack" hover-class="none" aria-label="返回">
        <image class="btn-icon" src="/images/icons/btn-arrow-left-mint.png" mode="aspectFit" />
      </button>
    </view>
  </view>
</view>
