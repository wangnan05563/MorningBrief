/**
 * 播放队列页样式
 * 与详情页队列弹窗（detail.wxss 中的 .queue-modal-* / .qm-item-*）保持视觉一致：
 * 用户在详情页弹窗和独立队列页看到的列表项外观完全相同，
 * 避免用户在两个入口间切换时产生"样式割裂"感。
 *
 * 复用方式：直接使用详情页同款类名，仅去掉弹窗遮罩/容器定位相关样式
 * （mask/container 是弹窗专用，独立页面不需要）
 */

.page-queue {
  min-height: 100vh;
  background: var(--bg-page);
}

/* === 头部（复用详情页弹窗 header 样式） === */
.queue-modal-header {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--bg-subtle);
  background: var(--bg-card);
}

.queue-modal-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.queue-modal-count {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-right: 20rpx;
}

/* T00384：清空改为图标按钮，触控区 88rpx（与详情页弹窗同款） */
.queue-modal-close.clear-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  border-radius: var(--radius-btn);
  background: var(--danger-soft);
}

.clear-btn-icon {
  width: 40rpx;
  height: 40rpx;
}

.queue-modal-close.clear-btn:active {
  opacity: 0.7;
}

/* === 空状态 === */
.queue-modal-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0 80rpx;
  gap: 16rpx;
}

.queue-modal-empty .empty-icon-img {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.4;
}

.queue-modal-empty text {
  font-size: 28rpx;
  color: var(--border-strong);
}

.empty-desc {
  font-size: 24rpx;
  color: var(--border-strong);
  margin-top: 12rpx;
}

/* === 队列列表 === */
.queue-page-list {
  height: calc(100vh - 100rpx);
  padding: 0 24rpx;
}

.queue-modal-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: var(--bg-card);
  transition: background 0.15s ease;
}

.queue-modal-item.current {
  background: var(--bg-subtle);
}

.queue-modal-item:active {
  opacity: 0.7;
}

.qm-item-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.qm-playing-icon {
  width: 24rpx;
  height: 24rpx;
}

.qm-item-index text {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 500;
}

.qm-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.qm-item-title {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qm-item-date {
  font-size: 22rpx;
  color: var(--border-strong);
}
