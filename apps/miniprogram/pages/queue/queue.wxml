<!-- 播放队列页：样式与详情页队列弹窗完全一致（复用 .queue-modal-* / .qm-item-* 类名） -->
<view class="page-queue">
  <!-- 顶部操作栏（与详情页弹窗头部同款） -->
  <view class="queue-modal-header" wx:if="{{queue.length > 0}}">
    <text class="queue-modal-title">播放队列</text>
    <text class="queue-modal-count">{{queue.length}} 首</text>
    <!-- J112：清空是破坏性主操作，恢复「清空」文字，图标仅作辅助 -->
    <view class="queue-modal-close clear-btn" bindtap="onClear" aria-label="清空播放队列">
      <image class="clear-btn-icon" lazy-load src="/images/icons/trash.png" mode="aspectFit" />
      <text class="clear-btn-label">清空</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="queue-modal-empty" wx:if="{{queue.length === 0}}">
    <image class="empty-icon-img" lazy-load src="/images/icons/music.png" mode="aspectFit" />
    <text>播放队列为空</text>
    <text class="empty-desc">在历史列表中点击节目即可加入队列</text>
  </view>

  <!-- 队列列表：与详情页弹窗列表项完全一致 -->
  <scroll-view scroll-y class="queue-page-list" wx:else>
    <view
      class="queue-modal-item {{index === currentIndex ? 'current' : ''}}"
      wx:for="{{queue}}"
      wx:key="index"
      data-index="{{index}}"
      bindtap="onTapItem"
    >
      <view class="qm-item-index">
        <image wx:if="{{index === currentIndex}}" class="qm-playing-icon" lazy-load src="/images/icons/play-mini-accent.png" mode="aspectFit" />
        <text wx:else>{{index + 1}}</text>
      </view>
      <view class="qm-item-info">
        <text class="qm-item-title">{{item.title}}</text>
        <text class="qm-item-date">{{item.date}}</text>
      </view>
      <!-- J77：单项管理（上移/下移/移出）。catchtap 阻止冒泡，避免点按钮时误触播放 -->
      <view class="qm-item-actions">
        <view
          wx:if="{{index > 0}}"
          class="qm-act"
          catchtap="onMoveItem"
          data-index="{{index}}"
          data-dir="-1"
          aria-label="上移"
        >↑</view>
        <view
          wx:if="{{index < queue.length - 1}}"
          class="qm-act"
          catchtap="onMoveItem"
          data-index="{{index}}"
          data-dir="1"
          aria-label="下移"
        >↓</view>
        <view
          class="qm-act qm-act--danger"
          catchtap="onRemoveItem"
          data-index="{{index}}"
          aria-label="移出队列"
        >×</view>
      </view>
    </view>
  </scroll-view>
</view>

<!-- 全局浮动播放器：离开 tab 后仍可看到并控制后台播放（B4） -->
<floating-player />
