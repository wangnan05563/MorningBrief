.page-feedback {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 卡片间距收敛：反馈页卡片较多，统一收紧上下边距 */
.feedback-card {
  padding: 28rpx 32rpx;
  margin: 20rpx 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

/* === 分类标签：薄荷青 + 浅粉双态，呼应全局马卡龙配色 === */
.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.category-tag {
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

/* 选中态切换为蜜桃粉：与未选中的薄荷青形成明确对比 */
.category-tag.active {
  color: var(--text-inverse);
  background: var(--accent);
  border-color: var(--accent);
}

/* === 反馈内容输入区 === */
.content-input {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  background: var(--bg-page);
  border: 2rpx solid var(--accent-soft);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.content-ph {
  color: var(--border-strong);
}

/* 字数统计贴右下角：用户输入时目光自然落点 */
.content-counter {
  margin-top: 12rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* === 联系方式输入框 === */
.contact-input {
  width: 100%;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--bg-page);
  border: 2rpx solid var(--accent-soft);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.contact-ph {
  color: var(--border-strong);
}

/* === 提交按钮 ===
   T00384：图标即按钮，固定宽度方形触控区并居中 */
.submit-wrap {
  display: flex;
  justify-content: center;
  padding: 40rpx 24rpx 0;
}

.submit-btn {
  width: 120rpx;
  min-height: 96rpx;
  padding: 0;
  border-radius: var(--radius-btn);
}

/* 禁用态降低饱和度，提示用户不可点击 */
.submit-btn.disabled {
  opacity: 0.6;
}

/* === 反馈历史（B7）：与全局马卡龙配色统一 === */
.history-list {
  display: flex;
  flex-direction: column;
}

.history-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--bg-subtle);
}

.history-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.history-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.history-cate {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-soft);
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.history-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.history-summary {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  word-break: break-all;
}
