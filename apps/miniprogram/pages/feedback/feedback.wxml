<!-- 意见反馈：分类 + 内容 + 联系方式 -->
<view class="page-feedback">

  <!-- 我的反馈历史（B7）：本地留存已发送记录，便于回溯 -->
  <view class="card feedback-card" wx:if="{{history.length > 0}}">
    <view class="section-title">我的反馈（{{history.length}}）</view>
    <view class="history-list">
      <view class="history-item" wx:for="{{history}}" wx:key="time">
        <view class="history-top">
          <text class="history-cate">{{item.category}}</text>
          <text class="history-time">{{item.timeLabel || ''}}</text>
        </view>
        <text class="history-summary">{{item.summary}}</text>
      </view>
    </view>
  </view>

  <!-- 分类选择 -->
  <view class="card feedback-card">
    <view class="section-title">反馈分类</view>
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="category-tag {{selectedCategory === item ? 'active' : ''}}"
        data-category="{{item}}"
        bindtap="onCategoryTap"
      >{{item}}</view>
    </view>
  </view>

  <!-- 反馈内容 -->
  <view class="card feedback-card">
    <view class="section-title">反馈内容</view>
    <textarea
      class="content-input"
      value="{{content}}"
      placeholder="请详细描述您遇到的问题或建议（至少 10 个字）"
      placeholder-class="content-ph"
      maxlength="{{maxLength}}"
      auto-height
      bindinput="onContentInput"
    />
    <view class="content-counter">{{content.length}}/{{maxLength}}</view>
  </view>

  <!-- 联系方式 -->
  <view class="card feedback-card">
    <view class="section-title">联系方式</view>
    <input
      class="contact-input"
      value="{{contact}}"
      placeholder="选填，方便我们回复您"
      placeholder-class="contact-ph"
      maxlength="50"
      bindinput="onContactInput"
    />
  </view>

  <!-- 提交按钮：提交中禁用并显示 loading，避免重复提交
       T00384：图标即按钮，去掉"提交反馈/提交中"文案 -->
  <view class="submit-wrap">
    <button
      class="btn-primary submit-btn {{submitting ? 'disabled' : ''}}"
      disabled="{{submitting}}"
      bindtap="onSubmit"
      hover-class="none"
      aria-label="{{submitting ? '提交中' : '提交反馈'}}"
    >
      <image class="btn-icon" src="/images/icons/btn-send.png" mode="aspectFit" />
    </button>
  </view>
</view>
