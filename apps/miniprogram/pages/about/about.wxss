.page-about {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 应用信息头部：与 profile 页 user-card 保持一致的渐变风格 */
.about-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx 60rpx;
  background: var(--accent);
  border-radius: 0 0 48rpx 48rpx;
}

.app-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-inverse);
}

.app-version {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.app-desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 功能介绍 */
.feature-card {
  padding: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--bg-subtle);
}

.feature-item:last-child {
  border-bottom: none;
}

/* 功能图标：PNG 圆角方形，浅薄荷背景烘托 */
.feature-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  padding: 16rpx;
  background: var(--accent-soft);
  border-radius: 16rpx;
  flex-shrink: 0;
}

.feature-info {
  flex: 1;
}

.feature-title {
  font-size: 30rpx;
  color: var(--text-primary);
}

.feature-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 开发者与联系方式 */
.info-card {
  padding: 0 32rpx;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--bg-subtle);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-muted);
  width: 160rpx;
}

.info-value {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.info-action {
  font-size: 26rpx;
  color: var(--accent);
  padding: 8rpx 20rpx;
  background: var(--accent-soft);
  border-radius: 20rpx;
}

.about-footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* T00618：联系邮箱可长按选中复制（剪贴板不可用时的兜底） */
.contact-text {
  user-select: text;
  -webkit-user-select: text;
  word-break: break-all;
}
