<!-- 关于我们：应用信息 + 功能介绍 + 开发者/联系方式 -->
<view class="page-about">
  <!-- 应用信息头部 -->
  <view class="about-header">
    <image class="app-logo" src="/images/icons/app-logo.png" mode="aspectFit" />
    <view class="app-name">{{appName}}</view>
    <view class="app-version" bindtap="onVersionTap">版本 {{version}}{{buildDate ? ' · ' + buildDate : ''}}</view>
    <view class="app-desc">{{description}}</view>
  </view>

  <!-- 功能介绍 -->
  <view class="card feature-card">
    <view class="section-title">功能介绍</view>
    <view class="feature-list">
      <view class="feature-item" wx:for="{{features}}" wx:key="title">
        <image class="feature-icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="feature-info">
          <view class="feature-title">{{item.title}}</view>
          <view class="feature-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 开发者与联系方式 -->
  <view class="card info-card">
    <view class="info-item">
      <text class="info-label">开发者</text>
      <text class="info-value">{{author}}</text>
    </view>
    <view class="info-item" bindtap="onCopyContact">
      <text class="info-label">联系邮箱</text>
      <!-- T00618：邮箱文本可长按选中复制（剪贴板不可用时的兜底路径） -->
      <text class="info-value contact-text" selectable user-select>{{contact}}</text>
      <text class="info-action">复制</text>
    </view>
  </view>

  <view class="about-footer">© 2026 {{appName}} · 用耳朵听新闻</view>

<!-- T00618：隐私授权弹窗（剪贴板属隐私接口，授权须经官方按钮，见 components/privacy-modal） -->
<privacy-modal />
</view>
