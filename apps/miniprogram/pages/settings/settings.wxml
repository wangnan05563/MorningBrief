<!-- 设置：播放设置 + 通知设置 + 缓存管理 -->
<view class="page-settings">
  <!-- 播放设置 -->
  <view class="settings-section-title">播放设置</view>
  <view class="card list-card">
    <view class="list-item">
      <text class="list-text">默认播放倍速</text>
      <picker class="list-picker" mode="selector" range="{{rateOptions}}" value="{{rateIndex}}" bindchange="onRateChange">
        <view class="list-extra">{{rateOptions[rateIndex]}}x <image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" /></view>
      </picker>
    </view>
    <view class="list-item">
      <text class="list-text">自动播放下一条</text>
      <switch checked="{{autoPlayNext}}" bindchange="onAutoPlayNextChange" color="#3F6C8F" />
    </view>
    <view class="list-item">
      <text class="list-text">仅 WiFi 下自动播放</text>
      <switch checked="{{wifiOnlyAutoPlay}}" bindchange="onWifiOnlyChange" color="#3F6C8F" />
    </view>
    <!-- T00774：无缝过渡——预加载下一首详情+音频，连播/切歌零等待；与自动连播开关解耦 -->
    <view class="list-item">
      <text class="list-text">无缝过渡（预载下一首）</text>
      <switch checked="{{transitionEnabled}}" bindchange="onTransitionChange" color="#3F6C8F" />
    </view>
  </view>

  <!-- 通知设置 -->
  <view class="settings-section-title">通知设置</view>
  <view class="card list-card">
    <view class="list-item">
      <text class="list-text">新节目通知</text>
      <switch checked="{{notifyNewEpisode}}" bindchange="onNotifyChange" color="#3F6C8F" />
    </view>
  </view>

  <!-- 存储管理 -->
  <view class="settings-section-title">存储管理</view>
  <view class="card list-card">
    <view class="list-item" bindtap="onClearCache">
      <text class="list-text">清除缓存</text>
      <view class="list-extra">{{cacheSize}} <image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" /></view>
    </view>
  </view>

  <!-- 关于与更新 -->
  <view class="settings-section-title">关于与更新</view>
  <view class="card list-card">
    <view class="list-item" bindtap="onCheckUpdate">
      <text class="list-text">检查更新</text>
      <view class="list-extra"><image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" /></view>
    </view>
    <view class="list-item" bindtap="onOpenAbout">
      <text class="list-text">关于南屿听记</text>
      <view class="list-extra"><image class="list-arrow" src="/images/icons/chevron-right.png" mode="aspectFit" /></view>
    </view>
  </view>
</view>
