.page-settings {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 分组标题：与 list-card 视觉层级区分 */
.settings-section-title {
  padding: 32rpx 48rpx 12rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 设置列表：复用 profile 页 list-item 风格 */
.list-card {
  padding: 0 32rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--bg-subtle);
}

.list-item:last-child {
  border-bottom: none;
}

/* T02513 / J80/J99：行下方紧跟说明文字时，把分隔线让给说明块（否则分隔线夹在两者之间像断了） */
.list-item--captioned {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.list-caption {
  padding: 0 0 24rpx;
  border-bottom: 2rpx solid var(--bg-subtle);
}

.list-caption:last-child {
  border-bottom: none;
}

.list-caption text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-muted);
}

.list-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.list-extra {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-muted);
}

.list-arrow {
  margin-left: 8rpx;
  width: 24rpx;
  height: 24rpx;
}

.list-picker {
  display: flex;
  align-items: center;
}
