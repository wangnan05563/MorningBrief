/* 首页样式：马卡龙配色，大圆角，柔和阴影 */

.container {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* === 顶部工具栏：搜索 + 频道胶囊 + 睡眠定时器 === */
.top-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--bg-card);
  border-bottom: 2rpx solid var(--bg-subtle);
  position: sticky;
  top: 0;
  z-index: 10;
}

/* === 任务3：续播卡片 === */
.continue-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 2rpx solid var(--accent-soft-strong);
  margin: 24rpx;
  padding: 24rpx 28rpx;
}

/* 继续播放卡播放键：碟片样式（与列表 row-play 同配方，小一号 64rpx） */
.continue-icon-wrap {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: radial-gradient(
    circle at 50% 50%,
    var(--accent) 0 30%,
    #8c9cb0 31% 41%,
    #b3c0cf 42% 100%
  );
  box-shadow: 0 2rpx 8rpx rgba(63, 108, 143, 0.18), inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
  margin-right: 20rpx;
}

/* 唱片纹路 + 非对称高光（转动可见性依赖高光） */
.continue-icon-wrap::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background:
    repeating-radial-gradient(
      circle at 50% 50%,
      rgba(255, 255, 255, 0.42) 0 2rpx,
      rgba(255, 255, 255, 0) 2rpx 7rpx
    ),
    conic-gradient(
      from 0deg,
      rgba(255, 255, 255, 0.55) 0deg 26deg,
      rgba(255, 255, 255, 0) 26deg 360deg
    );
  pointer-events: none;
}

.continue-icon-wrap.playing::before {
  animation: disc-spin 9s linear infinite;
}

/* 内层播放/暂停图标：与历史页一致（26rpx 适配 64rpx 碟片中心标签） */
.continue-icon {
  position: relative;
  z-index: 1;
  width: 26rpx;
  height: 26rpx;
}

.continue-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.continue-label {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.continue-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.continue-meta {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.continue-arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: 12rpx;
}

/* === 任务3：节目列表行 === */
.episode-row-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 16rpx 24rpx;
}

/* 已播放卡片：整体降透明度，与未播放的形成视觉区分 */
/* T00753 追加：已播放仅弱化内容区，**播放键保持全彩**（否则与历史页碟片风格不一致） */
.episode-row-card.played .row-cover,
.episode-row-card.played .row-main {
  opacity: 0.6;
}

.row-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: var(--accent-soft);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  padding: 8rpx;
}
.row-cover-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  display: block;
}

.row-cover-channel {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
}

.row-cover-date {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

/* 已播放角标：浅灰胶囊样式，与彩色封面形成对比 */
.played-badge {
  font-size: 18rpx;
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.7);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  margin-top: 6rpx;
  line-height: 1.2;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin-right: 16rpx;
}

.row-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 10rpx;
}

.row-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-stat {
  display: flex;
  align-items: center;
}

/* 统计前置图标：使用弱化灰版本（play-mini-muted.png），白底卡片上白色版不可见 */
.row-stat-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.row-stat text {
  font-size: 22rpx;
  color: var(--text-muted);
}

.row-play {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  /* 碟片样式：中心薄荷标签 + 外圈黑胶盘体（径向渐变模拟唱片） */
  /* T00753 追加：配色调浅——盘体由近黑改浅灰蓝，浅色页面更柔和 */
  background: radial-gradient(
    circle at 50% 50%,
    var(--accent) 0 30%,
    #8c9cb0 31% 41%,
    #b3c0cf 42% 100%
  );
  box-shadow: 0 2rpx 8rpx rgba(63, 108, 143, 0.18), inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
}

/* 唱片纹路 + 非对称高光（高光用于表达"转动"） */
.row-play::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background:
    repeating-radial-gradient(
      circle at 50% 50%,
      rgba(255, 255, 255, 0.42) 0 2rpx,
      rgba(255, 255, 255, 0) 2rpx 7rpx
    ),
    conic-gradient(
      from 0deg,
      rgba(255, 255, 255, 0.55) 0deg 26deg,
      rgba(255, 255, 255, 0) 26deg 360deg
    );
  pointer-events: none;
}

/* 播放中：高光层匀速旋转（图标独立于该层，保持正向） */
.row-play.playing::before {
  animation: disc-spin 9s linear infinite;
}

@keyframes disc-spin {
  to { transform: rotate(360deg); }
}

.row-play:active {
  transform: scale(0.95);
}

.row-play-icon {
  position: relative;
  z-index: 1;
  width: 30rpx;
  height: 30rpx;
}

/* === 任务5：带封面背景的播放卡片 === */
.player-card.with-cover {
  background-blend-mode: lighten;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  min-height: 540rpx;
  position: relative;
}

.player-card.with-cover::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  pointer-events: none;
}

.player-card.with-cover > view {
  position: relative;
  z-index: 1;
}

/* === 任务4：文稿区 === */
.script-card {
  margin-top: 8rpx;
}

.script-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.script-action {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 400;
}

.script-content {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.script-segment {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-page);
  border-radius: 16rpx;
  border-left: 6rpx solid var(--accent-light);
}

.seg-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

/* 分段封面图：圆角不抢戏 */
.seg-cover {
  width: 100%;
  height: 240rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: var(--bg-subtle);
}

.seg-content {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.top-action {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-subtle);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.top-action:active {
  background: var(--accent-soft);
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}

.channel-bar {
  flex: 1;
  /* T00753 修复：scroll-x 用 flex 布局（配合 enable-flex），子项不压缩不换行，
     比 inline-block + white-space 更稳，避免横向滑动失效 */
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: nowrap;
  white-space: nowrap;
  margin: 0 16rpx;
  height: 64rpx;
}

/* 频道导航 tab：无背景 + 下划线指示（T00753 追加：用户要求去底色、横线风格） */
.channel-pill {
  position: relative;
  display: inline-block;
  /* 作为 flex 子项：不压缩、不换行，宽度按内容 */
  flex: 0 0 auto;
  padding: 11rpx 26rpx;
  margin-right: 18rpx;
  border-radius: 0;
  font-size: 27rpx;
  color: var(--text-secondary);
  background: transparent;
  transition: color 0.2s ease, font-weight 0.2s ease;
  line-height: 42rpx;
}

/* 选中：标题加粗 + 主题色 + 下方横线指示条 */
.channel-pill.active {
  color: var(--accent);
  font-weight: 700;
  background: transparent;
  box-shadow: none;
}

.channel-pill.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--accent);
}

/* 课程/听书类频道：仅以文字色区分（无底色） */
.channel-pill.course {
  color: var(--text-secondary);
}

.channel-pill.course.active {
  color: var(--accent);
}

/* 课程类角标（课/听）：无底胶囊 → 浅底小标，仍可一眼区分类型 */
.pill-badge {
  display: inline-block;
  margin-left: 6rpx;
  padding: 0 8rpx;
  border-radius: 12rpx;
  font-size: 19rpx;
  line-height: 28rpx;
  color: var(--accent);
  background: var(--accent-soft);
  vertical-align: middle;
}

/* 频道分组标签（资讯 / 课程）：加深颜色 + 加粗，与频道名形成层级区分 */
.channel-group-label {
  display: inline-block;
  /* 作为 flex 子项：不压缩 */
  flex: 0 0 auto;
  margin-right: 10rpx;
  padding: 0 8rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 64rpx;
  letter-spacing: 2rpx;
}

/* === 睡眠定时器状态条 === */
.sleep-status {
  text-align: center;
  padding: 16rpx 24rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 24rpx;
}

/* === 问候语卡片：薄荷青到蜜桃粉极浅渐变 === */
.greeting-card {
  margin: 24rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: var(--accent-soft);
  box-shadow: 0 4rpx 16rpx rgba(63, 108, 143, 0.12);
}

.greeting-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--accent);
  margin-bottom: 12rpx;
}

.greeting-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* === 节目信息卡片 === */
.episode-card {
  display: flex;
  flex-direction: column;
}

.episode-meta {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.episode-date {
  font-size: 26rpx;
  color: var(--accent-light);
  font-weight: 500;
  margin-right: 16rpx;
}

.episode-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.episode-duration {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* === 播放控制卡片 === */
.player-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 播放错误提示条：蜜桃粉淡背景 + 警示色文字，与 detail 页风格一致 */
.play-error-tip {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: var(--accent-soft);
  font-size: 24rpx;
  color: var(--accent);
  line-height: 1.5;
}

.play-error-tip .error-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

/* 大圆形播放按钮：120rpx，薄荷青渐变 + 柔和阴影 */
.play-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(63, 108, 143, 0.4);
  margin-bottom: 40rpx;
  transition: transform 0.15s ease;
}

.play-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* 播放/暂停图标：白色实心，居中对齐（image 标签自动居中无需左偏移） */
.play-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 进度条 */
.progress-slider {
  width: 100%;
  margin: 0 0 16rpx 0;
}

/* 时间显示 */
.time-display {
  width: 100%;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* === 骨架屏：与节目行布局对齐（封面 + 标题 + 副标题 + 播放按钮占位） === */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.shimmer {
  background: linear-gradient(90deg, var(--bg-subtle) 25%, var(--bg-card) 50%, var(--bg-subtle) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}

.skeleton-wrap {
  padding: 16rpx 0;
}

.skeleton-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
}

.skeleton-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.skeleton-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-right: 16rpx;
}

.skeleton-title {
  height: 32rpx;
  border-radius: 8rpx;
  width: 60%;
}

.skeleton-sub {
  height: 24rpx;
  border-radius: 8rpx;
  width: 40%;
}

.skeleton-play {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* === "我的偏爱"未设置时的引导卡片 === */
.preferred-empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
  text-align: center;
}
.preferred-empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}
.preferred-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.preferred-empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
  line-height: 1.5;
}
/* T00384：图标即按钮，方形触控区 */
.preferred-empty-btn {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
}
