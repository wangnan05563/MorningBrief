<!-- 首页：今日要闻播放页 -->
<view class="container">
  <!-- 顶部工具栏：搜索 + 频道切换 + 睡眠定时器 -->
  <view class="top-bar" wx:if="{{!loading}}">
    <view class="top-action" bindtap="onSearch">
      <image class="action-icon" lazy-load src="/images/icons/search.png" mode="aspectFit" />
    </view>
    <!-- T02513 / J46：scroll-into-view 让「选中胶囊」一定在可视区内。
         频道多于屏幕宽度时，从频道页/深链切过来的选中项可能正落在屏幕外，
         用户读不到「已经切了」这个事实（评审 J46 的「没反应」一半来自这里）。 -->
    <scroll-view scroll-x enable-flex scroll-with-animation scroll-into-view="{{scrollIntoViewId}}" class="channel-bar" wx:if="{{channels.length > 0}}">
      <block wx:for="{{channels}}" wx:key="id">
        <view wx:if="{{item.isGroupLabel}}" class="channel-group-label">{{item.label}}</view>
        <view
          wx:else
          id="pill-{{index}}"
          class="channel-pill {{currentChannelId === item.id ? 'active' : ''}} {{item.channel_type !== 'news' ? 'course' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSwitchChannel"
        >{{item.name}}<text wx:if="{{item.type_label && item.type_label !== '资讯'}}" class="pill-badge">{{item.type_label}}</text></view>
      </block>
    </scroll-view>
    <!-- T02510 / J12：首页补队列入口（原先 index.js 的 onOpenQueue 无 wxml 绑定，
         全站唯一入口是历史页那枚纯图标 chip，多数用户不知道自己有播放队列页） -->
    <view class="top-action" bindtap="onOpenQueue" aria-label="打开播放队列">
      <image class="action-icon" lazy-load src="/images/icons/list.png" mode="aspectFit" />
    </view>
    <view class="top-action" bindtap="onSleepTimer">
      <image class="action-icon" lazy-load src="{{sleepActive ? '/images/icons/alarm.png' : '/images/icons/moon.png'}}" mode="aspectFit" />
    </view>
  </view>

  <!-- 睡眠定时器状态条 -->
  <view class="sleep-status" wx:if="{{sleepActive}}">
    <text>{{sleepLabel}}</text>
  </view>

  <!-- 骨架屏：3 个节目行占位，shimmer 动画 -->
  <view class="skeleton-wrap" wx:if="{{loading}}">
    <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton-cover shimmer"></view>
      <view class="skeleton-main">
        <view class="skeleton-title shimmer"></view>
        <view class="skeleton-sub shimmer"></view>
      </view>
      <view class="skeleton-play shimmer"></view>
    </view>
    <!-- T00599：分级加载提示——慢加载（>2s）文案 / 超时（>8s）重试入口；
         骨架保持不动，只在下方追加提示，避免用户以为卡死 -->
    <view class="load-hint" wx:if="{{loadingSlow}}">网络较慢，正在加载…</view>
    <view class="load-retry-wrap" wx:if="{{loadingTimedOut}}">
      <button class="load-retry-btn" bindtap="onRetryLoad" hover-class="none">重试</button>
    </view>
  </view>

  <!-- === 今日节目列表（统一布局，点击跳转 detail 页） === -->
  <block wx:elif="{{!loading}}">
    <!-- "我的偏爱"未设置时的引导设置提示 -->
    <view class="card preferred-empty-card" wx:if="{{isPreferredMode && preferredEmpty}}">
      <image class="preferred-empty-icon" lazy-load src="/images/icons/radio.png" mode="aspectFit" />
      <view class="preferred-empty-title">还没有偏爱频道</view>
      <view class="preferred-empty-desc">勾选喜爱的频道，这里会只展示你关心的内容</view>
      <view class="preferred-empty-btn" bindtap="onTapPreferredSettings" aria-label="去设置偏爱频道">
        <image class="preferred-empty-btn-icon" src="/images/icons/btn-settings-mint.png" mode="aspectFit" />
      </view>
    </view>

    <view class="greeting-card" wx:if="{{todayList.length > 0}}">
      <text class="greeting-title">{{isPreferredMode ? '我的偏爱 · 今日 ' + todayList.length + ' 个节目' : '今日共 ' + todayList.length + ' 个频道已更新'}}</text>
      <text class="greeting-subtitle">{{todayDateText}} · 挑选你感兴趣的频道收听</text>
    </view>

    <!-- 继续播放：展示上次播放过的频道与进度（任务3续播） -->
    <view class="card continue-card" wx:if="{{lastPlayedEpisode}}" bindtap="onTapContinue">
      <view class="continue-icon-wrap {{(isPlaying && currentEpisodeId === lastPlayedEpisode.id) ? 'playing' : ''}}">
        <image class="continue-icon" lazy-load src="{{(isPlaying && currentEpisodeId === lastPlayedEpisode.id) ? '/images/icons/pause.png' : '/images/icons/play-mini.png'}}" mode="aspectFit" />
      </view>
      <view class="continue-info">
        <text class="continue-label">继续播放</text>
        <text class="continue-title">{{lastPlayedEpisode.title || '上次的节目'}}</text>
        <text class="continue-meta" wx:if="{{lastPlayedEpisode.channel_name}}">{{lastPlayedEpisode.channel_name}} · 已播 {{fmt.time(lastPlayedEpisode.currentTime)}}</text>
        <text class="continue-meta" wx:else>已播 {{fmt.time(lastPlayedEpisode.currentTime)}}</text>
      </view>
      <image class="continue-arrow" lazy-load src="/images/icons/chevron-right.png" mode="aspectFit" />
    </view>

    <!-- 节目列表：每频道一行 + 播放量/时长小图标 -->
    <view
      class="card episode-row-card {{item.played ? 'played' : ''}}"
      wx:for="{{todayList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapEpisode"
    >
      <view class="row-cover">
        <!-- T00731：频道 AI 封面（无封面回退文字占位）；已播放角标保留 -->
        <image
          wx:if="{{item.channel_cover}}"
          class="row-cover-img"
          src="{{item.channel_cover}}"
          mode="aspectFill"
          lazy-load
        />
        <block wx:else>
          <text class="row-cover-channel">{{item.channel_name || '节目'}}</text>
          <text class="row-cover-date">{{item.date_label || ''}}</text>
        </block>
        <!-- T00730：频道图标小标（上传/AI 生成），叠封面左上角；历史页同款保持一致 -->
        <image
          wx:if="{{item.channel_icon}}"
          class="row-cover-icon"
          src="{{item.channel_icon}}"
          mode="aspectFill"
          lazy-load
        />
        <text class="played-badge" wx:if="{{item.played}}">已播放</text>
      </view>
      <view class="row-main">
        <text class="row-title">{{item.title || (item.date_label + ' · ' + (item.channel_name || '节目'))}}</text>
        <view class="row-stats">
          <view class="row-stat">
            <image class="row-stat-icon" lazy-load src="/images/icons/play-mini-muted.png" mode="aspectFit" />
            <text>{{item.play_count || 0}} 播放</text>
          </view>
          <view class="row-stat">
            <image class="row-stat-icon" lazy-load src="/images/icons/duration.png" mode="aspectFit" />
            <text>{{item.duration_label || '00:00'}}</text>
          </view>
        </view>
      </view>
      <view
        class="row-play {{(isPlaying && currentEpisodeId === item.id) ? 'playing' : ''}}"
        data-id="{{item.id}}"
        catchtap="onPlayEpisode"
        aria-label="{{(isPlaying && currentEpisodeId === item.id) ? '暂停' : '播放'}}"
      >
        <image class="row-play-icon" lazy-load src="{{(isPlaying && currentEpisodeId === item.id) ? '/images/icons/pause.png' : '/images/icons/play.png'}}" mode="aspectFit" />
      </view>
    </view>

    <empty-state
      wx:if="{{todayList.length === 0}}"
      icon="/images/icons/headphones.png"
      icon-type="image"
      title="{{error || '今日节目暂未上线'}}"
      description="节目通常每天上午更新，下拉刷新试试或稍后再来看看～"
    ></empty-state>
  </block>
</view>

<!-- WXS：时间格式化工具（mm:ss），供模板调用 -->
<wxs module="fmt">
  module.exports = {
    time: function(s) {
      s = s || 0;
      var m = Math.floor(s / 60);
      var sec = Math.floor(s % 60);
      return (m < 10 ? '0' + m : m) + ':' + (sec < 10 ? '0' + sec : sec);
    }
  };
</wxs>

<!-- 任务9：全局浮动播放按钮，当有正在播放的节目时显示 -->
<floating-player />
