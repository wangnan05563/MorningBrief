<!-- 收听记录页（T02785 裁决 B：原名「最近播放」，与「频道更新」互斥命名） -->
<view class="page-recent">
  <!-- J14：与「频道更新」是两份数据，首屏常驻互斥命名 + 数据来源说明 + 回链 -->
  <view class="view-switch">
    <view class="view-switch-item active">收听记录</view>
    <view class="view-switch-item" bindtap="onOpenHistory" aria-label="查看各频道更新">频道更新 ›</view>
  </view>
  <view class="view-switch-hint">数据来源：本机收听记录（按最近播放时间倒序）；找各频道的往期节目请点「频道更新」</view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && list.length === 0}}">
    <image class="empty-icon-img" lazy-load src="/images/icons/headphones.png" mode="aspectFit" />
    <text>还没有播放记录</text>
    <text class="empty-desc">收听节目后会在这里显示</text>
  </view>

  <!-- 列表 -->
  <block wx:else>
    <view class="recent-list">
      <view
        class="card recent-item"
        wx:for="{{list}}"
        wx:key="episode_id"
        data-id="{{item.episode_id}}"
        data-index="{{index}}"
        bindtap="onTapItem"
      >
        <view class="item-header">
          <text class="item-date">{{fmt.date(item.played_at)}}</text>
          <text class="tag tag-mint" wx:if="{{item.completed}}">已听完</text>
        </view>
        <text class="item-title">{{item.title}}</text>
        <view class="item-footer">
          <text class="item-duration">播放至 {{dur.time(item.position)}}</text>
          <view class="play-icon-small">
            <image class="icon-text" lazy-load src="/images/icons/play-mini.png" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{list.length > 0}}">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:elif="{{!hasMore}}">没有更多了</text>
    </view>
  </block>
</view>

<wxs module="dur" src="../../utils/duration.wxs" />
<!-- WXS：日期截断（时长换算已收敛到 utils/duration.wxs，模板不再做算术） -->
<wxs module="fmt">
  module.exports = {
    date: function (iso) {
      if (!iso) return '';
      return iso.length >= 10 ? iso.substring(0, 10) : iso;
    }
  };
</wxs>

<!-- 全局浮动播放器：离开 tab 后仍可看到并控制后台播放（B4） -->
<floating-player />
