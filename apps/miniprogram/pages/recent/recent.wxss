/* pages/recent/recent.wxss */

/* 列表项小播放图标：圆形薄荷青背景 + 白色三角 */
.play-icon-small {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(63, 108, 143, 0.3);
}

.icon-text {
  width: 24rpx;
  height: 24rpx;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-duration {
  font-size: 24rpx;
  color: var(--text-muted);
}

.empty-desc {
  font-size: 24rpx;
  color: var(--border-strong);
  margin-top: 12rpx;
}
