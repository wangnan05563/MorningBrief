<!-- 搜索页 -->
<view class="page-search">
  <!-- 搜索框 -->
  <view class="search-bar">
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索节目标题"
      placeholder-class="search-ph"
      confirm-type="search"
      bindinput="onInput"
    />
    <image class="search-icon" lazy-load src="/images/icons/search.png" mode="aspectFit" />
  </view>

  <!-- 类型筛选（FR-MC-07）：全部 / 资讯 / 课程 -->
  <view class="filter-row">
    <view
      wx:for="{{filterOptions}}"
      wx:key="type"
      class="filter-chip {{filterType === item.type ? 'active' : ''}}"
      data-type="{{item.type}}"
      bindtap="onFilterType"
    >{{item.label}}</view>
  </view>

  <!-- 搜索历史（无关键词时展示） -->
  <block wx:if="{{showHistory && history.length > 0}}">
    <view class="history-section">
      <view class="section-header">
        <text>搜索历史</text>
        <!-- T00384：清空改为图标按钮 -->
        <view class="clear-btn" bindtap="onClearHistory" aria-label="清空搜索历史">
          <image class="clear-btn-icon" lazy-load src="/images/icons/trash.png" mode="aspectFit" />
        </view>
      </view>
      <view class="history-tags">
        <view
          wx:for="{{history}}"
          wx:key="*this"
          class="history-tag"
          data-keyword="{{item}}"
          bindtap="onTapHistory"
        >{{item}}</view>
      </view>
    </view>
  </block>

  <!-- J38：首次搜索期间给明确加载态，不再整屏空白 -->
  <view class="search-loading" wx:elif="{{loading && results.length === 0}}">
    <text>正在搜索…</text>
  </view>

  <!-- J39：取数失败是「没取到」，与「未找到相关节目」分成两支；失败态自带重试 -->
  <load-error
    wx:elif="{{loadError && results.length === 0}}"
    message="{{loadError}}"
    bind:retry="onRetryLoad"
  ></load-error>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!loading && keyword && results.length === 0}}">
    <image class="empty-icon-img" lazy-load src="/images/icons/search.png" mode="aspectFit" />
    <text>未找到相关节目</text>
  </view>

  <!-- 搜索结果 -->
  <block wx:else>
    <view class="result-list">
      <view
        class="card result-item"
        wx:for="{{results}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-index="{{index}}"
        bindtap="onTapResult"
      >
        <view class="item-header">
          <text class="item-date">{{item.date}}</text>
        </view>
        <text class="item-title">{{item.title}}</text>
        <view class="item-footer">
          <view class="item-meta" wx:if="{{item.type_label || item.channel_name}}">
            <text class="item-type-tag" wx:if="{{item.type_label}}">{{item.type_label}}</text>
            <text class="item-channel" wx:if="{{item.channel_name}}">{{item.channel_name}}</text>
          </view>
          <view class="item-duration">
            <image class="duration-icon" lazy-load src="/images/icons/duration.png" mode="aspectFit" />
            <text>{{dur.time(item.duration)}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{results.length > 0}}">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:elif="{{!hasMore}}">没有更多了</text>
    </view>
  </block>
</view>

<wxs module="dur" src="../../utils/duration.wxs" />

<!-- 全局浮动播放器：离开 tab 后仍可看到并控制后台播放（B4） -->
<floating-player />
