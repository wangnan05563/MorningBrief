/* pages/search/search.wxss */

/* 搜索框右侧放大镜图标：与输入框同色，弱化以避免抢眼 */
.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* 类型筛选行（FR-MC-07） */
.filter-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 16rpx 24rpx 8rpx;
}
/* 筛选 tab：与今日/历史页同款下划线风格（无背景 + 选中加粗 + 底部指示条） */
.filter-chip {
  position: relative;
  padding: 8rpx 20rpx;
  font-size: 27rpx;
  color: var(--text-secondary);
  background: transparent;
  border-radius: 0;
  line-height: 42rpx;
  transition: color 0.2s ease, font-weight 0.2s ease;
}
.filter-chip.active {
  color: var(--accent);
  font-weight: 700;
  background: transparent;
}
.filter-chip.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--accent);
}

/* 搜索结果类型标签 + 频道名（FR-MC-07） */
.item-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.item-type-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: var(--accent);
  background: rgba(63, 108, 143, 0.12);
  border-radius: 6rpx;
}
.item-channel {
  font-size: 22rpx;
  color: var(--text-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* === 搜索历史区块（T00384 补齐样式 + 清空改为图标按钮） === */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.clear-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-btn);
  background: var(--bg-subtle);
  /* T00753 全局统一：按钮无边框 */
}

.clear-btn:active {
  background: var(--danger-soft);
}

.clear-btn-icon {
  width: 36rpx;
  height: 36rpx;
}
