/* pages/search/search.wxss */

/* 搜索框右侧放大镜图标：与输入框同色，弱化以避免抢眼 */
.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* 类型筛选行（FR-MC-07） */
.filter-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 16rpx 24rpx 8rpx;
}
.filter-chip {
  padding: 8rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg-subtle);
  border-radius: 999rpx;
  line-height: 1.4;
}
.filter-chip.active {
  color: var(--text-inverse);
  background: var(--accent);
}

/* 搜索结果类型标签 + 频道名（FR-MC-07） */
.item-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.item-type-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: var(--accent);
  background: rgba(63, 108, 143, 0.12);
  border-radius: 6rpx;
}
.item-channel {
  font-size: 22rpx;
  color: var(--text-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* === 搜索历史区块（T00384 补齐样式 + 清空改为图标按钮） === */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.clear-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-btn);
  background: var(--bg-subtle);
  /* T00753 全局统一：按钮无边框 */
}

.clear-btn:active {
  background: var(--danger-soft);
}

.clear-btn-icon {
  width: 36rpx;
  height: 36rpx;
}
