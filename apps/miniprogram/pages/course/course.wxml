<!-- 课程主页：课程封面 + 章节列表 + 学习进度（FR-MC-03 / FR-MC-04 / FR-MC-11） -->
<view class="course-page">

  <!-- 加载中骨架屏 -->
  <view class="skeleton-wrap" wx:if="{{loading}}">
    <view class="skeleton-head shimmer"></view>
    <view class="skeleton-line shimmer"></view>
    <view class="skeleton-line short shimmer"></view>
    <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
    <!-- T00599：分级加载提示——慢加载文案 / 超时重试入口（骨架保持） -->
    <view class="load-hint" wx:if="{{loadingSlow}}">网络较慢，正在加载…</view>
    <view class="load-retry-wrap" wx:if="{{loadingTimedOut}}">
      <button class="load-retry-btn" bindtap="onRetryLoad" hover-class="none">重试</button>
    </view>
  </view>

  <!-- 错误态 -->
  <view class="error-wrap" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
  </view>

  <block wx:else>
    <!-- 课程头部 -->
    <view class="course-head">
      <image wx:if="{{!coverError}}" class="course-cover" lazy-load src="{{coverUrl}}" mode="aspectFill" binderror="onCoverError" />
      <view wx:else class="course-cover course-cover-fallback">
        <text class="course-cover-fallback-text">课程封面</text>
      </view>
      <view class="course-head-info">
        <text class="course-name">{{channel.name || '课程'}}</text>
        <text class="course-desc">{{channel.description || '专业资料语音课，随时随地听学。'}}</text>
      </view>
      <!-- 订阅/取消订阅（FR-MC-06）：课程类频道订阅后可接收新章节推送
           T00384：图标即按钮，checks/check 区分已订阅态 -->
      <view
        class="sub-btn {{isSubscribed ? 'subscribed' : ''}}"
        bindtap="onToggleSubscribe"
        wx:if="{{!loading}}"
        aria-label="{{isSubscribed ? '取消订阅' : '订阅课程'}}"
      >
        <image class="sub-btn-icon" lazy-load src="{{isSubscribed ? '/images/icons/checks.png' : '/images/icons/check.png'}}" mode="aspectFit" />
      </view>
    </view>

    <!-- 学习进度 -->
    <view class="progress-card">
      <view class="progress-top">
        <text class="progress-label">学习进度</text>
        <text class="progress-num">{{learnedCount}} / {{totalCount}} 章 · {{percent}}%</text>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{percent}}%;"></view>
      </view>
      <!-- T00384：继续学习/从头播放改为图标按钮 -->
      <view class="progress-actions">
        <view class="btn-primary btn-icon-only" bindtap="onContinue" aria-label="继续学习">
          <image class="btn-icon" lazy-load src="/images/icons/play.png" mode="aspectFit" />
        </view>
        <view class="btn-ghost btn-icon-only" bindtap="onPlayFromStart" aria-label="从头播放">
          <image class="btn-icon" lazy-load src="/images/icons/skip-back.png" mode="aspectFit" />
        </view>
      </view>

      <!-- 整课离线下载（FR-MC-09）：点击下载全部未下载章节
           T00384：图标即按钮，进度/已下载数量作为状态角标保留 -->
      <view class="download-all-bar {{batchDownloading ? 'loading' : ''}}" bindtap="onDownloadAll" wx:if="{{totalCount > 0}}" aria-label="下载整门课程">
        <image class="download-all-icon" lazy-load src="/images/icons/download.png" mode="aspectFit" />
        <text class="download-all-sub">{{batchDownloading ? (batchProgress + '%') : (downloadedCount + '/' + totalCount)}}</text>
      </view>
    </view>

    <!-- 合规提示（FR-MC-11）：disclaimer_level != none 时展示 -->
    <view class="disclaimer {{channel.disclaimer_level === 'strong' ? 'strong' : ''}}" wx:if="{{disclaimerText}}">
      <text class="disclaimer-icon">ⓘ</text>
      <text class="disclaimer-text">{{disclaimerText}}</text>
    </view>

    <!-- 章节列表 -->
    <view class="chapter-section">
      <text class="section-title">课程章节（共 {{totalCount}} 章）</text>

      <view
        class="card chapter-item {{item.status === 'finished' ? 'done' : ''}}"
        wx:for="{{chapters}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-index="{{index}}"
        bindtap="onTapChapter"
      >
        <!-- 章节状态位：✓/▶ 字符统一换成 Tabler 图标（T00384） -->
        <view class="chapter-index {{item.status}}">
          <image wx:if="{{item.status === 'finished'}}" class="chapter-state-icon" lazy-load src="/images/icons/btn-check.png" mode="aspectFit" />
          <image wx:elif="{{item.status === 'learning'}}" class="chapter-state-icon" lazy-load src="/images/icons/play-mini-accent.png" mode="aspectFit" />
          <text wx:else>{{item.index}}</text>
        </view>
        <view class="chapter-main">
          <text class="chapter-title">{{item.title || ('第' + item.index + '章')}}</text>
          <view class="chapter-meta">
            <text class="chapter-dur">{{item.duration_label || '00:00'}}</text>
            <text class="chapter-status {{item.status}}" wx:if="{{item.status === 'finished'}}">已学完</text>
            <text class="chapter-status {{item.status}}" wx:elif="{{item.status === 'learning'}}">学习中</text>
            <text class="chapter-status {{item.status}}" wx:else>未学习</text>
          </view>
        </view>
        <!-- 章节离线下载（FR-MC-09）：catchtap 不触发卡片跳转
             T00384：文案改为图标，下载中保留百分比 -->
        <view
          class="chapter-dl {{item.downloaded ? 'done' : ''}} {{item.downloading ? 'ing' : ''}}"
          catchtap="onTapDownloadChapter"
          data-id="{{item.id}}"
          aria-label="{{item.downloaded ? '已下载' : (item.downloading ? '下载中' : '下载本章')}}"
        >
          <image wx:if="{{item.downloaded}}" class="chapter-dl-icon" lazy-load src="/images/icons/download-done.png" mode="aspectFit" />
          <text wx:elif="{{item.downloading}}">{{item.progress}}%</text>
          <image wx:else class="chapter-dl-icon" lazy-load src="/images/icons/download.png" mode="aspectFit" />
        </view>
        <image class="chapter-play" lazy-load src="/images/icons/play-mini-accent.png" mode="aspectFit" />
      </view>

      <!-- 空态：课程尚未生成章节 -->
      <view class="empty-state" wx:if="{{chapters.length === 0}}">
        <image class="empty-icon-img" src="/images/icons/headphones.png" mode="aspectFit" />
        <text class="empty-title">课程章节尚未生成</text>
        <text class="empty-desc">课程正在制作中，敬请期待下一次更新～</text>
      </view>
    </view>
  </block>
</view>

<!-- 全局浮动播放器：离开 tab 后仍可看到并控制后台播放（B4） -->
<floating-player />
