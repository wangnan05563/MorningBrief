/* 课程主页样式（复用全局浅色主题：主色 var(--accent)，辅粉 var(--accent)） */
.course-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 40rpx;
}

/* === 骨架屏 === */
.skeleton-wrap {
  padding: 32rpx 24rpx;
}
.skeleton-head {
  width: 100%;
  height: 200rpx;
  border-radius: 20rpx;
  background: var(--border);
  margin-bottom: 24rpx;
}
.skeleton-line {
  height: 32rpx;
  border-radius: 8rpx;
  background: var(--border);
  margin-bottom: 16rpx;
}
.skeleton-line.short {
  width: 60%;
}
.skeleton-card {
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--border);
  margin-bottom: 16rpx;
}
.shimmer {
  animation: shimmer 1.2s infinite linear;
  background: linear-gradient(90deg, var(--border) 25%, var(--bg-card) 50%, var(--border) 75%);
  background-size: 400% 100%;
}
@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

/* === 错误态 === */
.error-wrap {
  padding: 120rpx 48rpx;
  text-align: center;
}
.error-text {
  color: var(--danger);
  font-size: 28rpx;
}

/* === 课程头部 === */
.course-head {
  display: flex;
  padding: 32rpx 24rpx 16rpx;
  background: var(--accent-soft);
}
.course-cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background: var(--accent-soft);
  flex-shrink: 0;
}
.course-head-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.course-name {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.course-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 订阅按钮（FR-MC-06）：课程类频道订阅后可接收新章节推送
   T00384：图标即按钮（未订阅 check / 已订阅 checks），触控区 88rpx */
.sub-btn {
  flex-shrink: 0;
  align-self: flex-start;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-left: 16rpx;
  border-radius: var(--radius-btn);
  background: var(--accent);
}
.sub-btn.subscribed {
  background: var(--accent-soft);
  /* T00753 全局统一：按钮无边框 */
}
.sub-btn-icon {
  width: 40rpx;
  height: 40rpx;
}

/* === 学习进度卡 === */
.progress-card {
  margin: 24rpx;
  padding: 28rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(63, 108, 143, 0.08);
}
.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.progress-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}
.progress-num {
  font-size: 24rpx;
  color: var(--accent);
}
.progress-track {
  height: 16rpx;
  border-radius: 8rpx;
  background: var(--accent-soft);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}
.progress-actions {
  display: flex;
  margin-top: 24rpx;
  gap: 20rpx;
}
/* T00384：图标即按钮，触控区抬到 88rpx */
.btn-primary,
.btn-ghost {
  flex: 1;
  min-height: 88rpx;
  border-radius: var(--radius-btn);
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-primary {
  background: var(--accent);
}
.btn-ghost {
  background: var(--accent-soft);
  /* T00753 全局统一：按钮无边框 */
}
.btn-ghost .btn-icon {
  margin-right: 0;
}

/* === 合规提示（FR-MC-11） === */
.disclaimer {
  display: flex;
  align-items: flex-start;
  margin: 0 24rpx 8rpx;
  padding: 20rpx 24rpx;
  background: var(--warning-soft);
  border-radius: 16rpx;
  border: 1rpx solid var(--warning-soft);
}
.disclaimer.strong {
  background: var(--danger-soft);
  border-color: var(--danger);
}
.disclaimer-icon {
  font-size: 28rpx;
  color: var(--warning);
  margin-right: 12rpx;
  line-height: 1.5;
}
.disclaimer.strong .disclaimer-icon {
  color: var(--danger);
}
.disclaimer-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--warning);
  line-height: 1.6;
}
.disclaimer.strong .disclaimer-text {
  color: var(--danger);
}

/* === 章节列表 === */
.chapter-section {
  padding: 16rpx 24rpx;
}
.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin: 16rpx 0 16rpx;
}
.chapter-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(63, 108, 143, 0.06);
}
.chapter-index {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-dark);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.chapter-index.finished {
  background: var(--accent);
  color: var(--text-inverse);
}
.chapter-index.learning {
  background: var(--warning-soft);
  color: var(--warning);
}
/* T00384：状态字符（✓/▶）统一换为 Tabler 图标 */
.chapter-state-icon {
  width: 32rpx;
  height: 32rpx;
}
.chapter-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.chapter-title {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 8rpx;
}
.chapter-meta {
  display: flex;
  align-items: center;
}
.chapter-dur {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-right: 16rpx;
}
.chapter-status {
  font-size: 22rpx;
}
.chapter-status.new {
  color: var(--text-muted);
}
.chapter-status.learning {
  color: var(--warning);
}
.chapter-status.finished {
  color: var(--accent);
}
.chapter-play {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

/* === 空态（复用全局组件风格） === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
}
.empty-icon-img {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.6;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.6;
}

/* === 整课离线下载条（FR-MC-09） ===
   T00384：文案换 download 图标，进度/已下载数量保留为右侧状态 */
.download-all-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  min-height: 88rpx;
  padding: 16rpx 24rpx;
  background: var(--accent-soft);
  border-radius: 16rpx;
}
.download-all-bar.loading {
  opacity: 0.85;
}
.download-all-icon {
  width: 44rpx;
  height: 44rpx;
}
.download-all-sub {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* === 章节下载按钮（FR-MC-09） ===
   T00384：图标即按钮（未下载 download / 已下载 download-done），触控区 88rpx */
.chapter-dl {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-left: 16rpx;
  border-radius: var(--radius-btn);
  background: var(--accent-soft);
  color: var(--accent-dark);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.chapter-dl.ing {
  background: var(--warning-soft);
}
.chapter-dl.done {
  background: var(--accent-soft);
}
.chapter-dl-icon {
  width: 40rpx;
  height: 40rpx;
}
