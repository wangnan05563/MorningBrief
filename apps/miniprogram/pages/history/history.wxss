/* 历史列表样式：与今日页完全一致（行式卡片 + 顶部工具栏 + 续播卡 + 工具栏） */

.container {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* === 顶部工具栏：搜索 + 频道胶囊（与今日页同款） === */
.top-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--bg-card);
  border-bottom: 2rpx solid var(--bg-subtle);
  position: sticky;
  top: 0;
  z-index: 10;
}

.top-action {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-subtle);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.top-action:active {
  background: var(--accent-soft);
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}

.channel-bar {
  flex: 1;
  white-space: nowrap;
  margin: 0 16rpx;
  height: 64rpx;
}

.channel-pill {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  background: var(--bg-subtle);
  transition: all 0.2s ease;
  line-height: 40rpx;
}

.channel-pill.active {
  background: var(--accent);
  color: var(--text-inverse);
  box-shadow: 0 4rpx 12rpx rgba(63, 108, 143, 0.3);
}

/* === 节目行卡片：与今日页完全一致 === */
.history-list {
  /* 仅作容器，无 padding 让 .episode-row-card 自带 margin */
}

.episode-row-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 16rpx 24rpx;
}

/* 已播放卡片：整体降透明度，与未播放的形成视觉区分 */
.episode-row-card.played {
  opacity: 0.6;
}

.row-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: var(--accent-soft);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  padding: 8rpx;
}

.row-cover-channel {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
}

.row-cover-date {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

/* 已播放角标：浅灰胶囊样式，与彩色封面形成对比 */
.played-badge {
  font-size: 18rpx;
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.7);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  margin-top: 6rpx;
  line-height: 1.2;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin-right: 16rpx;
}

.row-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 10rpx;
}

.row-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-stat {
  display: flex;
  align-items: center;
}

/* 统计前置图标：使用弱化灰版本（play-mini-muted.png），
   白底卡片上白色版不可见；图标已自带 --text-muted 灰，无需再降透明度 */
.row-stat-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.row-stat text {
  font-size: 22rpx;
  color: var(--text-muted);
}

.row-play {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.row-play:active {
  background: var(--accent-dark);
  transform: scale(0.95);
}

.row-play-icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: 4rpx;
  filter: brightness(0) invert(1);
}

/* === 空状态：与今日页同款 === */
.empty-icon-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

/* === 底部加载更多提示 === */
.load-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* === 任务6+7：继续播放 + 工具栏（与今日页 continue-card 同风格） === */
.history-action-bar {
  padding: 16rpx 24rpx 0;
}

.continue-card-mini {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: var(--accent-soft);
  border: 2rpx solid var(--accent-soft-strong);
  box-shadow: none;
  transition: transform 0.15s ease;
}

.continue-card-mini:active {
  transform: scale(0.98);
}

.continue-card-mini .continue-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--accent);
  padding: 12rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.continue-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.continue-label {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 500;
}

.continue-title {
  font-size: 28rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.continue-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

/* 工具栏：排序 + 列表按钮（T00384：图标即按钮，去掉中文文案） */
.history-tools {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.tool-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  border-radius: var(--radius-btn);
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  color: var(--accent);
  transition: all 0.2s ease;
}

.tool-chip:active {
  background: var(--accent-soft);
}

.tool-icon {
  width: 40rpx;
  height: 40rpx;
  transition: transform 0.2s ease;
}

/* 排序方向：升序时把图标上下翻转，"最早优先"无需文字即可辨识 */
.tool-chip.asc .tool-icon {
  transform: rotate(180deg);
}

/* === 骨架屏：与节目行布局对齐（封面 + 标题 + 副标题 + 播放按钮占位） === */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.shimmer {
  background: linear-gradient(90deg, var(--bg-subtle) 25%, var(--bg-card) 50%, var(--bg-subtle) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}

.skeleton-wrap {
  padding: 16rpx 0;
}

.skeleton-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
}

.skeleton-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.skeleton-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-right: 16rpx;
}

.skeleton-title {
  height: 32rpx;
  border-radius: 8rpx;
  width: 60%;
}

.skeleton-sub {
  height: 24rpx;
  border-radius: 8rpx;
  width: 40%;
}

.skeleton-play {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* === "我的偏爱"未设置时的引导卡片 === */
.preferred-empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
  text-align: center;
}
.preferred-empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}
.preferred-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.preferred-empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
  line-height: 1.5;
}
/* T00384：图标即按钮，方形触控区 */
.preferred-empty-btn {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
}
