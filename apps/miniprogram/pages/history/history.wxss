/* 历史列表样式：与今日页完全一致（行式卡片 + 顶部工具栏 + 续播卡 + 工具栏） */

.container {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* === 顶部工具栏：搜索 + 频道胶囊（与今日页同款） === */
.top-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--bg-card);
  border-bottom: 2rpx solid var(--bg-subtle);
  position: sticky;
  top: 0;
  z-index: 10;
}

.top-action {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-subtle);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.top-action:active {
  background: var(--accent-soft);
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}

.channel-bar {
  flex: 1;
  /* T00753 修复：scroll-x 用 flex 布局（配合 enable-flex），子项不压缩不换行，
     比 inline-block + white-space 更稳，避免横向滑动失效 */
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: nowrap;
  white-space: nowrap;
  margin: 0 16rpx;
  height: 64rpx;
}

/* 频道导航 tab：与今日页同款下划线风格（无背景 + 选中加粗 + 底部指示条） */
.channel-pill {
  position: relative;
  display: inline-block;
  /* 作为 flex 子项：不压缩、不换行，宽度按内容 */
  flex: 0 0 auto;
  padding: 11rpx 26rpx;
  margin-right: 18rpx;
  border-radius: 0;
  font-size: 27rpx;
  color: var(--text-secondary);
  background: transparent;
  transition: color 0.2s ease, font-weight 0.2s ease;
  line-height: 42rpx;
}

.channel-pill.active {
  color: var(--accent);
  font-weight: 700;
  background: transparent;
  box-shadow: none;
}

.channel-pill.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--accent);
}

/* === 节目行卡片：与今日页完全一致 === */
.history-list {
  /* 仅作容器，无 padding 让 .episode-row-card 自带 margin */
}

.episode-row-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 16rpx 24rpx;
}

/* 已播放卡片：整体降透明度，与未播放的形成视觉区分 */
.episode-row-card.played {
  opacity: 0.6;
}

.row-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: var(--accent-soft);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  padding: 8rpx;
  position: relative; /* T00730：频道图标小标绝对定位锚点 */
}

/* 频道图标小标（T00730）：叠封面左上角，白描边+投影；与今日页同款 */
.row-cover-icon {
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
  background: #fff;
}

.row-cover-channel {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
}

.row-cover-date {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

/* 频道封面缩略图：与今日页 .row-cover-img 同款（撑满 120rpx 圆角块） */
.row-cover-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  display: block;
}

/* 已播放角标：浅灰胶囊样式，与彩色封面形成对比 */
.played-badge {
  font-size: 18rpx;
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.7);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  margin-top: 6rpx;
  line-height: 1.2;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin-right: 16rpx;
}

.row-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 10rpx;
}

.row-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-stat {
  display: flex;
  align-items: center;
}

/* 统计前置图标：使用弱化灰版本（play-mini-muted.png），
   白底卡片上白色版不可见；图标已自带 --text-muted 灰，无需再降透明度 */
.row-stat-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.row-stat text {
  font-size: 22rpx;
  color: var(--text-muted);
}

.row-play {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  /* 碟片样式：中心薄荷标签 + 外圈黑胶盘体（径向渐变模拟唱片） */
  /* T00753 追加：配色调浅——盘体由近黑改浅灰蓝，浅色页面更柔和 */
  background: radial-gradient(
    circle at 50% 50%,
    var(--accent) 0 30%,
    #8c9cb0 31% 41%,
    #b3c0cf 42% 100%
  );
  box-shadow: 0 2rpx 8rpx rgba(63, 108, 143, 0.18), inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
}

/* 唱片纹路 + 非对称高光（高光用于表达"转动"） */
.row-play::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background:
    repeating-radial-gradient(
      circle at 50% 50%,
      rgba(255, 255, 255, 0.42) 0 2rpx,
      rgba(255, 255, 255, 0) 2rpx 7rpx
    ),
    conic-gradient(
      from 0deg,
      rgba(255, 255, 255, 0.55) 0deg 26deg,
      rgba(255, 255, 255, 0) 26deg 360deg
    );
  pointer-events: none;
}

/* 播放中：高光层匀速旋转（图标独立于该层，保持正向） */
.row-play.playing::before {
  animation: disc-spin 9s linear infinite;
}

@keyframes disc-spin {
  to { transform: rotate(360deg); }
}

.row-play:active {
  transform: scale(0.95);
}

.row-play-icon {
  position: relative;
  z-index: 1;
  width: 30rpx;
  height: 30rpx;
}

/* === 空状态：与今日页同款 === */
.empty-icon-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

/* === 底部加载更多提示 === */
.load-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* === 任务6+7：继续播放 + 工具栏（与今日页 continue-card 同风格） === */
.history-action-bar {
  padding: 16rpx 24rpx 0;
}

.continue-card-mini {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: var(--accent-soft);
  border: 2rpx solid var(--accent-soft-strong);
  box-shadow: none;
  transition: transform 0.15s ease;
}

.continue-card-mini:active {
  transform: scale(0.98);
}

/* 继续播放卡播放键：碟片样式（与今日页同配方，64rpx） */
.continue-icon-wrap {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: radial-gradient(
    circle at 50% 50%,
    var(--accent) 0 30%,
    #8c9cb0 31% 41%,
    #b3c0cf 42% 100%
  );
  box-shadow: 0 2rpx 8rpx rgba(63, 108, 143, 0.18), inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.continue-icon-wrap::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background:
    repeating-radial-gradient(
      circle at 50% 50%,
      rgba(255, 255, 255, 0.42) 0 2rpx,
      rgba(255, 255, 255, 0) 2rpx 7rpx
    ),
    conic-gradient(
      from 0deg,
      rgba(255, 255, 255, 0.55) 0deg 26deg,
      rgba(255, 255, 255, 0) 26deg 360deg
    );
  pointer-events: none;
}

.continue-icon-wrap.playing::before {
  animation: disc-spin 9s linear infinite;
}

/* 内层播放/暂停图标（不再自带圆底） */
.continue-icon {
  position: relative;
  z-index: 1;
  width: 26rpx;
  height: 26rpx;
}

.continue-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.continue-label {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 500;
}

.continue-title {
  font-size: 28rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.continue-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

/* 工具栏：排序 + 列表按钮（T00384：图标即按钮，去掉中文文案） */
.history-tools {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

/* 工具按钮（排序 / 播放列表）：T00753 反馈——去边框与背景，纯图标简洁风格 */
.tool-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;    /* 保留 88rpx 触控区（微信最小点击区建议） */
  height: 88rpx;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  border: none;
  color: var(--accent);
  transition: opacity 0.15s ease, transform 0.15s ease;
}

/* 按下反馈：仅靠透明度与轻微缩放（无底色） */
.tool-chip:active {
  background: transparent;
  opacity: 0.55;
  transform: scale(0.94);
}

.tool-icon {
  width: 44rpx;   /* 去底后适度放大，保证可辨识 */
  height: 44rpx;
  transition: transform 0.2s ease;
}

/* 排序方向：升序时把图标上下翻转，"最早优先"无需文字即可辨识 */
.tool-chip.asc .tool-icon {
  transform: rotate(180deg);
}

/* === 骨架屏：与节目行布局对齐（封面 + 标题 + 副标题 + 播放按钮占位） === */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.shimmer {
  background: linear-gradient(90deg, var(--bg-subtle) 25%, var(--bg-card) 50%, var(--bg-subtle) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}

.skeleton-wrap {
  padding: 16rpx 0;
}

.skeleton-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
}

.skeleton-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.skeleton-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-right: 16rpx;
}

.skeleton-title {
  height: 32rpx;
  border-radius: 8rpx;
  width: 60%;
}

.skeleton-sub {
  height: 24rpx;
  border-radius: 8rpx;
  width: 40%;
}

.skeleton-play {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* === "我的偏爱"未设置时的引导卡片 === */
.preferred-empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
  text-align: center;
}
.preferred-empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}
.preferred-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.preferred-empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
  line-height: 1.5;
}
/* T00384：图标即按钮，方形触控区 */
/* 偏爱空态设置按钮：与今日页一致——去边框与背景，纯图标（主题色变体图标） */
.preferred-empty-btn {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  margin: 16rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  box-shadow: none;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.preferred-empty-btn:active {
  opacity: 0.55;
  transform: scale(0.94);
}

.preferred-empty-btn-icon {
  width: 64rpx;
  height: 64rpx;
}

/* ===== T00767：过滤按钮（播放队列右侧，单按钮循环 全部→未播→已播） ===== */
/* 图标：Feather Icons（MIT 开源，线框风格，与评论区发送图标同源）内联 SVG，零新增图片资源 */
.filter-chip {
  width: auto;              /* 覆盖 tool-chip 的 88rpx 正圆：图标+微标签的胶囊 */
  min-width: 88rpx;         /* 保留最小触控区 */
  padding: 0 20rpx;
  border-radius: 44rpx;
  gap: 6rpx;
  flex-direction: row;
}

.filter-icon {
  width: 36rpx;
  height: 36rpx;
  background: center / contain no-repeat;
  flex-shrink: 0;
}

.filter-chip.all .filter-icon {
  background-image: url("data:image/svg+xml;base64,");
  animation: filter-in-a 0.35s ease;
}
.filter-chip.unplayed .filter-icon {
  background-image: url("data:image/svg+xml;base64,");
  animation: filter-in-b 0.35s ease;
}
.filter-chip.played .filter-icon {
  background-image: url("data:image/svg+xml;base64,");
  animation: filter-in-c 0.35s ease;
}

/* 切换动画：三个异名 keyframes 保证每次切态都重新触发（同名动画换类不重放） */
@keyframes filter-in-a {
  from { transform: rotate(-120deg) scale(0.4); opacity: 0.2; }
  to   { transform: rotate(0deg) scale(1); opacity: 1; }
}
@keyframes filter-in-b {
  from { transform: rotate(-120deg) scale(0.4); opacity: 0.2; }
  to   { transform: rotate(0deg) scale(1); opacity: 1; }
}
@keyframes filter-in-c {
  from { transform: rotate(-120deg) scale(0.4); opacity: 0.2; }
  to   { transform: rotate(0deg) scale(1); opacity: 1; }
}

.filter-label {
  font-size: 20rpx;
  color: var(--accent);
  font-weight: 600;
  line-height: 1;
}
